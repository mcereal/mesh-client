#!/bin/sh
# Placeholder helper for MinUI list rendering. When the real NextUI helpers
# are unavailable we fall back to selecting a device index based on the JSON
# payload generated by meshclient. Developers can override the chosen index via
# MESHCLIENT_MINUI_SELECTION.

set -eu

TMP_FILE=$(mktemp)
trap 'rm -f "$TMP_FILE"' EXIT
cat > "$TMP_FILE"

DEFAULT=""
COUNT=""

if command -v python3 >/dev/null 2>&1; then
    PYTHON_OUTPUT=$(python3 - "$TMP_FILE" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as handle:
    data = json.load(handle)

settings = data.get("settings", [{}])
devices = settings[0] if settings else {}
options = devices.get("options", [])
default = int(devices.get("selected", 0))
print(f"{default} {len(options)}")
for idx, option in enumerate(options):
    print(f"{idx}:{option}")
PY
    )

    DEFAULT=$(printf '%s\n' "$PYTHON_OUTPUT" | head -n1 | awk '{print $1}')
    COUNT=$(printf '%s\n' "$PYTHON_OUTPUT" | head -n1 | awk '{print $2}')
    printf '%s\n' "$PYTHON_OUTPUT" | tail -n +2 | while IFS= read -r item; do
        [ -z "$item" ] && continue
        idx=${item%%:*}
        text=${item#*:}
        printf '[minui-list placeholder] %s: %s\n' "$idx" "$text" >&2
    done
else
    printf '[minui-list placeholder] python3 unavailable; using basic parsing\n' >&2
fi

if [ -z "$DEFAULT" ]; then
    DEFAULT=$(sed -n 's/.*"selected":\([0-9][0-9]*\).*/\1/p' "$TMP_FILE" | head -n 1 || printf '0')
fi

case $DEFAULT in
    '' ) DEFAULT=0 ;;
esac

case ${COUNT:-} in
    '' ) COUNT=0 ;;
esac

SELECTION="$DEFAULT"
if [ -n "${MESHCLIENT_MINUI_SELECTION:-}" ]; then
    case ${MESHCLIENT_MINUI_SELECTION} in
        ''|*[!0-9-]*)
            printf '[minui-list placeholder] ignoring invalid override %s\n' "$MESHCLIENT_MINUI_SELECTION" >&2
            ;;
        *)
            SELECTION=$MESHCLIENT_MINUI_SELECTION
            printf '[minui-list placeholder] override selection via MESHCLIENT_MINUI_SELECTION=%s\n' "$SELECTION" >&2
            ;;
    esac
fi

is_integer() {
    case $1 in
        ''|*[!0-9-]*) return 1 ;;
    esac
    return 0
}

if ! is_integer "$SELECTION"; then
    SELECTION=$DEFAULT
fi

if is_integer "$COUNT" && [ "$COUNT" -gt 0 ]; then
    if is_integer "$SELECTION" && [ "$SELECTION" -lt 0 ]; then
        SELECTION=0
    fi
    if is_integer "$SELECTION" && [ "$SELECTION" -ge "$COUNT" ]; then
        SELECTION=$((COUNT - 1))
    fi
else
    COUNT=0
    SELECTION=0
fi

printf '[minui-list placeholder] selecting index %s (default %s, options=%s)\n' "$SELECTION" "$DEFAULT" "$COUNT" >&2
printf '{"settings":{"selected":%s}}\n' "$SELECTION"
exit 0
