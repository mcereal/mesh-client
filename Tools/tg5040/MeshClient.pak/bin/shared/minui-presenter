#!/bin/sh
# Placeholder helper for MinUI presenter. Logs the message to stderr so tests
# can observe the output when the real helper is not installed.

set -eu
MESSAGE="$(cat)"
if [ -z "$MESSAGE" ]; then
    MESSAGE="[minui-presenter placeholder] (empty message)"
else
    MESSAGE="[minui-presenter placeholder] $MESSAGE"
fi
printf '%s\n' "$MESSAGE" >&2
exit 0
