# Spanish UI review: run with MESHCLIENT_LANG=es.
# scripts/docker.sh env MESHCLIENT_LANG=es scripts/ui-capture.sh \
#   devtools/ui_capture/scenes/spanish.scene -o build/spanish.gif
scene demo
scale 4
delay 250
config
tab settings
key a
hold 1200
key b
tab nodes
# The Map row, which is the third - see the note in map.scene. A bare `key a` on this list steps
# the filter chips instead, which is not a screen with much Spanish on it.
key down 3
key a
hold 1200
key b
tab messages
key y
hold 1200
