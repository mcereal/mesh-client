# Copy to .brick.env (gitignored) and fill in. Read by scripts/deploy-device.sh and the
# `make deploy*` targets. Any value can also be overridden with --host/--user/--port or env.

# IP or hostname of the Brick on your WiFi. NextUI shows it under Settings > WiFi.
BRICK_HOST=192.168.1.50

# SSH Server pak (dropbear) defaults: root:tina or trimui:trimui.
BRICK_USER=root
BRICK_PORT=22

# Rarely need changing.
#BRICK_PLATFORM=tg5040
#BRICK_SDCARD=/mnt/SDCARD
#BRICK_SSH_OPTS="-o StrictHostKeyChecking=accept-new -o ConnectTimeout=5"
