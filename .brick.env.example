# Copy to .brick.env (gitignored) and fill in. Read by scripts/deploy-device.sh and the
# `make deploy*` targets. Any value can also be overridden with flags or env.

# Transport: how the host reaches the Brick.
#   auto - use USB (adb) when a device is attached, otherwise WiFi (ssh). The default.
#   ssh  - always WiFi. Needs BRICK_HOST and the "SSH Server" pak running.
#   adb  - always USB. Plug the USB-C DATA port (the one that also charges) into this host;
#          adbd runs on NextUI by default, so nothing else is needed. Install adb first:
#          macOS `brew install --cask android-platform-tools`, Linux your distro's android-tools.
#BRICK_TRANSPORT=auto

# --- WiFi / ssh transport ---
# IP or hostname of the Brick on your WiFi. NextUI shows it under Settings > WiFi.
BRICK_HOST=192.168.1.50

# SSH Server pak (dropbear) defaults: root:tina or trimui:trimui.
BRICK_USER=root
BRICK_PORT=22

# --- USB / adb transport ---
# Only needed if more than one adb device is attached (see `adb devices`).
#BRICK_ADB_SERIAL=
# Path to the adb binary, if it is not on PATH.
#BRICK_ADB=adb

# Rarely need changing.
#BRICK_PLATFORM=tg5040
#BRICK_SDCARD=/mnt/SDCARD
#BRICK_SSH_OPTS="-o StrictHostKeyChecking=accept-new -o ConnectTimeout=5"
