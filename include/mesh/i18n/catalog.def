/*
 * The catalog: every string the user reads, one line each.
 *
 * This file is included more than once, with the two macros defined differently each time -
 * once to build the ids, once to build the English table, once by scripts/gen-locale.py to
 * build a translation template. That is why it has no include guard and why it is not a .h:
 * `make format` would reflow the table into something no translator could scan, and there is
 * nothing here for clang-format to be right about.
 *
 *   MESH_STR_ENTRY(ID, "text")
 *   MESH_STR_PLURAL_ENTRY(ID, "one", "other")   -> MESH_STR_ID_ONE and MESH_STR_ID_OTHER
 *
 * Rules for a good entry:
 *
 *   - One whole sentence or label per id, %-specifiers included. "Sent to %s" is one string.
 *     Never build a sentence by concatenating catalog entries: the word order is the
 *     translator's to change, and a caller that glues two halves together has taken that away.
 *   - The id says where it is read, not what it says: TOAST_SEND_FAILED, not SEND_FAILED_TEXT.
 *     An id is forever; the English behind it is not.
 *   - A word that reads the same in two places still gets two ids when it is doing two jobs.
 *     "Off" under Bluetooth and "off" as a duration are one word in English and two in most
 *     other languages, and an id per job is what lets a translator tell them apart.
 *   - Keep the specifiers, their order and their types identical across locales.
 *     inkcell_i18n_validate() enforces it; see docs/i18n.md.
 *
 * Comments here are addressed to translators as much as to the next maintainer. A string with
 * no context is a string that gets translated wrong.
 */

/* ---- common words ------------------------------------------------------------------------- */

/*
 * Id 0, and deliberately empty.
 *
 * A table field that names a string - field_spec's zero_label, say - has to be able to say
 * "nothing here", and a zero-initialised field is what a designated initialiser leaves behind.
 * Keeping the empty string at 0 means that reads as nothing rather than as whichever entry
 * happened to be written first.
 */
/* The stand-in for a value the client cannot name: an enum the radio sent that this build
   does not know, a timestamp in the future. Short on purpose - it shares a row with real
   values and must not widen it. */
MESH_STR_ENTRY(COMMON_UNKNOWN,            "unknown")
MESH_STR_ENTRY(COMMON_NONE,               "none")
MESH_STR_ENTRY(COMMON_ON,                 "on")
MESH_STR_ENTRY(COMMON_OFF,                "off")
MESH_STR_ENTRY(COMMON_YES,                "yes")
MESH_STR_ENTRY(COMMON_NO,                 "no")
/* A setting left at whatever the radio firmware chooses, rather than a number we picked. */
MESH_STR_ENTRY(COMMON_DEFAULT,            "default")
MESH_STR_ENTRY(COMMON_CANCEL,             "Cancel")
/* A row that offers an action and is waiting to be pressed. "A" is the button's own printed
   label and stays as it is. */
MESH_STR_ENTRY(COMMON_PRESS_A,            "press A")

/* ---- durations and relative times --------------------------------------------------------- */

/* Compact ages, drawn in the corner of a list row where there is room for about six cells.
   The letters are unit abbreviations: seconds, minutes, hours, days. */
/* Two-part durations, for an uptime or a gap that deserves more than one unit. */
MESH_STR_ENTRY(TIME_DAYS_HOURS,           "%ud %uh")
MESH_STR_ENTRY(TIME_HOURS_MINUTES,        "%uh %um")
/* "how long ago", spelled out; these sit in a value column with room to breathe. */
MESH_STR_ENTRY(TIME_AGO_SECONDS,          "%us ago")
MESH_STR_ENTRY(TIME_AGO_MINUTES,          "%um ago")
MESH_STR_ENTRY(TIME_AGO_HOURS,            "%uh ago")
MESH_STR_ENTRY(TIME_AGO_DAYS,             "%ud ago")
/* Date separators above a run of messages. TODAY and YESTERDAY replace the date entirely;
   DATE is "<weekday> <day of month> <month>", and the three arguments are in that order, so a
   language that writes the month first reorders the specifiers rather than the code. */
MESH_STR_ENTRY(DATE_TODAY,                "Today")
MESH_STR_ENTRY(DATE_YESTERDAY,            "Yesterday")
MESH_STR_ENTRY(DATE_WEEKDAY_DAY_MONTH,    "%s %d %s")

/* ---- tabs --------------------------------------------------------------------------------- */

MESH_STR_ENTRY(TAB_MESSAGES,              "Messages")
MESH_STR_ENTRY(TAB_NODES,                 "Nodes")
MESH_STR_ENTRY(TAB_WAYPOINTS,             "Waypoints")
MESH_STR_ENTRY(TAB_DEVICES,               "Devices")
MESH_STR_ENTRY(TAB_STATUS,                "Status")
MESH_STR_ENTRY(TAB_SETTINGS,              "Settings")

/* ---- the action bar ------------------------------------------------------------------------ */

/*
 * What the buttons do here, one verb per button.
 *
 * These used to be whole sentences - "A open node  X pin  Y write  L/R tabs" - because the
 * footer drew one line of text. It draws an action bar now (inkcell_fb_draw_action_bar), which is a
 * keycap and a label per action, so a sentence has nothing for it to iterate: it would either
 * draw the whole thing on every key or go looking for the button letters inside a translation,
 * and reading a translation back is the one thing this layer exists to prevent.
 *
 * So an action is a *pair* - a button, and one of the ids below - and src/ui/tables/actions.c is where
 * a screen's set of them is decided. A, B, X, Y and START are printed on the Brick's case and
 * are not text; only the verb after each is.
 *
 * Keep them to a word or two. The bar drops actions from the end when they do not fit, so a
 * long verb does not wrap - it costs whichever action was written last its place on screen.
 */
MESH_STR_ENTRY(ACTION_SELECT,             "select")
MESH_STR_ENTRY(ACTION_BACK,               "back")
MESH_STR_ENTRY(ACTION_OPEN,               "open")
/* Move to the next tab along - what the shoulder buttons do on every screen. */
MESH_STR_ENTRY(ACTION_TABS,               "tabs")
MESH_STR_ENTRY(ACTION_QUIT,               "quit")
/* Take the highlighted row as the answer, on a screen that exists to ask one. */
MESH_STR_ENTRY(ACTION_CHOOSE,             "choose")
MESH_STR_ENTRY(ACTION_CONFIRM,            "confirm")
/* The verification sheet's A. Deliberately not "confirm": that word promises the user is
   agreeing to something this client is about to do, and what this press does is report what
   they can see on somebody else's screen. */
MESH_STR_ENTRY(ACTION_ANSWER,             "answer")
MESH_STR_ENTRY(ACTION_CANCEL,             "cancel")
/* The d-pad, on the two screens where moving the cursor is the whole interaction. */
MESH_STR_ENTRY(ACTION_MOVE,               "move")
/* What SELECT does: open the explanation of the screen the user is on (docs/help.md). */
MESH_STR_ENTRY(ACTION_HELP,               "help")
/*
 * The d-pad where there is nothing to choose, so the cursor moves the text rather than a
 * selection. A different verb from "move" on purpose.
 *
 * Two screens: the help screen, whose rows are paragraphs, and the readings behind a node's
 * chart, whose rows are facts. Neither has a press on a row, which is the whole of what makes
 * this the right word for both - and it is one row rather than two because they are the same
 * gesture doing the same thing, not two screens that happen to agree.
 */
MESH_STR_ENTRY(ACTION_SCROLL,             "scroll")
/* The shoulder buttons inside a long picker: ten rows at a time rather than one. */
MESH_STR_ENTRY(ACTION_JUMP,               "jump 10")
/* The map's three presses, and the one screen in this client where the d-pad moves the picture
   instead of a cursor. "pan" is that: sliding the view over the world. */
MESH_STR_ENTRY(ACTION_PAN,                "pan")
MESH_STR_ENTRY(ACTION_ZOOM_IN,            "closer")
MESH_STR_ENTRY(ACTION_ZOOM_OUT,           "wider")
/* START on the map: frame every marker again, which is the view the map opened on. A verb
   rather than "reset" because nothing is being undone - the reader is asking to see all of it. */
MESH_STR_ENTRY(ACTION_FIT,                "fit all")
/* Put the highlighted character into the draft - what A does on the on-screen keyboard. */
MESH_STR_ENTRY(ACTION_TYPE,               "type")
MESH_STR_ENTRY(ACTION_PAIR,               "pair")
MESH_STR_ENTRY(ACTION_DELETE,             "delete")
/* The keyboard's own: the case layer, a space, and "I have finished typing". */
MESH_STR_ENTRY(ACTION_SHIFT,              "shift")
/* The shoulders on the keyboard, which step the panel ring rather than the tabs: the three
   character layers and then a page of emoji at a time. */
MESH_STR_ENTRY(ACTION_KEYS,               "keys")
MESH_STR_ENTRY(ACTION_SPACE,              "space")
MESH_STR_ENTRY(ACTION_DONE,               "done")
MESH_STR_ENTRY(ACTION_SEND,               "send")
/* Answer with one of the canned messages, rather than opening the keyboard to write one. */
MESH_STR_ENTRY(ACTION_REPLY,              "reply")
/* Open the keyboard to compose a message to whoever the cursor is on. */
MESH_STR_ENTRY(ACTION_WRITE,              "write")
/* Put an emoji on the message under the cursor - a tapback, not a message of its own. Every
   messenger has a word for this one and it is rarely "react"; use the one yours uses. */
MESH_STR_ENTRY(ACTION_REACT,              "react")
/* Send the message under the cursor again, after it came back undelivered. The same words to
   the same place, not a new message being written - the word your messenger puts on a failed
   bubble is the one to use. */
MESH_STR_ENTRY(ACTION_RESEND,             "resend")
/* Stop a conversation interrupting: no badge on the tab, no notice over whatever the user is
   doing. Its messages still arrive and its thread still fills, so this is not "block". */
MESH_STR_ENTRY(ACTION_MUTE,               "mute")
MESH_STR_ENTRY(ACTION_UNMUTE,             "unmute")
/* Start a conversation with somebody there is no thread for yet. */
MESH_STR_ENTRY(ACTION_NEW,                "new")
/* Keep this node at the top of the list. The star beside a pinned row is the same fact. */
MESH_STR_ENTRY(ACTION_PIN,                "pin")
/* A on the Nodes list's filter row: step the chips on to the next one. A verb rather than
   "next", because what the press changes is which nodes are below it and not where the cursor
   is - and rather than "choose", because nothing is being picked from a list of answers. */
MESH_STR_ENTRY(ACTION_FILTER,             "filter")
MESH_STR_ENTRY(ACTION_SORT,               "sort")
/* Broadcast a place to the channel again - the Waypoints tab's verb, and not the same word as
   "send": a waypoint already exists and goes out unchanged, where a message is written once. */
MESH_STR_ENTRY(ACTION_SHARE,              "share")
MESH_STR_ENTRY(ACTION_CONNECT,            "connect")
MESH_STR_ENTRY(ACTION_DISCONNECT,         "disconnect")
/* Drop a radio from the list of ones we know how to reach. */
MESH_STR_ENTRY(ACTION_FORGET,             "forget")
/* Y on the Devices tab's network row - and A on it while no address is set. "address" rather
   than "edit" because the row may have nothing to edit yet, and rather than "connect" because
   that is the press beside it. */
MESH_STR_ENTRY(ACTION_ADDRESS,            "address")
/* Ask the radio for this section again, rather than showing what it last said. */
MESH_STR_ENTRY(ACTION_REFRESH,            "refresh")
/* Open the airtime readings as a chart with its axes named - the Status screen's Mesh card
   offers it once there is more than one reading to draw. A noun rather than "graph": what is
   being opened is the trend, and the chart is only how it is shown. */
MESH_STR_ENTRY(ACTION_TREND,              "trend")
/* The chart's span picker, on the d-pad's Left and Right. The one screen in the client where
   those two are not the tab switch - the shoulders still are, which is what pays for it. */
MESH_STR_ENTRY(ACTION_SPAN,               "span")
/*
 * Y on a node's chart, which turns the plot into the readings behind it and back.
 *
 * Two words rather than one toggle word, because a keycap hint names *what the press does* and a
 * toggle that said "readings" over a screen already showing them would be the label describing
 * the state instead. Which one the bar carries is which face is up.
 *
 * "readings" rather than "values" or "log": what the list holds is the same readings the plot is
 * drawn from, said exactly rather than approximately, and the word is already the one this
 * client uses for them everywhere else.
 */
MESH_STR_ENTRY(ACTION_READINGS,           "readings")
MESH_STR_ENTRY(ACTION_CHART,              "chart")
/* Walk the node detail's groups with the d-pad's Left and Right, a card at a time. The second
   screen where those two are not the tab switch, and it is bought the same way: the shoulders
   still are. "groups" rather than "cards" because a card is how the fb backend draws one - a
   backend with no surfaces draws the same group as a heading, and the bar is read by both. */
MESH_STR_ENTRY(ACTION_GROUPS,             "groups")
/* Write the pending edits to the radio; throw them away. */
MESH_STR_ENTRY(ACTION_SAVE,               "save")
MESH_STR_ENTRY(ACTION_DISCARD,            "discard")
/* Change the value on the highlighted row in place, with Left and Right. */
MESH_STR_ENTRY(ACTION_EDIT,               "edit")
/* Carry out the highlighted row, on the screen whose rows are verbs rather than settings. */
MESH_STR_ENTRY(ACTION_RUN,                "run")
/* Drop a node from the roster we keep after the radio has forgotten it. */
MESH_STR_ENTRY(ACTION_REMOVE,             "remove")

/*
 * The second press, on the four actions that ask for one.
 *
 * A destructive action is armed by its first press and carried out by its second, and while it
 * is armed the bar says so: the button that would go through with it stops offering "delete"
 * and starts offering "confirm delete". The word is longer on purpose - an armed bar should not
 * look like the resting one.
 */
MESH_STR_ENTRY(ACTION_CONFIRM_DELETE,     "confirm delete")
MESH_STR_ENTRY(ACTION_CONFIRM_REMOVE,     "confirm remove")
MESH_STR_ENTRY(ACTION_CONFIRM_FORGET,     "confirm forget")
MESH_STR_ENTRY(ACTION_CONFIRM_DISCARD,    "confirm discard")

/* ---- how to leave -------------------------------------------------------------------------- */

/*
 * Shown beside the transport state while nothing is connected, as a sentence rather than as an
 * action, because that line is prose and not a bar. MENU is the Brick's own button; the second
 * form is what MESHCLIENT_QUIT_KEYS leaves us able to say when somebody has rebound quitting to
 * a key whose name we do not know.
 */
/* ---- the header ---------------------------------------------------------------------------- */

/* The transport has not said anything yet: the very first frame after launch. */
MESH_STR_ENTRY(HEADER_TRANSPORT_STARTING, "starting")
/* "<transport state>: <node we are talking to>" along the top. */
MESH_STR_ENTRY(HEADER_STATUS_CONNECTED,   "%s: %s")
/* "<transport state> | <how to quit>", when nothing is connected. */
MESH_STR_ENTRY(HEADER_STATUS_QUIT,        "%s | %s")

/* ---- the Messages tab ---------------------------------------------------------------------- */

MESH_STR_ENTRY(MESSAGES_EMPTY,            "Connect to a node to see conversations.")
/* The placeholder row at the top of the conversation list, which opens a new message. */
MESH_STR_ENTRY(MESSAGES_NEW,              "New message")
MESH_STR_ENTRY(MESSAGES_NEW_PREVIEW,      "Pick a channel or a node")
/* The pseudo-conversation carrying every channel at once. */
MESH_STR_ENTRY(MESSAGES_ALL_TRAFFIC,      "All traffic")
/* A channel's name on a row, which is its own name behind a '#'. Slot 0 with no name is the
   default primary channel - the firmware shows the modem preset there, which this client does
   not track - and a later unnamed slot is shown by its number. */
MESH_STR_ENTRY(CHANNEL_PRIMARY,           "#Primary")
MESH_STR_ENTRY(CHANNEL_NUMBERED,          "#Ch%u")
MESH_STR_ENTRY(MESSAGES_NO_MESSAGES_YET,  "no messages yet")
/* Shown over a conversation row that is one more X press from being deleted. */
MESH_STR_ENTRY(MESSAGES_DELETE_ARMED,     "X again to delete")
/* The unread badge, once the count stops being worth reading exactly. */
MESH_STR_ENTRY(MESSAGES_UNREAD_OVERFLOW,  "99+")
/* A thread with nothing in it. The first is the shared inbox, the second one conversation. */
MESH_STR_ENTRY(THREAD_EMPTY_INBOX,        "No messages yet. B goes back to the list.")
MESH_STR_ENTRY(THREAD_EMPTY,              "Nothing here yet. Y writes one, B goes back.")
/* A thread's title: the conversation, then whether it is a channel or one node, then how many
   older messages have been dropped from the ring. */
MESH_STR_ENTRY(THREAD_TITLE,              "%s  %s")
MESH_STR_ENTRY(THREAD_TITLE_OLDER,        "%s  %s  (+%u older)")
MESH_STR_ENTRY(THREAD_KIND_CHANNEL,       "channel")
MESH_STR_ENTRY(THREAD_KIND_DIRECT,        "direct")
/* The line across the transcript where the reader stopped last time, drawn in the same slot the
   day separators use. Short: it shares a body row with a hairline either side of it. */
MESH_STR_ENTRY(THREAD_UNREAD_FROM_HERE,   "New")

/* A message bubble's own header line. SENT is what one of ours says instead of a name. */
MESH_STR_ENTRY(BUBBLE_SENT,               "sent")
MESH_STR_ENTRY(BUBBLE_SENT_TO,            "to %s")
/* The tag after the name saying where the message came in: a channel by number, a direct
   message, an alert, or a sensor. The leading spaces separate it from the name. */
MESH_STR_ENTRY(BUBBLE_CHANNEL,            "  #%u")
MESH_STR_ENTRY(BUBBLE_DIRECT,             "  dm")
MESH_STR_ENTRY(BUBBLE_ALERT,              "  \U0001F6A8 alert")
MESH_STR_ENTRY(BUBBLE_SENSOR,             "  sensor")
/* Who carried the packet the last stretch, when that was somebody other than the sender. Rides
   the bubble's trailing run beside the clock rather than the header line, because it is a fact
   about the packet and not about who is talking - and because a run of relayed messages must
   not grow a header line each. No leading spaces: the run spaces its own parts. */
MESH_STR_ENTRY(BUBBLE_RELAY,              "via %s")
/* What became of a message we sent, in words.
 *
 * The bubble draws a mark rather than any of these - a clock, a double tick, an alert circle,
 * from src/ui/tables/delivery.c - because "ok", ".." and "!!" were two cells of punctuation standing
 * for a state, unreadable until learnt and a translator's problem the moment they were words.
 * The words stay because the mark has to be nameable: a text backend has no sprites, and a test
 * that asserted on a sprite would be asserting on a picture. */
MESH_STR_ENTRY(DELIVERY_SENDING,          "sending")
MESH_STR_ENTRY(DELIVERY_DELIVERED,        "delivered")
MESH_STR_ENTRY(DELIVERY_FAILED,           "failed")

/* ---- the Waypoints tab -----------------------------------------------------------------------
 *
 * A waypoint is a named place somebody broadcast to a channel. This tab lists them with how far
 * away and which way they lie from our own radio's fix, which is what a handheld can say about
 * a point when it has no map to draw it on.
 */

MESH_STR_ENTRY(WAYPOINTS_EMPTY,           "No places have been shared yet.")
MESH_STR_ENTRY(WAYPOINTS_EMPTY_DISCONNECTED, "Connect to a node to see shared places.")
MESH_STR_ENTRY(WAYPOINTS_GONE,            "That place is no longer in the list.")
/* The last row of the list: share our own radio's position as a new place. */
MESH_STR_ENTRY(WAYPOINTS_NEW,             "New waypoint here")
/* ...and what that row's supporting line says when our radio has no position to offer. The row
   stays and says why: one that disappeared would leave nothing to explain itself. A sentence
   rather than a fragment because it is read as one - it sits under the row's own name, where a
   place would say who shared it, not in the column that measures a range. */
MESH_STR_ENTRY(WAYPOINTS_NEW_NEEDS_FIX,   "This radio has no position yet")
MESH_STR_ENTRY(WAYPOINTS_TITLE_COUNT,     "Waypoints (%u)")
/* A waypoint whose sender left the name empty, which the wire allows. */
MESH_STR_ENTRY(WAYPOINTS_UNNAMED,         "Unnamed place")
/* The list row's second line: who shared it, and how long ago we heard it. */
MESH_STR_ENTRY(WAYPOINTS_ROW_SHARED,      "%s, %s")
/* How a waypoint of our own names its sharer, wherever a node name would go. */
MESH_STR_ENTRY(WAYPOINTS_BY_YOU,          "you")

MESH_STR_ENTRY(WAYPOINT_HEAD_PLACE,       "Place")
MESH_STR_ENTRY(WAYPOINT_HEAD_NOTE,        "Note")
MESH_STR_ENTRY(WAYPOINT_HEAD_SHARED,      "Shared")
MESH_STR_ENTRY(WAYPOINT_HEAD_ACTIONS,     "Actions")

/* How far away it is and which way, from our own fix. */
MESH_STR_ENTRY(WAYPOINT_RANGE,            "Range")
/* The two reasons there is no range to give. They are different facts: one is about this
   waypoint, the other about our own radio, and a row that said "unknown" for both would hide
   which of the two the user can do something about. */
MESH_STR_ENTRY(WAYPOINT_RANGE_NO_FIX,     "no fix of our own")
MESH_STR_ENTRY(WAYPOINT_RANGE_NO_COORDS,  "no coordinates")
/* A distance and a compass point, in that order. */
MESH_STR_ENTRY(WAYPOINT_VAL_RANGE,        "%s %s")
MESH_STR_ENTRY(WAYPOINT_LATITUDE,         "Latitude")
MESH_STR_ENTRY(WAYPOINT_LONGITUDE,        "Longitude")
MESH_STR_ENTRY(WAYPOINT_SHARED_BY,        "Shared by")
MESH_STR_ENTRY(WAYPOINT_CHANNEL,          "Channel")
MESH_STR_ENTRY(WAYPOINT_HEARD,            "Heard")
MESH_STR_ENTRY(WAYPOINT_EXPIRES,          "Expires")
/* The default every app sends: a place that stands until somebody withdraws it. */
MESH_STR_ENTRY(WAYPOINT_EXPIRES_NEVER,    "never")
/* How long a place with an expiry has left. A clock we do not have leaves the row unsaid
   rather than counting down from a date we cannot read. */
MESH_STR_ENTRY(WAYPOINT_EXPIRES_IN,       "in %s")
/* Whether anybody on the mesh may change it, or only the one node it names. */
MESH_STR_ENTRY(WAYPOINT_LOCKED_TO,        "Locked to")
MESH_STR_ENTRY(WAYPOINT_LOCKED_OPEN,      "anyone")

MESH_STR_ENTRY(WAYPOINT_ACT_SHARE,        "Share it again")
/* Two deletes, because they are two different acts. The first withdraws the place from the
   whole mesh; the second only stops this client showing it, because the waypoint is locked to
   somebody else and withdrawing it is not ours to do. */
MESH_STR_ENTRY(WAYPOINT_ACT_DELETE,       "Delete from the mesh")
MESH_STR_ENTRY(WAYPOINT_ACT_FORGET,       "Forget it here")
MESH_STR_ENTRY(WAYPOINT_ACT_DELETE_ARMED, "A again to delete")

/* The compass, at eight points. Short because they share a row with a name, a distance and an
   age - and translated, because the letters are the initials of words: north is N in English
   and Spanish, west is W and O. */
MESH_STR_ENTRY(COMPASS_N,                 "N")
MESH_STR_ENTRY(COMPASS_NE,                "NE")
MESH_STR_ENTRY(COMPASS_E,                 "E")
MESH_STR_ENTRY(COMPASS_SE,                "SE")
MESH_STR_ENTRY(COMPASS_S,                 "S")
MESH_STR_ENTRY(COMPASS_SW,                "SW")
MESH_STR_ENTRY(COMPASS_W,                 "W")
MESH_STR_ENTRY(COMPASS_NW,                "NW")

/* Distances, in whichever units the radio's display is set to. Under a kilometre or a mile the
   figure is whole - a metre of precision on a mesh position is already more than the sender
   knows - and above it there is one decimal, because 1 km and 2 km with nothing between them
   is a scale nobody can walk by. */
MESH_STR_ENTRY(VALUE_DISTANCE_M,          "%u m")
MESH_STR_ENTRY(VALUE_DISTANCE_KM,         "%.1f km")
MESH_STR_ENTRY(VALUE_DISTANCE_FT,         "%u ft")
MESH_STR_ENTRY(VALUE_DISTANCE_MI,         "%.1f mi")

/* A height, which stays in the small unit however large it gets: a node on a mountain reading
   "3.1 km" would be a height that looks like a range. Signed, because a fix below sea level is a
   real place - and wider on the imperial side, because a height is whatever int32_t the sender
   put in the packet and three metres of that range are more than four feet of it. */
MESH_STR_ENTRY(VALUE_ALTITUDE_M,          "%d m")
MESH_STR_ENTRY(VALUE_ALTITUDE_FT,         "%lld ft")

/* ---- the Nodes tab -------------------------------------------------------------------------- */

MESH_STR_ENTRY(NODES_EMPTY_WAITING,       "Waiting for the node list...")
MESH_STR_ENTRY(NODES_EMPTY_DISCONNECTED,  "Connect to a node to see the mesh.")
MESH_STR_ENTRY(NODES_GONE,                "That node is no longer in the list.")
MESH_STR_ENTRY(NODES_DETAIL_EMPTY,        "Nothing reported for this node yet.")
/* Titles: how many of the radio's NodeDB we hold, or how many we keep that it has evicted. */
MESH_STR_ENTRY(NODES_TITLE_OF,            "Nodes (%u of %u)")
MESH_STR_ENTRY(NODES_TITLE_OFF_RADIO,     "Nodes (%u, %u off radio)")
/* The filter chips on the list's first row - see include/mesh/ui/nodes.h for why there are
   three of them and why there is not a fourth. One word each: they are chips in a strip that
   has to fit across the panel beside two others, and the strip drops the words before it drops
   the pills. "Direct" is nodes heard with no relay between us and them; "Pinned" is the word X
   is already called, so it must match ACTION_PIN in whatever language this is. */
/* The name of the question the segments answer, in the label column the sort row below it
   shares. The two rows are one control group and are drawn as the Settings tab draws a field -
   a label, the pencil that says Left and Right edit it, and where it currently stands - so the
   label is a noun naming the axis rather than a sentence about what to press. */
MESH_STR_ENTRY(NODES_FILTER_ROW,          "Filter")
MESH_STR_ENTRY(NODES_FILTER_ALL,          "All")
MESH_STR_ENTRY(NODES_FILTER_DIRECT,       "Direct")
MESH_STR_ENTRY(NODES_FILTER_PINNED,       "Pinned")
/* What the filtered list says when the chip the reader has landed on keeps nothing. The row
   stays and says why rather than the list going blank - the map row's rule, and the Waypoints
   tab's before it: a screen that empties explains nothing to the reader wondering what they
   just pressed. */
MESH_STR_ENTRY(NODES_FILTER_NONE,         "No nodes match this filter")
/* The order the list is in, on the row under the chips - see include/mesh/ui/nodes.h for why an
   order is a second axis rather than a fourth filter, and the renderer for why five of these are
   a label and a word rather than a second strip. "Default" is the order the list has always been
   in - ourselves, then pins, then the people you talk to - and it is deliberately not named
   after any one of those, because it is all of them. */
MESH_STR_ENTRY(NODES_SORT_ROW,            "Sort")
MESH_STR_ENTRY(NODES_SORT_DEFAULT,        "Default")
MESH_STR_ENTRY(NODES_SORT_HEARD,          "Recent")
MESH_STR_ENTRY(NODES_SORT_NAME,           "Name")
MESH_STR_ENTRY(NODES_SORT_DISTANCE,       "Distance")
MESH_STR_ENTRY(NODES_SORT_HOPS,           "Hops")
/* The chosen order when it has nothing to measure with, which is the distance sort on a radio
   with no fix of its own. The order's own word, then why the rows did not move - said in the
   column that already answers "what is this set to", because that is where the reader just
   pressed and it costs the list no row. "Fix" is the word the node detail uses for the same
   thing. */
MESH_STR_ENTRY(NODES_SORT_NO_FIX,         "%s (no fix)")

/* ---- the map ----------------------------------------------------------------------------------
 *
 * A picture of where the nodes and the shared places are, opened from the first row of the Nodes
 * list. There is no basemap under it yet, so what it draws is a graticule, the markers, and a scale
 * bar to read the distances against.
 */

/* The Nodes list's first row, and what its supporting line says. The count is nodes and places
   that have reported a position, which is usually far fewer than the roster holds. */
MESH_STR_ENTRY(MAP_ROW,                   "Map")
MESH_STR_PLURAL_ENTRY(MAP_ROW_MARKERS,    "%u position", "%u positions")
/* ...and what that row says instead when nothing on the mesh has ever reported a position. The
   row stays and says why, rather than disappearing: a row that vanishes explains nothing. */
MESH_STR_ENTRY(MAP_ROW_EMPTY,             "Nothing has reported a position yet")
/* Raised when the row is pressed anyway - the reader who most needs the reason is the one who
   just pressed A without reading it. */
MESH_STR_ENTRY(TOAST_MAP_NO_FIXES,        "Nothing on the mesh has a position yet")
/* The map's own heading, and the badge beside it: how many markers are on the panel as it is
   framed right now, out of every one the client could place. A reader who has panned away from
   everything is told so rather than left wondering whether the map is broken. */
MESH_STR_ENTRY(MAP_TITLE,                 "Map")
MESH_STR_ENTRY(MAP_BADGE_IN_VIEW,         "%u of %u")
/* Under the crosshair when it is on nothing. Its own line rather than an empty one, because the
   space where a name would be is where a reader looks to find out what they have aimed at. */
MESH_STR_ENTRY(MAP_NOTHING_SELECTED,      "nothing under the crosshair")
/* A marker's own line: what it is, and how far away it is from the middle of the view. */
MESH_STR_ENTRY(MAP_SELECTED_RANGE,        "%s  %s")
/* What a node marker whose fix the sender rounded says, so a pin is never read as an exact
   spot. The distance comes from the same table the node detail and the channel's own
   position_precision row read. */
MESH_STR_ENTRY(MAP_SELECTED_APPROX,       "within %s")
/* A node the radio's NodeDB no longer carries. The roster deliberately outlives the radio's
   database, so a marker can be one we remember and the radio does not. */
MESH_STR_ENTRY(MAP_SELECTED_OFF_RADIO,    "off radio")
/* Our own radio, which is the one marker that is never somewhere to go to. */
MESH_STR_ENTRY(MAP_SELECTED_SELF,         "this radio")
/* Who a broadcast went to, where a direct message would name one node. It is a peer name, so
   it lands wherever a name does - the bubble header reads "to all". */
MESH_STR_ENTRY(PEER_EVERYONE,             "all")
/* A node with no NodeInfo yet has no short name; four dashes hold the column open. */
MESH_STR_ENTRY(NODES_NO_SHORT_NAME,       "----")
/* The right-hand column of a node row: how it was heard, then its age. */
MESH_STR_ENTRY(NODES_ROW_OFF_RADIO,       "off radio %s")
MESH_STR_ENTRY(NODES_ROW_HOPS,            "%uhop %s")
MESH_STR_ENTRY(NODES_ROW_MQTT,            "mqtt %s")
MESH_STR_ENTRY(NODES_ROW_SNR,             "%.1fdB %s")

/* ---- compose, the picker and the keyboard --------------------------------------------------- */

/* A list title with its row count: "Nodes (12)", and "(+3 older)" when the ring has dropped
   messages the count cannot show. */
/* Who a message is being written to, and whether that is a channel or one node. */
MESH_STR_ENTRY(COMPOSE_TO,                "To: %s")
MESH_STR_ENTRY(COMPOSE_TO_KIND,           "To: %s%s")
MESH_STR_ENTRY(COMPOSE_SUFFIX_CHANNEL,    "  (channel)")
MESH_STR_ENTRY(COMPOSE_SUFFIX_DIRECT,     "  (direct)")
MESH_STR_ENTRY(COMPOSE_DRAFT,             "Draft: %s")
MESH_STR_ENTRY(COMPOSE_DRAFT_EMPTY,       "[ Type a message ]")
/* The badge on the compose sheet and the keyboard when what is being written answers one
   message rather than the conversation. One word - it is a capsule, not a sentence. */
MESH_STR_ENTRY(COMPOSE_BADGE_REPLY,       "reply")
/* The tapback picker's heading: %s is the message being reacted to, elided to fit. */
/* The bubble sheet's heading. Not "React to", because the sheet also deletes: it names the
   message the verbs below are about and lets the rows say what each one does. */
MESH_STR_ENTRY(MESSAGE_ACTIONS,           "Message: %s")
MESH_STR_ENTRY(MESSAGE_DELETE,            "Delete message")
MESH_STR_ENTRY(MESSAGE_DELETE_CONFIRM,    "Delete message - press again")
MESH_STR_ENTRY(PICKER_TITLE,              "Send to")
MESH_STR_ENTRY(PICKER_EMPTY,              "No channels or nodes known yet.")

/* The pairing prompt. The PIN is on the *node's* screen, not this one, which is the whole
   reason the title names the node. NODE_FALLBACK stands in when the node has no name yet. */
MESH_STR_ENTRY(PAIRING_CONFIRM,           "Does %s show this?")
MESH_STR_ENTRY(PAIRING_SHOWN_ON,          "PIN shown on %s")
MESH_STR_ENTRY(PAIRING_NODE_FALLBACK,     "the node")

/* The submit key, and only the submit key. The other eight the grid draws - the layer names,
   space, delete, cancel - moved to inkcell's catalog with the grid itself: space is space in
   every program that has a keyboard. This one is not, and its absence from that catalog is the
   rule doing its job: it says "send" over a message and "done" over a settings field, and the
   difference is about what this client is *for*. mesh_ui_nav_kb_layout() hands whichever of
   the two down as the layout's `submit_label`. */
MESH_STR_ENTRY(KEY_DONE,                  "done")
MESH_STR_ENTRY(KEY_SEND,                  "send")

/* ---- canned messages ------------------------------------------------------------------------ */

/*
 * The ten one-press replies offered under the draft row. They are overridden wholesale by
 * canned.txt next to the preferences file, so these are only the defaults - but they are the
 * defaults every user sees until they write that file, and they should read naturally in the
 * language they are shown in rather than being translated word for word.
 */
MESH_STR_ENTRY(CANNED_OK,                 "OK")
MESH_STR_ENTRY(CANNED_YES,                "Yes")
MESH_STR_ENTRY(CANNED_NO,                 "No")
MESH_STR_ENTRY(CANNED_ON_MY_WAY,          "On my way")
MESH_STR_ENTRY(CANNED_WHERE_ARE_YOU,      "Where are you?")
MESH_STR_ENTRY(CANNED_IM_HERE,            "I'm here")
MESH_STR_ENTRY(CANNED_CALL_ME,            "Call me")
MESH_STR_ENTRY(CANNED_NEED_HELP,          "Need help")
MESH_STR_ENTRY(CANNED_HEADING_BACK,       "Heading back")
MESH_STR_ENTRY(CANNED_PING,               "Ping")

/* ---- tapbacks -------------------------------------------------------------------------------- */

/*
 * The emoji the React picker offers, named. The glyph is the payload and is not translated -
 * it is what goes on the air - but the row beside it has to say what the glyph means, because
 * a column of eight faces at the panel's glyph scale is not readable as eight distinct things.
 */
MESH_STR_ENTRY(REACTION_THUMBS_UP,        "Thumbs up")
MESH_STR_ENTRY(REACTION_THUMBS_DOWN,      "Thumbs down")
MESH_STR_ENTRY(REACTION_HEART,            "Love")
MESH_STR_ENTRY(REACTION_LAUGH,            "Laugh")
MESH_STR_ENTRY(REACTION_SURPRISE,         "Surprise")
MESH_STR_ENTRY(REACTION_SAD,              "Sad")
MESH_STR_ENTRY(REACTION_QUESTION,         "Question")
MESH_STR_ENTRY(REACTION_IMPORTANT,        "Important")

/* ---- the Devices tab ------------------------------------------------------------------------- */

/* Where the radios would be, while discovery has turned none up. A dim line inside the list
   rather than an empty-state picture, because the list is never empty: the network row is
   always its last row, and a screen falling through to a picture would take away the one
   control that can put a radio on it - the Nodes tab's "a filter that keeps nothing keeps the
   rows above it" rule, arrived at from the other side. */
MESH_STR_ENTRY(DEVICES_EMPTY,             "Scanning for Meshtastic nodes...")
/* A device the adapter has not named. The angle brackets mark it as a stand-in, not a name. */
MESH_STR_ENTRY(DEVICES_UNNAMED,           "<unknown>")
/* What the device is doing, on the row's supporting line. No leading spaces: the line is a
   slot of its own now rather than something concatenated onto the end of the name. */
MESH_STR_ENTRY(DEVICES_BADGE_CONNECTED,   "connected")
MESH_STR_ENTRY(DEVICES_BADGE_WORKING,     "working...")
MESH_STR_ENTRY(DEVICES_BADGE_NEEDS_PAIR,  "needs pairing")
MESH_STR_ENTRY(DEVICES_BADGE_PAIRED,      "paired")
/* A USB node in its UF2 bootloader. A warning rather than a fault: the board is healthy and one
   press of reset runs it again - and phase 3 is what makes this row the start of an install
   rather than only an explanation. */
MESH_STR_ENTRY(DEVICES_BADGE_BOOTLOADER,  "in bootloader")
/* How the device is attached, against the row's trailing edge. USB is a bus name and stays as
   it is; dBm is the signal strength of a Bluetooth node. */
MESH_STR_ENTRY(DEVICES_TRAILING_USB,      "USB")
/* Said of a Bluetooth radio this Brick is paired with but has not heard in the last scan -
   it is switched off, or out of range. Stands where the signal strength would be, because
   there is no reading to put there. */
MESH_STR_ENTRY(DEVICES_TRAILING_AWAY,     "not in range")
MESH_STR_ENTRY(DEVICES_TRAILING_RSSI,     "%ddBm")
/* Said of a node reached over the network. Stands where the signal strength would be, for the
   opposite reason to "not in range": there is no reading to put there because there is no
   distance to measure, not because we failed to measure one. */
MESH_STR_ENTRY(DEVICES_TRAILING_NETWORK,  "network")
/* The name given to a radio we are talking to but never saw advertise. */
MESH_STR_ENTRY(DEVICES_CONNECTED_NAME,    "Connected")
/* The Devices tab's last row, when nobody has written an address down: what it would reach,
   and what to do about it. A network cannot be scanned, so this row is the only place a
   network radio can come from. */
MESH_STR_ENTRY(DEVICES_NETWORK_ROW,       "Network radio")
MESH_STR_ENTRY(DEVICES_NETWORK_UNSET,     "Set an address")
/* Said under the address once one is set and the link is not up. It is not a state the way
   "not in range" is - nothing has been tried - so it says what the row would do. */
MESH_STR_ENTRY(DEVICES_NETWORK_READY,     "Connect over the network")

/* ---- the Status tab -------------------------------------------------------------------------- */

/* Card headings. Each names the *subject* of the rows under it rather than repeating a row
   label, which is why these are their own ids and not reused from the labels below: "Mesh" as a
   heading covers traffic and airtime, while "Mesh" as a row label is one line about whether the
   radio has reported at all, and the two are one word in English and rarely one word elsewhere.
   Short: a heading sits on a card that is already inset from both margins. */
MESH_STR_ENTRY(STATUS_CARD_LINK,          "Link")
MESH_STR_ENTRY(STATUS_CARD_MESH,          "Mesh")
MESH_STR_ENTRY(STATUS_CARD_RADIO,         "Radio")
/* The second link: the broker this client holds a connection to on the radio's behalf. "Broker"
   rather than "MQTT" because the card is about the far end rather than about the protocol, and
   because the Settings section already called MQTT is where the radio's own configuration
   lives - two cards named MQTT saying different things would be worse than either. */
MESH_STR_ENTRY(STATUS_CARD_BROKER,        "Broker")

/* Row labels down the left of the Status screen. They share one narrow column, so a
   translation that will not fit is better shortened than wrapped. */
MESH_STR_ENTRY(STATUS_LABEL_TRANSPORT,    "Transport")
MESH_STR_ENTRY(STATUS_LABEL_RADIO,        "Radio")
MESH_STR_ENTRY(STATUS_LABEL_SYNC,         "Sync")
MESH_STR_ENTRY(STATUS_LABEL_MY_NODE,      "My node")
MESH_STR_ENTRY(STATUS_LABEL_NODEDB,       "NodeDB")
MESH_STR_ENTRY(STATUS_LABEL_CACHED_HERE,  "Cached here")
MESH_STR_ENTRY(STATUS_LABEL_CHANNEL,      "Channel")
MESH_STR_ENTRY(STATUS_LABEL_AIRTIME,      "Airtime")
MESH_STR_ENTRY(STATUS_LABEL_BATTERY,      "Battery")
MESH_STR_ENTRY(STATUS_LABEL_PACKETS,      "Packets")
MESH_STR_ENTRY(STATUS_LABEL_SENT,         "Sent")
MESH_STR_ENTRY(STATUS_LABEL_HEARD,        "Heard")
MESH_STR_ENTRY(STATUS_LABEL_HEAP,         "Heap")
MESH_STR_ENTRY(STATUS_LABEL_TX_QUEUE,     "TX queue")
MESH_STR_ENTRY(STATUS_LABEL_RADIO_SAID,   "Radio said")
MESH_STR_ENTRY(STATUS_LABEL_REBOOTS,      "Reboots")
MESH_STR_ENTRY(STATUS_LABEL_MESSAGES,     "Messages")
MESH_STR_ENTRY(STATUS_LABEL_DEVICES,      "Devices")
/* The Broker card's own labels. "Status" rather than "State" for the one that carries the
   connection's sentence: every other row here reports a fact and this one reports progress. */
MESH_STR_ENTRY(STATUS_LABEL_BROKER,       "Server")
MESH_STR_ENTRY(STATUS_LABEL_BROKER_STATE, "Status")
MESH_STR_ENTRY(STATUS_LABEL_TOPICS,       "Topics")
MESH_STR_ENTRY(STATUS_LABEL_RELAYED,      "Relayed")
MESH_STR_ENTRY(STATUS_LABEL_DROPPED,      "Dropped")

MESH_STR_ENTRY(STATUS_NOT_CONNECTED,      "not connected")
/* How far the settings sync has got, and "(cached)" when what is shown was read from disk
   rather than from the radio just now. */
MESH_STR_ENTRY(STATUS_SYNC_COMPLETE,      "complete")
MESH_STR_ENTRY(STATUS_SYNC_IN_PROGRESS,   "in progress")
/* A 135-node replay runs about seventeen seconds; "in progress" alone could not tell a sync
   that was working from one that had stalled. %u of %u is nodes delivered of nodes the radio
   says it holds. */
MESH_STR_ENTRY(STATUS_SYNC_PROGRESS,      "%u of %u nodes")
MESH_STR_ENTRY(STATUS_SYNC_IDLE,          "idle")
MESH_STR_ENTRY(STATUS_SYNC_CACHED,        " (cached)")
/* The Sync row: how far the sync got, then the cached note when there is one. */
MESH_STR_ENTRY(STATUS_SYNC_VALUE,         "%s%s")
MESH_STR_ENTRY(STATUS_SYNC_WAITING,       "waiting for a radio")
/* Our own short name and node number, as the Meshtastic apps write it: "BRVO !a4c1f209". */
MESH_STR_ENTRY(STATUS_MY_NODE,            "%s !%08x")
/* The radio's own node database: how many it holds, and either how many of those it still
   hears or how many times it has restarted. */
MESH_STR_ENTRY(STATUS_NODEDB_ONLINE,      "%u nodes, %u online")
MESH_STR_ENTRY(STATUS_NODEDB_REBOOTS,     "%u nodes, %u reboots")
/* What this client keeps, which deliberately outlives the radio's own list. */
MESH_STR_ENTRY(STATUS_CACHED_OFF_RADIO,   "%u nodes, %u off radio")
/* Channel busy and our own transmit share, then the noise floor when the radio reports it. */
MESH_STR_ENTRY(STATUS_AIRTIME,            "%s busy, %s tx")
MESH_STR_ENTRY(STATUS_AIRTIME_FLOOR,      "%s busy, %s tx, %d dBm floor")
MESH_STR_ENTRY(STATUS_PERCENT,            "%.1f%%")
/* Battery: a percentage, or running from USB. UPTIME follows it as ", up 3d 4h". */
MESH_STR_ENTRY(STATUS_BATTERY_USB,        "plugged in")
MESH_STR_ENTRY(STATUS_BATTERY_PERCENT,    "%u%%")
MESH_STR_ENTRY(STATUS_BATTERY_UNKNOWN,    "unknown")
MESH_STR_ENTRY(STATUS_UPTIME_SUFFIX,      ", up %s")
/* The transmit side, whole: everything we put on the air, how much of it was a relay for
   somebody else, and how much the radio could not send because its queue was full. No bar
   under it, and that is a rule rather than a gap - the relayed count is a *subset* of the
   total rather than a sibling of it, so the three do not partition anything. */
MESH_STR_ENTRY(STATUS_SENT,               "%u tx, %u relayed, %u dropped")
/* The three parts of what the radio heard, in the order the bar under this row draws
   them - a composition has no legend, so the words are it. Keep them in step: the
   first number and the first slice are the same fact said twice. The received total is
   their sum and the length of that bar, which is why it is not a fourth number here. */
MESH_STR_ENTRY(STATUS_HEARD,              "%u new, %u dupe, %u bad")
MESH_STR_ENTRY(STATUS_HEAP,               "%u KB free of %u KB")
MESH_STR_ENTRY(STATUS_MESH_NO_REPORT,     "no report yet")
/* The same, on the Radio card: every row there appears only when the radio has said
   something about itself, so a radio that has said nothing leaves it empty. The card
   stays up regardless, because it is the one carrying the refresh verb. */
MESH_STR_ENTRY(STATUS_RADIO_NO_REPORT,    "no report yet")
MESH_STR_ENTRY(STATUS_LABEL_RADIO_SELF,   "Reported")
/* Room left in the radio's transmit queue, and whether it is currently refusing sends. */
MESH_STR_ENTRY(STATUS_TX_QUEUE,           "%u/%u free%s")
MESH_STR_ENTRY(STATUS_TX_QUEUE_REFUSED,   ", send refused")
/* How long ago the radio last logged something at us, and how many times this connection. */
MESH_STR_ENTRY(STATUS_RADIO_SAID_COUNT,   "%s, %u this connection")
MESH_STR_ENTRY(STATUS_REBOOTS_SINCE,      "%u since connecting")
MESH_STR_ENTRY(STATUS_MESSAGES_KEPT,      "%u kept, %u dropped")
MESH_STR_ENTRY(STATUS_DEVICES_IN_RANGE,   "%zu in range")

/*
 * The Broker card's values.
 *
 * "Topics" counts subscriptions, and none is worth saying out loud rather than printing 0: a
 * radio with downlink off on every channel publishes perfectly well and receives nothing, and
 * that is a configuration rather than a fault. The number nobody can see anywhere else.
 *
 * The two counts are kept apart from the radio's own "Packets" figures deliberately. These are
 * messages that crossed *this* client, and a reader comparing them against the mesh counters
 * above would be comparing a proxy's throughput with a radio's.
 */
MESH_STR_ENTRY(STATUS_BROKER_TOPICS,      "%u subscribed")
MESH_STR_ENTRY(STATUS_BROKER_NO_TOPICS,   "none - no channel downlinks")
MESH_STR_ENTRY(STATUS_BROKER_RELAYED,     "%u out, %u in")
MESH_STR_ENTRY(STATUS_BROKER_DROPPED,     "%u out, %u in")
/* A connection that keeps being remade, which "Connected" on its own hides completely. Only
   drawn past the first, since one sign-in is what a working proxy looks like. */
MESH_STR_ENTRY(STATUS_BROKER_RECONNECTS,  "%s, %u sign-ins")
/* The client declining a radio that asked. Names the variable because that is the only place
   the answer is, and somebody reading this row has already checked the radio. */
MESH_STR_ENTRY(STATUS_BROKER_DISABLED,    "The radio is asking for a broker and this client is not holding one: MESHCLIENT_MQTT_PROXY turned it off here.")
/* Messages the radio offered with nowhere to go. It is what `disabled` looks like from the
   radio's side, and it is also what a refused connection looks like - so it is a row rather
   than a line inside either sentence. */
MESH_STR_ENTRY(STATUS_BROKER_UNHANDLED,   "%u not taken")

/* ---- the trend screen ------------------------------------------------------------------------ */

/*
 * The chart the Status screen's trend verb opens: the same airtime readings the card draws in a
 * row, with the room to say what their axes are.
 *
 * Nothing here is a sentence about the picture. What the two lines are is the legend, what the
 * vertical means is its two ends, and what the horizontal means is the span under it - three
 * labels of a few cells each, which is all a chart on a panel this size can carry and all it
 * needs.
 */
MESH_STR_ENTRY(TREND_TITLE,               "Airtime")
/* The two lines, in the order the legend draws them - the order is the palette's, so a
   translation swapping them would name the wrong colour. All traffic the radio heard, and the
   part of it we sent: the second is inside the first, which is why the words say so. */
MESH_STR_ENTRY(TREND_SERIES_CHANNEL,      "All traffic")
MESH_STR_ENTRY(TREND_SERIES_TX,           "Ours")
/* How far back the picture goes, under the horizontal axis. The duration is already formatted
   ("45m", "3h 20m"), so what this adds is the word saying it is time. */
MESH_STR_ENTRY(TREND_SPAN,                "last %s")
/* The two ends of the vertical axis: the airtime domain is a percentage of the air, whole
   numbers because an axis end is read rather than measured. */
MESH_STR_ENTRY(TREND_AXIS_PERCENT,        "%u%%")
/*
 * The span picker, as the four words on its segmented button.
 *
 * Fixed words rather than formatted durations, because these are *choices* rather than
 * measurements: mesh_ui_format_duration() answers about a reading ("3h 20m"), and a control the
 * eye aims at wants four labels the same shape every time it is opened. The caption under the
 * axis is still the measurement, and the two say different things on purpose - the strip is what
 * was asked for, the caption is what there turned out to be.
 *
 * Left as unit letters for the reason the region codes are: "15m" is a duration written the way
 * every clock writes it, and a locale that wants its own may translate these four.
 */
/* What a plot with no line in it says, in the middle of its own frame. Not an error: the reader
   narrowed the span past the last two readings, and the picture saying so is what tells them the
   press worked and that widening it again is the way back. "Not enough" rather than "none",
   because a single reading is a level rather than a trend and two either side of a silence are
   two samples and no line - and all three are the same thing to look at. */
MESH_STR_ENTRY(TREND_EMPTY,               "Not enough readings in this span")
/* The readings list, which is the plot's other face. The caption says what the left-hand column
   is measured from, because it is not the clock: a Brick has no RTC and the series are stamped
   with a monotonic one, so "ago" would be the one claim on this screen with nothing behind it -
   see struct inkcell_trend_reading. */
MESH_STR_ENTRY(TREND_READINGS_FROM,       "before the newest reading")
/* A row of it: how long before that reading it was taken. The newest row is the reading it is
   measured from, so it says so rather than "0s". */
MESH_STR_ENTRY(TREND_READINGS_NEWEST,     "newest")
/* Where a line has got to, in the legend under the plot, when the reading is a temperature. The
   percentages reuse the Status card's own "%.1f%%" so the chart and the card the reader came from
   round the same figure the same way; a temperature has no such twin, because the node row that
   carries one says the Fahrenheit as well and that would not fit a legend. */
MESH_STR_ENTRY(TREND_VALUE_CELSIUS,       "%.1f C")

/*
 * The same chart, opened over a node's detail rather than over the Status cards.
 *
 * One title per reading rather than one title with the reading glued into it, because a title is
 * a *name* and the three of these are three names - and because the node's own name is already
 * on the app bar's line above, so a heading repeating it would be the breadcrumb mistake the
 * top app bar exists to have stopped. Which one is drawn is the reading the press named.
 */
MESH_STR_ENTRY(NODE_TREND_BATTERY,        "Battery")
MESH_STR_ENTRY(NODE_TREND_TEMPERATURE,    "Temperature")
MESH_STR_ENTRY(NODE_TREND_HUMIDITY,       "Humidity")
/* The two about the link rather than about the node. Spelled out rather than left as the
   acronyms the rows carry: a row sits under a "Signal" heading in a column two dozen cells wide
   and has that context, while a chart title is the only thing on its line. */
MESH_STR_ENTRY(NODE_TREND_SNR,            "Signal-to-noise")
MESH_STR_ENTRY(NODE_TREND_RSSI,           "Received strength")
/* The two ends of the vertical when the reading is a temperature: whole degrees Celsius, because
   an axis end is read rather than measured and the tenths the series is kept in would be four
   cells of precision nobody is asking the axis for. Untranslated unit letter, as the region
   codes and the modem presets are - "C" is the symbol rather than a word. */
MESH_STR_ENTRY(NODE_TREND_AXIS_CELSIUS,   "%dC")
/* And when it is one of the two signal readings. Both ends are whole units for the reason the
   temperature's are, and both are signed: an axis that clamped a negative end to zero would put
   every LoRa link ever measured against a floor of nothing. Untranslated units again - "dB" and
   "dBm" are symbols, not words. */
MESH_STR_ENTRY(NODE_TREND_AXIS_DB,        "%d dB")
MESH_STR_ENTRY(NODE_TREND_AXIS_DBM,       "%d dBm")

/* ---- a node's detail screen ------------------------------------------------------------------ */

/*
 * The group headings, then the label of each row under them.
 *
 * Unit symbols in the value formats below - dB, dBm, hPa, ppm, lux, mA, V, ug/m3 - are SI or
 * near enough and are normally left exactly as they are; what a translator may want to change
 * is the spacing and the order, which is why the whole value is one string rather than a
 * number with a suffix glued on.
 */
MESH_STR_ENTRY(NODE_HEAD_ACTIONS,         "Actions")
MESH_STR_ENTRY(NODE_HEAD_IDENTITY,        "Identity")
MESH_STR_ENTRY(NODE_HEAD_SIGNAL,          "Signal")
MESH_STR_ENTRY(NODE_HEAD_METRICS,         "Device metrics")
MESH_STR_ENTRY(NODE_HEAD_POSITION,        "Position")
MESH_STR_ENTRY(NODE_HEAD_ENVIRONMENT,     "Environment")
MESH_STR_ENTRY(NODE_HEAD_POWER,           "Power")
MESH_STR_ENTRY(NODE_HEAD_AIR_QUALITY,     "Air quality")
MESH_STR_ENTRY(NODE_HEAD_HEALTH,          "Health")
MESH_STR_ENTRY(NODE_HEAD_HOST,            "Host")
MESH_STR_ENTRY(NODE_HEAD_NEIGHBOURS,      "Neighbours")
MESH_STR_ENTRY(NODE_HEAD_HEARD_BY,        "Heard by")
MESH_STR_ENTRY(NODE_HEAD_ROUTE_OUT,       "Route out")
MESH_STR_ENTRY(NODE_HEAD_ROUTE_BACK,      "Route back")

MESH_STR_ENTRY(NODE_LONG_NAME,            "Long name")
MESH_STR_ENTRY(NODE_SHORT_NAME,           "Short name")
MESH_STR_ENTRY(NODE_USER_ID,              "User ID")
MESH_STR_ENTRY(NODE_NUMBER,               "Node number")
MESH_STR_ENTRY(NODE_NAME,                 "Name")
MESH_STR_ENTRY(NODE_NODEDB,               "NodeDB")
MESH_STR_ENTRY(NODE_ROLE,                 "Role")
MESH_STR_ENTRY(NODE_HARDWARE,             "Hardware")
MESH_STR_ENTRY(NODE_PUBLIC_KEY,           "Public key")
MESH_STR_ENTRY(NODE_FLAGS,                "Flags")
MESH_STR_ENTRY(NODE_LAST_HEARD,           "Last heard")
MESH_STR_ENTRY(NODE_SNR,                  "SNR")
MESH_STR_ENTRY(NODE_RSSI,                 "RSSI")
MESH_STR_ENTRY(NODE_HOPS_AWAY,            "Hops away")
/* The routing pair off the last packet: who handed it to us, and who it asked for next. */
MESH_STR_ENTRY(NODE_RELAYED_BY,           "Relayed by")
MESH_STR_ENTRY(NODE_NEXT_HOP,             "Next hop")
MESH_STR_ENTRY(NODE_CHANNEL,              "Channel")
MESH_STR_ENTRY(NODE_HEARD_VIA,            "Heard via")
MESH_STR_ENTRY(NODE_BATTERY,              "Battery")
MESH_STR_ENTRY(NODE_VOLTAGE,              "Voltage")
MESH_STR_ENTRY(NODE_CHANNEL_UTIL,         "Channel util")
MESH_STR_ENTRY(NODE_AIR_UTIL_TX,          "Air util TX")
MESH_STR_ENTRY(NODE_UPTIME,               "Uptime")
/* When the reading above was taken, closing a group. */
MESH_STR_ENTRY(NODE_REPORTED,             "Reported")
MESH_STR_ENTRY(NODE_MEASURED,             "Measured")
MESH_STR_ENTRY(NODE_LATITUDE,             "Latitude")
MESH_STR_ENTRY(NODE_LONGITUDE,            "Longitude")
MESH_STR_ENTRY(NODE_ALTITUDE,             "Altitude")
MESH_STR_ENTRY(NODE_SATELLITES,           "Satellites")
MESH_STR_ENTRY(NODE_PRECISION,            "Precision")
MESH_STR_ENTRY(NODE_FIX,                  "Fix")
/* The same row when the node dated nothing: what we can honestly say is when the fix
   reached us, which is a different question and gets a different word. */
MESH_STR_ENTRY(NODE_FIX_RECEIVED,         "Fix heard")
MESH_STR_ENTRY(NODE_TEMPERATURE,          "Temperature")
MESH_STR_ENTRY(NODE_HUMIDITY,             "Humidity")
MESH_STR_ENTRY(NODE_PRESSURE,             "Pressure")
MESH_STR_ENTRY(NODE_AIR_QUALITY,          "Air quality")
MESH_STR_ENTRY(NODE_LIGHT,                "Light")
MESH_STR_ENTRY(NODE_CURRENT,              "Current")
MESH_STR_ENTRY(NODE_PM25,                 "PM2.5")
MESH_STR_ENTRY(NODE_PM1_PM10,             "PM1 / PM10")
MESH_STR_ENTRY(NODE_PM1,                  "PM1")
MESH_STR_ENTRY(NODE_PM10,                 "PM10")
MESH_STR_ENTRY(NODE_CO2,                  "CO2")
MESH_STR_ENTRY(NODE_VOC_INDEX,            "VOC index")
MESH_STR_ENTRY(NODE_NOX_INDEX,            "NOx index")
MESH_STR_ENTRY(NODE_HEART_RATE,           "Heart rate")
MESH_STR_ENTRY(NODE_SPO2,                 "SpO2")
MESH_STR_ENTRY(NODE_FREE_MEMORY,          "Free memory")
MESH_STR_ENTRY(NODE_FREE_DISK,            "Free disk")
MESH_STR_ENTRY(NODE_LOAD,                 "Load")
/* The row standing in for a neighbour list that came back empty. */
MESH_STR_ENTRY(NODE_NEIGHBOURS_NONE,      "None")
MESH_STR_ENTRY(NODE_HEARS_NO_ONE,         "hears no one")
MESH_STR_ENTRY(NODE_AND_MORE,             "and more")
MESH_STR_ENTRY(NODE_NOT_SHOWN,            "%u not shown")
/* A node we have only ever seen mentioned by others: its name is made up from its number. */
MESH_STR_ENTRY(NODE_DERIVED_NAME,         "derived, no NodeInfo yet")
MESH_STR_ENTRY(NODE_NOT_IN_NODEDB,        "not on the radio")
/* The boolean flags, joined with FLAG_SEPARATOR into one row. */
MESH_STR_ENTRY(NODE_FLAG_IGNORED,         "ignored")
MESH_STR_ENTRY(NODE_FLAG_LICENSED,        "licensed")
MESH_STR_ENTRY(NODE_FLAG_UNMESSAGEABLE,   "no messages")
MESH_STR_ENTRY(NODE_FLAG_SEPARATOR,       ", ")
/* Whether the last packet reached us over the air or through an MQTT bridge. Both are
   protocol names and stay as they are. */
MESH_STR_ENTRY(NODE_VIA_MQTT,             "MQTT")
MESH_STR_ENTRY(NODE_VIA_RF,               "RF")
/* The two answers the routing rows have that are not a node: the packet came straight from the
   node itself, and it went out with no next hop named - which is upstream's way of saying it
   was flooded rather than routed. */
MESH_STR_ENTRY(NODE_RELAY_DIRECT,         "direct")
MESH_STR_ENTRY(NODE_NEXT_HOP_FLOOD,       "flood")

/* The traceroute row and the states it passes through. */
MESH_STR_ENTRY(NODE_TRACE_ROUTE,          "Trace route")
MESH_STR_ENTRY(NODE_TRACE_RUNNING,        "tracing...")
MESH_STR_ENTRY(NODE_TRACE_TIMEOUT,        "no reply; press A")
/* The first stop of a traced path is the sender, so no link reached it; a later stop with no
   reading is one the firmware did not measure. */
MESH_STR_ENTRY(NODE_HOP_START,            "start")
MESH_STR_ENTRY(NODE_HOP_NO_READING,       "no reading")
/* Each stop after the first is drawn indented behind an arrow drawn in ASCII, because the
   framebuffer font has no arrow glyph. */
MESH_STR_ENTRY(NODE_HOP_ARROW,            "-> ")

/* The action rows at the foot of the screen. */
MESH_STR_ENTRY(NODE_ACT_MESSAGE,          "Message this node")
MESH_STR_ENTRY(NODE_ACT_PIN,              "Pinned to top")
MESH_STR_ENTRY(NODE_ACT_REQUEST_INFO,     "Ask for its name")
MESH_STR_ENTRY(NODE_ACT_REQUEST_POSITION, "Ask where it is")
MESH_STR_ENTRY(NODE_ACT_REQUEST_TELEM,    "Ask for telemetry")
MESH_STR_ENTRY(NODE_ACT_MUTE,             "Mute this node")
MESH_STR_ENTRY(NODE_ACT_IGNORE,           "Ignore this node")
MESH_STR_ENTRY(NODE_ACT_REMOVE,           "Remove from radio")
MESH_STR_ENTRY(NODE_ACT_REMOVE_ARMED,     "A again to remove")
/* Share where this node says it is as a waypoint. Offered only when it has a fix - a place
   with no coordinates is not one. */
MESH_STR_ENTRY(NODE_ACT_WAYPOINT,         "Save this place")
/* Open the map centred on this node. Beside "Save this place" because the two are the pair of
   things a fix is good for: one keeps it and one looks at it. */
MESH_STR_ENTRY(NODE_ACT_SHOW_ON_MAP,      "Show on map")

/*
 * Key trust: what the padlock on a direct message is entitled to claim.
 *
 * Three states rather than two, and the middle one is the ordinary case: almost every key on a
 * working mesh arrived over the air from whoever transmitted it, and that is neither a problem
 * nor an achievement. "Verified" is the one that took work, which is why it is the one that is
 * marked out. See include/mesh/ui/trust.h.
 */
MESH_STR_ENTRY(NODE_KEY_TRUST,            "Key")
MESH_STR_ENTRY(TRUST_NONE,                "no key held")
MESH_STR_ENTRY(TRUST_UNVERIFIED,          "not verified")
MESH_STR_ENTRY(TRUST_VERIFIED,            "verified in person")

/* Start the out-of-band ceremony against this node. The second is the same row on a node whose
   key is already verified: it is not an error to do it again, and a key that changed is exactly
   when somebody would want to. */
MESH_STR_ENTRY(NODE_ACT_VERIFY_KEY,       "Verify this key")
MESH_STR_ENTRY(NODE_ACT_VERIFY_AGAIN,     "Verify it again")
/* Hand this node - key included - to the radio, for a node we remember and it has evicted.
   Says what it does to the radio rather than to our list, because our list already has the
   node: the whole point is that the radio's does not. Kept under MESH_UI_NODE_LABEL_MAX, which
   is 20 bytes and cuts silently - "Put back on the radio" arrived as "Put back on the rad". */
MESH_STR_ENTRY(NODE_ACT_ADD_CONTACT,      "Put back on radio")
/*
 * Open the Settings tab against *this* node's radio instead of our own, over the mesh.
 *
 * Says "configure" rather than "administer" because the reader's question is what the press
 * does, and what it does is put them in front of that radio's settings. Under
 * MESH_UI_NODE_LABEL_MAX, which is 20 bytes and cuts silently.
 */
MESH_STR_ENTRY(NODE_ACT_ADMIN,            "Configure by radio")

/* ---- the key verification sheet ------------------------------------------------------------
 *
 * A ceremony rather than a setting: every step happens somewhere the mesh cannot reach, which
 * is what makes it proof of anything. The wording has one job throughout - to make it obvious
 * that the number and the characters travel by voice. A translation that lets a reader think
 * they can be typed into the client and sent has undone the feature.
 */
MESH_STR_ENTRY(VERIFY_HEAD_WAITING,       "Verifying %s")
MESH_STR_ENTRY(VERIFY_BODY_WAITING,       "The two radios are working it out. Whichever of you is asked first will be shown something to read to the other; this comes back when it is your turn.")
/* The headline on this one is the six digits themselves, drawn large, split into two groups of
   three the way the firmware writes them - the other person is reading the same layout out. */
MESH_STR_ENTRY(VERIFY_VAL_NUMBER,         "%03u %03u")
MESH_STR_ENTRY(VERIFY_BODY_NUMBER,        "Read these six digits to %s out loud - not over the mesh. Once they have typed them in, you will both be shown a short code to compare.")
MESH_STR_ENTRY(VERIFY_BODY_COMPARE,       "%s is looking at a code too. Say yours to each other. Answer that they match only if every character does.")
/*
 * The same stage with nothing to compare, which is what the firmware actually sends today:
 * KeyVerificationFinal.verification_characters is populated at neither end, and the initiating
 * end never generates a code at all - its notification quotes whatever was last left in a
 * scratch buffer. A comparison sheet with a blank headline is the one thing this feature must
 * never do, because the only answer available to the reader is a guess.
 *
 * What is left is still a real result. The radio raises this step only after the six digits
 * have been hashed together with both public keys and agreed, so the honest question is whether
 * to trust *that*, and the caveat that carries the whole ceremony is the one below: the digits
 * are proof of something only if they arrived by voice.
 */
MESH_STR_ENTRY(VERIFY_HEAD_CHECKED,       "Digits matched")
MESH_STR_ENTRY(VERIFY_BODY_CHECKED,       "This radio checked the six digits against %s's key and they agreed. No code was sent to compare, so that is the whole of the proof - mark the key verified only if you heard those digits by voice.")
/* The sheet's two answers, per stage. "Later" leaves the exchange running and gets out of the
   way; "Stop" ends it. */
MESH_STR_ENTRY(VERIFY_ANSWER_LATER,       "Later")
MESH_STR_ENTRY(VERIFY_ANSWER_READING,     "Reading it out")
MESH_STR_ENTRY(VERIFY_ANSWER_STOP,        "Stop")
MESH_STR_ENTRY(VERIFY_ANSWER_MATCH,       "They match")
MESH_STR_ENTRY(VERIFY_ANSWER_DIFFER,      "They do not")
/* The pair for the stage above. Not "They match": there is nothing on this screen for the
   reader to have matched, and a label that says otherwise is the sheet lying about what the
   press means. */
MESH_STR_ENTRY(VERIFY_ANSWER_TRUST,       "Mark it verified")
MESH_STR_ENTRY(VERIFY_ANSWER_NOT_NOW,     "Not now")
/* The keyboard prompt that collects the number, on the same terms as the pairing PIN prompt:
   pushed at the user by the radio rather than opened by a press. */
MESH_STR_ENTRY(VERIFY_NUMBER_PROMPT,      "Six digits from %s")

/* Value formats. */
MESH_STR_ENTRY(NODE_VAL_USER_ID_HEX,      "!%08x")
/* A relay or next hop that could not be resolved to one node. The ".." is the three bytes the
   LoRa header had no room for, so the id reads as the partial one it is rather than as a node
   number that happens to be small. */
MESH_STR_ENTRY(NODE_VAL_RELAY_HEX,        "!..%02x")
MESH_STR_ENTRY(NODE_VAL_NUMBER,           "%u")
MESH_STR_ENTRY(NODE_VAL_SNR,              "%.2f dB")
MESH_STR_ENTRY(NODE_VAL_RSSI,             "%d dBm")
/* RSSI, plus when it was measured, for a node now reaching us some other way. */
MESH_STR_ENTRY(NODE_VAL_RSSI_AGED,        "%d dBm, %s")
MESH_STR_ENTRY(NODE_VAL_PERCENT,          "%u%%")
MESH_STR_ENTRY(NODE_VAL_PERCENT_FINE,     "%.1f%%")
MESH_STR_ENTRY(NODE_VAL_VOLTS,            "%.2f V")
MESH_STR_ENTRY(NODE_VAL_MILLIAMPS,        "%.0f mA")
MESH_STR_ENTRY(NODE_VAL_MILLIAMPS_FINE,   "%.1f mA")
MESH_STR_ENTRY(NODE_VAL_VOLTS_MILLIAMPS,  "%.2f V, %.0f mA")
MESH_STR_ENTRY(NODE_VAL_DEGREES,          "%.5f")
/* Celsius first because the radio reports Celsius; the Fahrenheit conversion follows it. */
MESH_STR_ENTRY(NODE_VAL_TEMPERATURE,      "%.1f C (%.1f F)")
MESH_STR_ENTRY(NODE_VAL_PRESSURE,         "%.1f hPa")
MESH_STR_ENTRY(NODE_VAL_IAQ,              "IAQ %u")
MESH_STR_ENTRY(NODE_VAL_LUX,              "%.0f lux")
MESH_STR_ENTRY(NODE_VAL_PARTICULATES,     "%u ug/m3")
MESH_STR_ENTRY(NODE_VAL_PARTICULATES_TWO, "%u / %u ug/m3")
MESH_STR_ENTRY(NODE_VAL_PPM,              "%u ppm")
MESH_STR_ENTRY(NODE_VAL_INDEX,            "%.0f")
MESH_STR_ENTRY(NODE_VAL_BPM,              "%u bpm")
MESH_STR_ENTRY(NODE_VAL_MEGABYTES,        "%u MB")
MESH_STR_ENTRY(NODE_VAL_GIGABYTES,        "%.1f GB")
/* A Linux load average: one, five and fifteen minutes. */
MESH_STR_ENTRY(NODE_VAL_LOAD,             "%.2f %.2f %.2f")
/* A battery channel on a multi-cell power sensor, numbered from 1. */
MESH_STR_ENTRY(NODE_POWER_CHANNEL,        "Channel %u")

/* ---- settings: sections ---------------------------------------------------------------------- */

/*
 * The Settings tree. A section is a screen; a field is a row on it.
 *
 * Section and field names follow the Meshtastic firmware's own config fields, so a translator
 * should prefer whatever the phone apps call the same setting in that language over a literal
 * translation of the English here - the point of these names is that a user can follow a guide
 * written for the phone app while holding a Brick.
 */
MESH_STR_ENTRY(SETTINGS_SECTION_ABOUT,                    "About MeshClient")
MESH_STR_ENTRY(SETTINGS_SECTION_RADIO,                    "About radio")
MESH_STR_ENTRY(SETTINGS_SECTION_USER,                     "User")
MESH_STR_ENTRY(SETTINGS_SECTION_DEVICE,                   "Device")
MESH_STR_ENTRY(SETTINGS_SECTION_DISPLAY,                  "Display")
MESH_STR_ENTRY(SETTINGS_SECTION_LORA,                     "LoRa")
MESH_STR_ENTRY(SETTINGS_SECTION_BLUETOOTH,                "Bluetooth")
MESH_STR_ENTRY(SETTINGS_SECTION_CHANNELS,                 "Channels")
MESH_STR_ENTRY(SETTINGS_SECTION_SECURITY,                 "Security")
MESH_STR_ENTRY(SETTINGS_SECTION_POSITION,                 "Position")
MESH_STR_ENTRY(SETTINGS_SECTION_POWER,                    "Power")
MESH_STR_ENTRY(SETTINGS_SECTION_MQTT,                     "MQTT")
MESH_STR_ENTRY(SETTINGS_SECTION_STORE_FORWARD,            "Store & Forward")
MESH_STR_ENTRY(SETTINGS_SECTION_TELEMETRY,                "Telemetry")
MESH_STR_ENTRY(SETTINGS_SECTION_ACTIONS,                  "Radio actions")
MESH_STR_ENTRY(SETTINGS_SECTION_MODULES,                  "Modules")
MESH_STR_ENTRY(SETTINGS_SECTION_NEIGHBOR_INFO,            "Neighbor info")
MESH_STR_ENTRY(SETTINGS_SECTION_RANGE_TEST,               "Range test")
MESH_STR_ENTRY(SETTINGS_SECTION_PAXCOUNTER,               "Paxcounter")
MESH_STR_ENTRY(SETTINGS_SECTION_TAK,                      "TAK")
MESH_STR_ENTRY(SETTINGS_SECTION_AMBIENT,                  "Ambient lighting")
MESH_STR_ENTRY(SETTINGS_SECTION_STATUS_MESSAGE,           "Status message")
MESH_STR_ENTRY(SETTINGS_SECTION_DETECTION,                "Detection sensor")
MESH_STR_ENTRY(SETTINGS_SECTION_EXT_NOTIFICATION,         "External notify")
MESH_STR_ENTRY(SETTINGS_SECTION_TRAFFIC,                  "Traffic management")
MESH_STR_ENTRY(SETTINGS_SECTION_RADIO_UI,                 "Radio UI")
MESH_STR_ENTRY(SETTINGS_SECTION_CANNED,                   "Canned messages")
MESH_STR_ENTRY(SETTINGS_SECTION_NETWORK,                  "Network")
MESH_STR_ENTRY(SETTINGS_SECTION_BEACON,                   "Mesh beacon")

/* ---- the help screen -------------------------------------------------------------------------- */

/* The help screen's own heading. The section it explains is named on the trail beside it, so
   this stays the same word on every one of them. */
MESH_STR_ENTRY(HELP_TITLE,                "Help")
/* The heading over the paragraph that describes the whole screen, before the ones about
   individual rows. */
MESH_STR_ENTRY(HELP_OVERVIEW,             "About this screen")

/* ---- settings: what a section is for ----------------------------------------------------------- */

/*
 * The paragraph the help screen opens with, one per section (docs/help.md).
 *
 * These are addressed to somebody who has just opened the screen and does not already know what
 * it is for, which is a different reader from the one the labels above are written for. Two
 * things each should carry: what the section does, and what goes wrong if it is set badly - the
 * second half being the one worth the room, since a label already gives the first.
 *
 * Keep them under 200 characters. The help screen wraps them across a 3.2" panel, and a note
 * that runs past a screenful stops being read; settings_note_fits_the_panel holds the line.
 *
 * A locale may leave any of these untranslated: inkcell_str_in() falls back to English per id, so
 * an omitted note reads in English while the rest of that language stays correct. They are the
 * one class of string in this catalog with that dispensation - see docs/i18n.md.
 */
MESH_STR_ENTRY(SETTINGS_NOTE_ABOUT,                       "MeshClient itself: which version is running, where it keeps its data, the self-update rows, and the report it leaves behind if it ever stops unexpectedly. Nothing here reaches the radio.")
MESH_STR_ENTRY(SETTINGS_NOTE_RADIO,                       "What the radio says about itself, and what firmware upstream publishes for its board. Installing one takes the radio off the mesh for minutes and cannot be undone; a row says why it cannot be.")
MESH_STR_ENTRY(SETTINGS_NOTE_USER,                        "Your identity on the mesh. The long name is what node lists show; the short name is the few characters other radios draw on their own screens.")
MESH_STR_ENTRY(SETTINGS_NOTE_DEVICE,                      "How this radio behaves on the mesh: the role it plays, how often it announces itself, and what it repeats for other nodes. Role has the widest effect of anything here.")
MESH_STR_ENTRY(SETTINGS_NOTE_DISPLAY,                     "The radio's own screen: how long it stays lit and which way up it draws. None of that changes what the Brick shows - Units does, and says so on its own row.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA,                        "The radio link itself - region, modem settings, and how far a message may travel. Two radios must agree on region and preset or they cannot hear each other at all.")
MESH_STR_ENTRY(SETTINGS_NOTE_BLUETOOTH,                   "How the radio accepts a connection from a phone or from this client. Changing the mode or the PIN drops the current link and needs a fresh pairing.")
MESH_STR_ENTRY(SETTINGS_NOTE_CHANNELS,                    "The channels this radio listens on. A channel is a name plus a key: anyone holding the same pair can read its traffic, and anyone without it cannot.")
MESH_STR_ENTRY(SETTINGS_NOTE_SECURITY,                    "The radio's identity key, who may administer it remotely, and which debug surfaces are left open. A new private key makes this a different node to everyone else.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION,                    "Whether the radio shares where it is, how often, and how precisely. Every broadcast costs airtime on a band everyone shares, so the intervals matter.")
MESH_STR_ENTRY(SETTINGS_NOTE_POWER,                       "How the radio sleeps. Longer sleep buys battery life and costs responsiveness: a sleeping node hears nothing and answers nothing until it wakes.")
MESH_STR_ENTRY(SETTINGS_NOTE_MQTT,                        "Bridges this radio's traffic to an internet MQTT broker, joining a local mesh to a wider one. Uplink sends your traffic out; downlink brings other traffic in.")
MESH_STR_ENTRY(SETTINGS_NOTE_STORE_FORWARD,               "Asks a router on the mesh for messages that arrived while this client was off. Only a node configured as a Store & Forward router has anything to replay.")
MESH_STR_ENTRY(SETTINGS_NOTE_TELEMETRY,                   "What the radio measures - its own battery and channel use, a weather sensor, air quality, power rails, health - and how often it tells the mesh. Each one is another broadcast.")
MESH_STR_ENTRY(SETTINGS_NOTE_ACTIONS,                     "Things the radio does rather than settings it keeps: reboot, shutdown and the resets. The two forget rows are different - they clear this client's own node list.")
MESH_STR_ENTRY(SETTINGS_NOTE_MODULES,                     "The optional features this radio's firmware can run. Each row opens that module's own settings, and its value says whether the module is currently enabled.")
MESH_STR_ENTRY(SETTINGS_NOTE_NEIGHBOR_INFO,               "Reports which nodes this radio hears directly, so the mesh can map its own shape. The firmware floors the interval at four hours because it is a lot of traffic.")
MESH_STR_ENTRY(SETTINGS_NOTE_RANGE_TEST,                  "Sends numbered packets on a timer so you can walk away and find where reception stops. It transmits to everyone on the channel, so turn it off when you are done.")
MESH_STR_ENTRY(SETTINGS_NOTE_PAXCOUNTER,                  "Counts nearby WiFi and Bluetooth devices as a rough headcount, identifying none of them. It needs a board whose hardware can scan both bands.")
MESH_STR_ENTRY(SETTINGS_NOTE_TAK,                         "Bridges this radio to ATAK and WinTAK team awareness software. The team and role here are what other TAK clients draw for this node.")
MESH_STR_ENTRY(SETTINGS_NOTE_AMBIENT,                     "Drives an RGB LED on radios wired for one. The colour rows and the current limit do nothing at all on a board without the hardware.")
MESH_STR_ENTRY(SETTINGS_NOTE_STATUS_MESSAGE,              "A short line this radio publishes about itself, the way a status message works anywhere else.")
MESH_STR_ENTRY(SETTINGS_NOTE_DETECTION,                   "Watches a GPIO pin and tells the mesh when it changes - a door, a switch, a sensor. Pin numbers are the radio board's own, so check its wiring before setting one.")
MESH_STR_ENTRY(SETTINGS_NOTE_EXT_NOTIFICATION,            "Drives a buzzer, a vibration motor or an LED when a message or an alert arrives. Each output names the pin it is on and which of the two alerts triggers it.")
MESH_STR_ENTRY(SETTINGS_NOTE_TRAFFIC,                     "Limits how much other nodes may push through this one. There is no enabled switch: every row here is off at 0, and any other value turns that limit on.")
MESH_STR_ENTRY(SETTINGS_NOTE_RADIO_UI,                    "The graphical interface drawn on the radio's own screen. Not the same as Display: that section is the panel itself, this is what gets drawn on it.")
MESH_STR_ENTRY(SETTINGS_NOTE_CANNED,                      "Short replies stored on the radio for its own buttons. Six slots of 32 characters, because the wire carries the whole list as a single 200-byte string.")
MESH_STR_ENTRY(SETTINGS_NOTE_NETWORK,                     "The radio's own WiFi or Ethernet, which is how it reaches an MQTT broker or an NTP server. Shown and not editable from here; About radio says what the interface is actually doing.")
MESH_STR_ENTRY(SETTINGS_NOTE_BEACON_LISTEN,               "Take in beacons other nodes send. Their text arrives in the message list and the channel they offer is kept for this client to act on.")
MESH_STR_ENTRY(SETTINGS_NOTE_BEACON_BROADCAST,            "Send a beacon on the timer below. Off leaves the rows under it set but silent, which is how a beacon is prepared before it is switched on.")
MESH_STR_ENTRY(SETTINGS_NOTE_BEACON_LEGACY_SPLIT,         "Send the text as an ordinary message alongside the beacon, so firmware that does not know about beacons still shows it. Two packets rather than one.")
MESH_STR_ENTRY(SETTINGS_NOTE_BEACON_INTERVAL,             "How long between beacons. An hour is the firmware's own floor and this list starts there: a beacon carries an invitation other nodes act on, so a fast one costs everybody airtime.")
MESH_STR_ENTRY(SETTINGS_NOTE_BEACON_MESSAGE,              "What the beacon says. Up to 100 characters, and the one row here a stranger reads as words rather than as settings.")
MESH_STR_ENTRY(SETTINGS_NOTE_BEACON_OFFER_NAME,           "The name of the channel the beacon offers. Leave it empty to offer no channel and send only the message.")
MESH_STR_ENTRY(SETTINGS_NOTE_BEACON_OFFER_KEY,            "The key that goes with the offered channel. Anyone who receives the beacon can join with it, so this is not the key of a channel you want kept private.")
MESH_STR_ENTRY(SETTINGS_NOTE_BEACON_OFFER_REGION,         "The region the offered channel is on, for a stranger whose radio is set to another one. Not offered leaves it out of the invitation.")
MESH_STR_ENTRY(SETTINGS_NOTE_BEACON_OFFER_PRESET,         "The modem preset the offered channel is on. Not offered leaves it out, and a node that joins uses whatever it is already running.")
MESH_STR_ENTRY(SETTINGS_NOTE_BEACON,                      "Tells strangers this mesh is here: a message on a timer, with a channel they may join. A target is the preset, region and channel one copy goes out on; one reading as configured throughout is unused.")

/*
 * Field notes: the rows where knowing the name does not tell you what happens if you get it
 * wrong. Most settings have none, on purpose - see docs/help.md.
 *
 * Same rules as the section notes above: under 200 characters, one or two sentences, and a
 * locale may leave them untranslated. Ordered by section, LoRa first because it is the section
 * the questions actually get asked about.
 */
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_REGION,                 "Which band this radio transmits on, set by law where you are. A radio on the wrong region cannot reach its neighbours, and the amateur bands need an operator licence.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_SPREAD,                 "How far each symbol is spread over the air. Higher reaches further and carries less: every step up roughly doubles the time a message takes to send.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_CODING,                 "How much error correction rides along with each message. Higher recovers more damaged packets and makes every packet longer.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_HOPS,                   "How many times a message may be relayed before the mesh drops it. Every extra hop costs the whole mesh airtime, so raise it only to reach a node that is genuinely that far.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_TX_POWER,               "How hard this radio transmits, in dBm. Your region caps this in law, and more power drains the battery faster without helping if the other end cannot answer.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_BANDWIDTH,              "How wide a slice of the band each transmission uses. Wider carries more per second and hears more noise with it; narrower reaches further and takes longer to send.")

/*
 * Phase 2: the rows outside LoRa where the label does not tell you what goes wrong.
 *
 * Grouped by the section they are read in rather than by subject, so that adding a note means
 * finding the section it belongs to and writing one line under it.
 */

/* Device. */
MESH_STR_ENTRY(SETTINGS_NOTE_DEVICE_ROLE,                 "What job this radio does for the mesh. Client suits almost everyone; the router roles repeat other people's traffic, which only helps from a spot with a view and costs airtime everywhere else.")
MESH_STR_ENTRY(SETTINGS_NOTE_DEVICE_REBROADCAST,          "Which of the traffic it hears this radio repeats. All is the usual answer; the narrower settings keep other meshes at arm's length, and none makes this node a dead end for anyone behind it.")

/* Position. */
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_SMART,              "Sends your position when the radio has actually moved instead of on a fixed timer. A node that stays put stops transmitting; one that is moving reports sooner than the interval would.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_SMART_DISTANCE,     "How far the radio must move before smart broadcasting sends a new position. Set it too small and a GPS drifting on a windowsill transmits all day without going anywhere.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_SMART_INTERVAL,     "The shortest gap smart broadcasting leaves between two positions, however far the radio has moved. It is the floor that stops somebody in a car flooding the channel.")

/* Channels. */
MESH_STR_ENTRY(SETTINGS_NOTE_CHANNEL_KEY,                 "The key that protects this channel: everyone who can read it holds the same one. The default key is published with the firmware, so a channel meant to be private needs a random key shared by hand.")
MESH_STR_ENTRY(SETTINGS_NOTE_CHANNEL_UPLINK,              "Sends this channel's traffic on to the MQTT broker, when the radio has one. Everything said here then leaves the local mesh for the internet, so leave it off for a private channel.")
MESH_STR_ENTRY(SETTINGS_NOTE_CHANNEL_DOWNLINK,            "Puts traffic from the MQTT broker onto this channel and out over the radio. A busy broker can fill the air with messages nobody nearby asked for, at everyone's expense.")
MESH_STR_ENTRY(SETTINGS_NOTE_CHANNEL_POSITION,            "How precisely positions are shared here. Fewer bits round every location to a coarser square; off shares no coordinates at all, only that the node exists.")
MESH_STR_ENTRY(SETTINGS_NOTE_CHANNEL_MUTED,               "Quietens a noisy channel without leaving it: the radio keeps receiving and relaying its traffic, and stops alerting about it. The setting is kept on the radio, per channel.")

/* Security. */
MESH_STR_ENTRY(SETTINGS_NOTE_SECURITY_ADMIN_KEYS,         "Public keys of the nodes allowed to configure this radio over the mesh. A key here is a key to the radio, so leave all three empty unless you are deliberately setting up remote administration.")

/* Store & Forward. */
MESH_STR_ENTRY(SETTINGS_NOTE_SF_HISTORY_WINDOW,           "How far back this radio goes when another node asks it for missed messages. It is this radio's setting as a router; what somebody else's router replays to you is theirs.")

/* Neighbor info. */
MESH_STR_ENTRY(SETTINGS_NOTE_NEIGHBOR_INTERVAL,           "How often this radio reports the nodes it hears directly. The firmware quietly raises anything under four hours, because every report is a broadcast the whole mesh carries.")

/*
 * Phase 4: the long tail - the remaining rows where knowing the label does not tell you what
 * happens if you get it wrong. Same rules again: under 200 characters, one or two sentences, no
 * reference to another row by name, and a locale may leave any of them untranslated.
 *
 * Ordered by section, in the order the field table declares them, so that adding a note is
 * finding the section it belongs to and writing one line under it.
 *
 * A row is still allowed to have nothing to say. What was deliberately left without a note is
 * the row whose label repeats inside its own section - Telemetry's five Enabled/Interval trios
 * and the three output trios under External notification - because a help topic is a flat list
 * with no subheadings to tell five paragraphs headed "Enabled" apart. Those sections say it
 * once, in the overview, and help_note_labels_are_unique_in_a_section holds the line.
 */

/* User. */
MESH_STR_ENTRY(SETTINGS_NOTE_USER_LICENSED,               "Says this radio is operated under an amateur radio licence. Those bands forbid encryption, so the firmware transmits in the clear - set it only if you hold a licence.")
MESH_STR_ENTRY(SETTINGS_NOTE_USER_UNMESSAGEABLE,          "Tells other clients not to offer a direct message to this node, which is the answer for a sensor or a repeater nobody should write to. It hides the offer, not the delivery.")

/* Device. */
MESH_STR_ENTRY(SETTINGS_NOTE_DEVICE_TZDEF,                "A POSIX time zone string the radio applies to its own clock and its own screen. It has no bearing on what this client shows, which follows the Brick's clock.")
MESH_STR_ENTRY(SETTINGS_NOTE_DEVICE_NODEINFO,             "How often this radio announces who it is, so that a node meeting it for the first time learns its name. It is a broadcast the whole mesh carries, so it is measured in minutes.")
MESH_STR_ENTRY(SETTINGS_NOTE_DEVICE_LED,                  "Blinks the board's own LED to show the firmware is alive. Turning it off saves a little power and stops the light being a nuisance in the dark.")
MESH_STR_ENTRY(SETTINGS_NOTE_DEVICE_DOUBLE_TAP,           "Lets a double tap on the board count as a press of its user button, on hardware with an accelerometer for it. It does nothing on a board without the sensor.")

/* Position. */
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_GPS_MODE,           "Whether the radio's own GPS is powered, switched off, or absent from the board. With it off the radio knows only the fixed position typed in by hand.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_BROADCAST,          "How often the radio sends its position on a plain timer. Every send is airtime on a band everyone shares, so a node that stays in one place rarely needs a short one.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_GPS_INTERVAL,       "How often the GPS is woken to take a fix. Waking it more often keeps the position fresh and is one of the largest drains on the battery a radio has.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_FLAG_ALTITUDE,      "Sends how high the radio is along with where it is. Everything under it refines that height, and none of those rows does anything while this one is off.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_FLAG_ALTITUDE_MSL,  "Reports height above sea level instead of above the mathematical shape of the earth. The two differ by tens of metres, so a mesh should agree on one.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_FLAG_GEOIDAL,       "Sends the gap between those two ways of measuring height, so a receiver can convert one into the other rather than guessing which was meant.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_FLAG_DOP,           "Sends how good the fix was, as dilution of precision: lower is better. Without it a position taken through a roof looks exactly like one taken in a field.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_FLAG_HVDOP,         "Sends the horizontal and vertical precision as two figures rather than one combined one. It costs a little airtime and does nothing with precision off.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_FLAG_SATINVIEW,     "Sends how many satellites the radio could see when it took the fix, which is the other half of knowing how much to trust the position.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_FLAG_SEQ_NO,        "Numbers each position the radio sends, so a receiver can tell a fresh fix from a repeat of one it already has.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_FLAG_TIMESTAMP,     "Sends when the GPS solved the fix, which is not when the packet was sent. A position that travelled several hops can be minutes older than it looks.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_FLAG_HEADING,       "Sends which way the radio is travelling. Meant for vehicle speeds: at walking pace it is mostly noise and costs airtime to say.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_FLAG_SPEED,         "Sends how fast the radio is travelling. Meant for vehicle speeds, for the same reason heading is: walking pace moves it around without saying much.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_FIXED,              "A position typed in by hand, for a radio with no GPS or one that never sees the sky. The radio reports it as its own, so a stale one puts this node where it is not.")

/* Power. */
MESH_STR_ENTRY(SETTINGS_NOTE_POWER_SAVING,                "Sleeps as much of the radio as it can between transmissions. It buys battery life and costs messages: a sleeping node does not hear what was said while it was down.")
MESH_STR_ENTRY(SETTINGS_NOTE_POWER_LS_SECS,               "How long the radio stays in light sleep at a stretch. The LoRa radio stays on through it, so what is saved is the processor rather than everything on the board.")
MESH_STR_ENTRY(SETTINGS_NOTE_POWER_MIN_WAKE,              "How long the radio stays awake once something has woken it, so that it has time to finish handling what arrived before dropping back to sleep.")
MESH_STR_ENTRY(SETTINGS_NOTE_POWER_WAIT_BT,               "How long the radio leaves Bluetooth up waiting for a client to connect before it sleeps. Set it too short and connecting means catching the radio while it is awake.")
MESH_STR_ENTRY(SETTINGS_NOTE_POWER_SHUTDOWN,              "Powers the radio off this long after its charger is removed. Off leaves it running until the battery is flat, which is what you want unless it lives in a drawer.")

/* Display - the radio's own panel. */
MESH_STR_ENTRY(SETTINGS_NOTE_DISPLAY_SCREEN_ON,           "How long the radio's screen stays lit after a press. The screen is a large part of what a screened board draws, so a short timeout is most of what power saving buys.")
MESH_STR_ENTRY(SETTINGS_NOTE_DISPLAY_CAROUSEL,            "How often the radio's screen moves itself on to the next page. Off leaves it on whichever page it was left showing.")
MESH_STR_ENTRY(SETTINGS_NOTE_DISPLAY_UNITS,               "Metric or imperial, for the radio's own screen and for this one. It is the one row here the Brick reads too: distances, altitudes and footprints follow it wherever they are shown.")
MESH_STR_ENTRY(SETTINGS_NOTE_DISPLAY_COMPASS,             "Which way round the compass is drawn on the radio's screen, for a board mounted at an angle. It turns the drawing and not the heading behind it.")
MESH_STR_ENTRY(SETTINGS_NOTE_DISPLAY_FLIP,                "Draws the radio's screen upside down, for a board mounted the other way up. The buttons do not move with it, so they end up on the wrong side.")
MESH_STR_ENTRY(SETTINGS_NOTE_DISPLAY_OLED,                "Which panel the radio has, when its own autodetect got it wrong. Auto is right on almost every board; a wrong choice here leaves the screen blank or scrambled. Changing it restarts the radio.")
MESH_STR_ENTRY(SETTINGS_NOTE_DISPLAY_MODE,                "How the radio arranges what it draws. Default suits a plain screen, the two-colour layouts a panel with a tinted top band, Colour a full-colour one. Changing it restarts the radio.")
MESH_STR_ENTRY(SETTINGS_NOTE_DISPLAY_HEADING_BOLD,        "Draws the top line of the radio's screen in a heavier face. On a small panel it is the difference between a heading and another line of text.")
MESH_STR_ENTRY(SETTINGS_NOTE_DISPLAY_WAKE_ON_MOTION,      "Lights the radio's screen when it is picked up or tapped, on a board that has the accelerometer for it. A board without one ignores this.")
MESH_STR_ENTRY(SETTINGS_NOTE_DISPLAY_LONG_NAMES,          "Shows nodes on the radio's screen by their full name rather than their four-character short name. Fuller, and fewer of them fit.")
MESH_STR_ENTRY(SETTINGS_NOTE_DISPLAY_MESSAGE_BUBBLES,     "Draws messages on the radio's screen as bubbles rather than as plain lines.")

/* MQTT. */
MESH_STR_ENTRY(SETTINGS_NOTE_MQTT_ENABLED,                "Connects the radio to a broker. Nothing crosses until a channel is set to uplink or downlink, so this alone changes what the radio talks to and not what it shares.")
MESH_STR_ENTRY(SETTINGS_NOTE_MQTT_PROXY,                  "Hands the broker connection to whatever this radio is paired with, instead of the radio's own WiFi. This client holds it - see the Broker card on Status - but only while it is running and connected.")
MESH_STR_ENTRY(SETTINGS_NOTE_MQTT_ADDRESS,                "The broker to connect to, with a port after a colon if it is not the usual one. Left empty, the radio uses the public Meshtastic broker.")
MESH_STR_ENTRY(SETTINGS_NOTE_MQTT_ROOT,                   "The topic everything is published under. Two meshes sharing one broker need different roots, or each will hear the other's traffic as though it were its own.")
MESH_STR_ENTRY(SETTINGS_NOTE_MQTT_ENCRYPTION,             "Publishes each packet still encrypted with its channel key, so the broker carries traffic it cannot read. Off hands the plain text to whoever runs the broker.")
MESH_STR_ENTRY(SETTINGS_NOTE_MQTT_TLS,                    "Encrypts the connection to the broker itself. That protects the link and not the messages: what the broker does with your traffic once it arrives is a separate question.")
MESH_STR_ENTRY(SETTINGS_NOTE_MQTT_MAP_REPORTING,          "Publishes this node's name and position to the public Meshtastic map. It is a deliberate publication to anyone at all, separate from what your channels carry.")
MESH_STR_ENTRY(SETTINGS_NOTE_MQTT_MAP_INTERVAL,           "How often the map report goes out. The map ignores anything more frequent than hourly, so the shortest choice here is already as often as it is worth sending.")
MESH_STR_ENTRY(SETTINGS_NOTE_MQTT_MAP_PRECISION,          "How precisely the map report gives this node's position. Fewer bits round it to a coarser square, which is the row to reach for before turning the report off.")
MESH_STR_ENTRY(SETTINGS_NOTE_MQTT_MAP_LOCATION,           "Whether the map report carries a position at all. Off still publishes that this node exists and what it is called, which is the middle ground between listed and hidden.")

/* Store & Forward. The history window is phase 2's, above. */
MESH_STR_ENTRY(SETTINGS_NOTE_SF_ENABLED,                  "Turns the module on in this radio's firmware. It is what lets this radio keep messages for other people; asking somebody else's router for what you missed does not need it.")
MESH_STR_ENTRY(SETTINGS_NOTE_SF_HEARTBEAT,                "Announces this radio as a Store & Forward router every so often, so that clients find it without asking. It means nothing on a radio that is not acting as a server.")
MESH_STR_ENTRY(SETTINGS_NOTE_SF_SERVER,                   "Makes this radio hold other people's messages and replay them on request. It wants spare memory and mains power, so it is a setting for a fixed node and not a handheld.")
MESH_STR_ENTRY(SETTINGS_NOTE_SF_RECORDS,                  "How many messages this radio keeps as a router. Default lets the firmware size its own store, which on a board with spare memory is larger than a hand-picked number.")
MESH_STR_ENTRY(SETTINGS_NOTE_SF_HISTORY_MAX,              "The most messages this radio sends in one reply to a client catching up. It caps the burst, so one client's replay cannot take the channel for itself.")

/* Telemetry. Only the row whose label is its own subject - see docs/help.md. */
MESH_STR_ENTRY(SETTINGS_NOTE_TELEMETRY_FAHRENHEIT,        "Draws temperature in Fahrenheit on the radio's own screen. The sensor is read in Celsius and Celsius is what goes on the air, so it changes nothing for anyone else.")

/* Channels. The key, the two MQTT rows and the precision are phase 2's, above. */
MESH_STR_ENTRY(SETTINGS_NOTE_CHANNEL_NAME,                "Part of what identifies the channel: two radios have to match on the name as well as on the key. An empty name on the primary channel means the preset's default one.")
MESH_STR_ENTRY(SETTINGS_NOTE_CHANNEL_ROLE,                "Primary is the channel this radio's own traffic goes out on and there is one of it; a secondary channel is listened to as well. Disabled leaves the slot empty.")

/* Bluetooth. */
MESH_STR_ENTRY(SETTINGS_NOTE_BT_MODE,                     "How the radio proves it is the one you meant: a code on its own screen, a fixed PIN, or no check at all. A radio with no screen cannot show a random code.")
MESH_STR_ENTRY(SETTINGS_NOTE_BT_PIN,                      "The six digits to use when pairing is set to a fixed PIN. It never changes and the radio keeps it as it is, so it is convenience rather than security.")

/* LoRa. The six modem rows are phase 1's, above. */
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_USE_PRESET,             "Takes the modem settings from a named preset instead of the three rows that set them by hand. Both ends of a link have to end up with the same settings either way.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_PRESET,                 "A named trade of range against speed, from long and slow to short and fast. Every radio you want to talk to needs the same one, and a region allows only some of them.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_TX_ENABLED,             "Whether this radio may transmit at all. Off leaves it listening: it hears the mesh and repeats nothing, which is the setting for a band you are not licensed on.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_IGNORE_MQTT,            "Drops packets that reached this radio from an internet gateway rather than over the air. It is how a local mesh keeps a busy broker off its own band.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_OK_TO_MQTT,             "Lets gateways forward this radio's traffic to the internet. It is a request rather than a guarantee - it asks other people's gateways to respect it, and they may not.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_BOOST_GAIN,             "Turns on the receiver's extra gain stage on radios that have one. It hears weaker signals for a little more current, and does nothing on a radio without the chip.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_OVERRIDE_DUTY,          "Ignores the airtime limit your region sets in law. It is for a bench and for bands with no such limit; leaving it on where the limit applies is your responsibility.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_CHANNEL_NUM,            "Which numbered slot of the region's band this radio sits on. At 0 the radio works it out from the primary channel's name, which is what puts two radios sharing a channel on one frequency.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_OVERRIDE_FREQ,          "Transmits on this exact frequency in MHz instead of a slot, and 0 goes back to the slot above. Off your band plan this is illegal without a licence.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_FREQUENCY_TRIM,         "Corrects this radio's own crystal error, in hertz. It is a calibration rather than another frequency, and 0 is right unless something measured says otherwise.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_IGNORE_NODES,           "Up to three nodes whose packets this radio drops as though they were out of range. Not the Nodes tab's Ignore, which hides a node the radio still relays for.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_HAM_CALL_SIGN,          "Your licensed call sign, which becomes this node's name on the mesh. Ham mode is only legal for the operator it names, and the row below it is what sends it.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_HAM_FREQUENCY,          "The amateur-band frequency in MHz this radio moves to. Your licence and your country's band plan decide what belongs here; nothing in this client can check it.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_HAM_TX_POWER,           "How hard the radio transmits once in ham mode, in dBm. Amateur allowances are usually higher than the unlicensed ones, and the radio's own maximum still applies.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_HAM_ACTION,             "Hands the radio the three rows above as one licensed-operator switch. Leaving ham mode is two rows rather than a press: User > Licensed operator off, and Override frequency back to 0.")

/* Security. The admin keys are phase 2's, above. */
MESH_STR_ENTRY(SETTINGS_NOTE_SECURITY_PRIVATE_KEY,        "This radio's identity: what direct messages to it are encrypted against. Replacing it makes this a different node to everyone who has met it, and each has to learn it again.")
MESH_STR_ENTRY(SETTINGS_NOTE_SECURITY_MANAGED,            "Refuses configuration from the radio's own screen and from a connected client, leaving only remote administration by an admin key. With no working key set, that locks you out.")
MESH_STR_ENTRY(SETTINGS_NOTE_SECURITY_ADMIN_CHANNEL,      "Accepts configuration sent over the legacy admin channel rather than by key. Anyone holding that channel can then reconfigure this radio, which is why keys replaced it.")
MESH_STR_ENTRY(SETTINGS_NOTE_SECURITY_SERIAL,             "Leaves the debug console on the radio's USB port enabled. Useful while setting a board up, and one more way in on a radio somebody else can pick up.")
MESH_STR_ENTRY(SETTINGS_NOTE_SECURITY_DEBUG_LOG,          "Streams the radio's debug log over the USB or Bluetooth link. It is noisy, and it says more about what the radio is doing than a stranger should be handed.")
MESH_STR_ENTRY(SETTINGS_NOTE_SECURITY_SIGNATURE,          "How fussy this radio is about signatures on the packets it receives. Strict ignores anything it cannot verify, which is the safest and cuts off nodes too old to sign.")

/* Neighbor info. The interval is phase 2's, above. */
MESH_STR_ENTRY(SETTINGS_NOTE_NEIGHBOR_ENABLED,            "Reports which nodes this radio hears directly, which is what a map of the mesh's own shape is built from. Each report is large, which is why it starts off.")
MESH_STR_ENTRY(SETTINGS_NOTE_NEIGHBOR_OVER_LORA,          "Puts the neighbour report on the radio band as well as on MQTT. It is the expensive half, and the firmware refuses it on a channel still using the default name and key.")

/* Range test. */
MESH_STR_ENTRY(SETTINGS_NOTE_RANGE_TEST_SENDER,           "How often a numbered test packet goes out. Off makes this radio the other end of the test: it logs what it hears and transmits nothing itself.")
MESH_STR_ENTRY(SETTINGS_NOTE_RANGE_TEST_SAVE,             "Writes every test packet this radio hears to a CSV file on its own storage, to be read back over USB afterwards. It needs a board with a filesystem.")
MESH_STR_ENTRY(SETTINGS_NOTE_RANGE_TEST_CLEAR,            "Empties the test log every time the radio starts, so each walk is a file of its own rather than appended to the end of the last one.")

/* Paxcounter. */
MESH_STR_ENTRY(SETTINGS_NOTE_PAX_INTERVAL,                "How often the count goes out. Each report is a broadcast on the mesh, and a headcount that changes slowly does not need a short interval.")
MESH_STR_ENTRY(SETTINGS_NOTE_PAX_WIFI,                    "How strong a WiFi signal has to be, in dBm, before its device is counted. Raise the floor to count what is in the room and ignore the street outside.")
MESH_STR_ENTRY(SETTINGS_NOTE_PAX_BLE,                     "How strong a Bluetooth signal has to be, in dBm, before its device is counted. Bluetooth carries less far than WiFi, so the two floors are not the same number.")

/* TAK. */
MESH_STR_ENTRY(SETTINGS_NOTE_TAK_TEAM,                    "The colour other TAK clients draw this node in. It carries no permissions and changes nothing on the mesh - it is how a group tells itself apart on a map.")
MESH_STR_ENTRY(SETTINGS_NOTE_TAK_ROLE,                    "The role symbol TAK clients draw for this node: a label on somebody else's map, and nothing the radio itself acts on.")

/* Ambient lighting. */
MESH_STR_ENTRY(SETTINGS_NOTE_AMBIENT_CURRENT,             "How much current the LED may draw, in milliamps. Ask for more than the board can supply and it browns out rather than shining any brighter.")

/* Detection sensor. */
MESH_STR_ENTRY(SETTINGS_NOTE_DETECT_NAME,                 "What the mesh is told the sensor is called, since the message is otherwise a state change from a node. It is sent with every report, so keep it short.")
MESH_STR_ENTRY(SETTINGS_NOTE_DETECT_MIN_BROADCAST,        "The shortest gap between two reports, however often the pin actually changes. It is what stops a chattering switch transmitting all day.")
MESH_STR_ENTRY(SETTINGS_NOTE_DETECT_STATE_BROADCAST,      "Sends the current state on a timer even when nothing has changed, so a listener can tell a quiet sensor from a dead one. Off reports only the changes.")
MESH_STR_ENTRY(SETTINGS_NOTE_DETECT_SEND_BELL,            "Marks the report as an alert rather than an ordinary message, so that clients able to ring or buzz do. Use it for something worth interrupting somebody for.")
MESH_STR_ENTRY(SETTINGS_NOTE_DETECT_PIN,                  "The GPIO pin to watch, numbered as the radio's own board numbers it. The wrong number watches something else on the board, so check the wiring first.")
MESH_STR_ENTRY(SETTINGS_NOTE_DETECT_TRIGGER,              "Which change on the pin counts as the event: an edge in one direction, or the level the pin settles at. It has to match the wiring to be right about which state is which.")
MESH_STR_ENTRY(SETTINGS_NOTE_DETECT_PULLUP,               "Holds the pin high through the board's own resistor, so a switch that only ever pulls it to ground reads cleanly. Without it a floating pin reports noise.")

/* External notification. The three output trios are the section note's - see docs/help.md. */
MESH_STR_ENTRY(SETTINGS_NOTE_EXTNOTIF_ACTIVE,             "Whether an output is driven high or low when it fires. Backwards, it leaves the buzzer or the light on except when there is something to say.")
MESH_STR_ENTRY(SETTINGS_NOTE_EXTNOTIF_OUTPUT_MS,          "How long an output stays on for one alert. It is measured in milliseconds, so it is the length of a beep rather than of a ring.")
MESH_STR_ENTRY(SETTINGS_NOTE_EXTNOTIF_NAG,                "How long the alert keeps repeating until somebody acknowledges it on the radio itself. Once fires a single time and stops.")
MESH_STR_ENTRY(SETTINGS_NOTE_EXTNOTIF_PWM,                "Drives a tone rather than a plain on and off, which is what a passive buzzer needs to make a sound. It uses the board's own buzzer pin and ignores the plain output rows.")
MESH_STR_ENTRY(SETTINGS_NOTE_EXTNOTIF_I2S,                "Plays the alert through an I2S speaker, on the boards wired for one, instead of buzzing a pin.")

/* Traffic limits. */
MESH_STR_ENTRY(SETTINGS_NOTE_TRAFFIC_POSITION,            "Drops positions from the same node that arrive closer together than this. It limits what this radio accepts and passes on, not what it sends.")
MESH_STR_ENTRY(SETTINGS_NOTE_TRAFFIC_NODEINFO_HOPS,       "How far away a node may be and still have its question about who we are answered from this radio's cache. Off leaves every request to the node it is really about.")
MESH_STR_ENTRY(SETTINGS_NOTE_TRAFFIC_RATE_WINDOW,         "The stretch of time the packet count is measured over. Together the two rate rows are a ceiling on how much any one node may push through this radio.")
MESH_STR_ENTRY(SETTINGS_NOTE_TRAFFIC_RATE_PACKETS,        "How many packets one node may send through this radio inside the rate window before the rest are dropped. Off lets a single node use as much of the air as it likes.")
MESH_STR_ENTRY(SETTINGS_NOTE_TRAFFIC_UNKNOWN,             "How many packets this radio takes from a node it can neither decrypt nor identify before it stops listening to it. It is the cheap defence against a flood of noise.")

/* The radio's graphical interface. */
MESH_STR_ENTRY(SETTINGS_NOTE_UI_SCREEN_TIMEOUT,           "The interface's own idle timeout, which is not the panel's. Both have to be long enough for the screen to still be showing something by the time you look at it.")
MESH_STR_ENTRY(SETTINGS_NOTE_UI_ALERT,                    "Whether the radio interrupts whatever its screen is showing when a message arrives. Off still receives everything; it just does not take the screen to say so.")
MESH_STR_ENTRY(SETTINGS_NOTE_UI_BANNER,                   "Whether the interface throws a banner over the page for an event. Off leaves the screen on whatever page it was left on.")
MESH_STR_ENTRY(SETTINGS_NOTE_UI_RING_TONE,                "Which of the tunes stored on the radio it plays for an alert. The tune itself is a text string this client cannot edit, so the choice here is the whole of it.")
MESH_STR_ENTRY(SETTINGS_NOTE_UI_COMPASS_MODE,             "How the compass behaves on the radio's screen: a ring that turns with you, one that keeps north at the top, or a heading held where it was.")
MESH_STR_ENTRY(SETTINGS_NOTE_UI_GPS_FORMAT,               "Which notation positions are written in on the radio's screen. It changes how a coordinate is printed and nothing about what the radio knows.")
MESH_STR_ENTRY(SETTINGS_NOTE_UI_CLOCKFACE,                "Whether the radio draws its clock with hands or as digits.")

/* ---- the features: what a screen is for ------------------------------------------------------- */

/*
 * The other half of the help screen: the tabs and the overlays, keyed on the route rather than
 * on a settings section (docs/help.md, phase 3).
 *
 * Two kinds of id live here and they follow different rules. A HELP_NOTE_* is a paragraph and
 * plays by the note rules above - under 200 characters, and a locale may leave it untranslated.
 * A HELP_SUBJECT_* or HELP_LABEL_* is a *heading*: a few words naming the screen or the
 * paragraph under it, drawn beside the rest of the chrome, so it is an ordinary string and every
 * locale owes a translation for it.
 *
 * The subjects name what is being explained, on the trail above the title, and only exist where
 * no other string in the catalog already says it. The five tabs use their own tab names.
 */
MESH_STR_ENTRY(HELP_SUBJECT_THREAD,       "Conversation")
MESH_STR_ENTRY(HELP_SUBJECT_REACTION,     "Tapbacks")
MESH_STR_ENTRY(HELP_SUBJECT_NODE,         "Node")
MESH_STR_ENTRY(HELP_SUBJECT_NODE_ACTIONS, "What you can do")
MESH_STR_ENTRY(HELP_SUBJECT_WAYPOINT,     "Place")
MESH_STR_ENTRY(HELP_SUBJECT_MAP,          "Map")
MESH_STR_ENTRY(HELP_SUBJECT_SHARE,        "Sharing channels")
MESH_STR_ENTRY(HELP_SUBJECT_CONTACT,      "Your contact code")

/* Settings, on any section drawn as a column of cards: the one control the action bar has no
   room to name. A note rather than a keycap on the bar, because the bar is five hints wide on
   these screens already and a sixth would crowd the thing the cards are there to declutter. */
MESH_STR_ENTRY(HELP_LABEL_SETTINGS_GROUPS, "Moving between groups")
MESH_STR_ENTRY(HELP_NOTE_SETTINGS_GROUPS, "L2 and R2 jump a whole group at a time - one card per press - where up and down walk the rows. L1 and R1 still change tabs.")

/* Messages: the conversation list. */
MESH_STR_ENTRY(HELP_LABEL_MESSAGES_NEW,   "Starting a conversation")
MESH_STR_ENTRY(HELP_LABEL_MESSAGES_DROP,  "Deleting one")
MESH_STR_ENTRY(HELP_LABEL_MESSAGES_MUTE,  "Muting one")
MESH_STR_ENTRY(HELP_NOTE_MESSAGES,        "Every conversation this client has heard, newest first: one node you have exchanged messages with, or one channel. The top row carries all traffic at once.")
MESH_STR_ENTRY(HELP_NOTE_MESSAGES_NEW,    "Y asks who to write to and opens the keyboard on the conversation you pick. A conversation appears here on its own as soon as anything arrives in it.")
MESH_STR_ENTRY(HELP_NOTE_MESSAGES_DROP,   "X twice drops a conversation from this client. It removes nothing from the mesh and nothing from the radio, and anything new in it starts the conversation again.")
MESH_STR_ENTRY(HELP_NOTE_MESSAGES_MUTE,   "START stops a conversation interrupting you: no count on the Messages tab, no notice over what you are doing. Its messages still arrive and the row still counts them. A node the radio mutes is too.")

/* Messages: one transcript. */
MESH_STR_ENTRY(HELP_LABEL_THREAD_MARKS,   "The mark on a message")
MESH_STR_ENTRY(HELP_LABEL_THREAD_REPLY,   "Replies and tapbacks")
MESH_STR_ENTRY(HELP_LABEL_THREAD_ALL,     "The all-traffic view")
MESH_STR_ENTRY(HELP_LABEL_THREAD_HISTORY, "How far back it goes")
MESH_STR_ENTRY(HELP_LABEL_THREAD_RESEND,  "Sending it again")
MESH_STR_ENTRY(HELP_NOTE_THREAD,          "What was said here, oldest at the top. Your own messages sit on the right; a padlock means the channel was encrypted, and the hop count is how far the message travelled.")
MESH_STR_ENTRY(HELP_NOTE_THREAD_HISTORY,  "This conversation is kept on the card and goes back further than the radio does - scroll up for older messages. Each conversation has its own store, so a busy channel never pushes a quiet one out.")
MESH_STR_ENTRY(HELP_NOTE_THREAD_MARKS,    "A clock means the radio is still waiting to hear that a message arrived, a double tick that a node confirmed it, an alert that it did not. A broadcast asks for no answer and carries no mark.")
MESH_STR_ENTRY(HELP_NOTE_THREAD_REPLY,    "A answers the message under the cursor and X opens what else can be done with it; Y writes to the conversation. A reply stays aimed at the message you pressed on, however far the transcript moves.")
MESH_STR_ENTRY(HELP_NOTE_THREAD_ALL,      "The top row of the list is every message the radio heard, whoever it was for. There is nobody to reply to in it, so it offers no reply and no tapback - open the conversation itself for those.")
MESH_STR_ENTRY(HELP_NOTE_THREAD_RESEND,   "A message marked undelivered can go out again: START sends the same words to the same place as a new message. The one that failed stays where it is, because it is part of what happened here.")

/* Messages: the bubble sheet. */
MESH_STR_ENTRY(HELP_LABEL_REACTION_SEND,  "What it costs")
MESH_STR_ENTRY(HELP_LABEL_REACTION_DELETE, "Deleting a message")
MESH_STR_ENTRY(HELP_NOTE_REACTION,        "A tapback is an emoji aimed at one message. It draws as a chip on the message it names rather than as a bubble of its own, so it answers without taking a line of the conversation.")
MESH_STR_ENTRY(HELP_NOTE_REACTION_SEND,   "One small packet, sent without asking to be acknowledged - so it earns no delivery mark and costs the mesh no retry. The set is fixed so that every client can draw what you sent.")
MESH_STR_ENTRY(HELP_NOTE_REACTION_DELETE, "The last row throws this message away, and it takes two presses. It removes your copy only - the mesh cannot recall a message, so everyone who heard it still has it. Tapbacks on it go with it.")

/* Nodes. */
MESH_STR_ENTRY(HELP_LABEL_NODES_FILTER,   "The filter row")
MESH_STR_ENTRY(HELP_LABEL_NODES_SORT,     "The sort row")
MESH_STR_ENTRY(HELP_LABEL_NODES_PIN,      "Pinned nodes")
MESH_STR_ENTRY(HELP_LABEL_NODES_CACHED,   "Nodes the radio has forgotten")
MESH_STR_ENTRY(HELP_NOTE_NODES,           "Everyone this client has heard of, the most recently heard first. A node that has never said what it is called is listed by its node number, exactly as the phone apps list it.")
MESH_STR_ENTRY(HELP_NOTE_NODES_FILTER,    "The first row decides what is under it: all of the roster, the nodes heard with no relay in the way, or the ones you pinned. Left and Right move between them, and the heading counts what is shown.")
MESH_STR_ENTRY(HELP_NOTE_NODES_SORT,      "The second row is the order: the client's own ranking, most recently heard, by name, nearest, or fewest hops. Left and Right step it. Distance needs a fix of your own, and says so when it has none.")
MESH_STR_ENTRY(HELP_NOTE_NODES_PIN,       "X pins a node to the top of the list and keeps it there. Pins are this client's own and are kept across a restart; they change nothing on the radio.")
MESH_STR_ENTRY(HELP_NOTE_NODES_CACHED,    "The radio holds about eighty nodes and drops the oldest, so this list is deliberately longer than its NodeDB and marks what the radio no longer carries. Settings > Radio actions clears them.")

/* One node's detail. */
MESH_STR_ENTRY(HELP_LABEL_NODE_FIX,       "Fix and Fix heard")
MESH_STR_ENTRY(HELP_LABEL_NODE_TREND,     "The small graphs")
MESH_STR_ENTRY(HELP_NOTE_NODE,            "What this client knows about one node: who it says it is, where it said it was, and how well this radio hears it. All of it is what the node last told the mesh.")
MESH_STR_ENTRY(HELP_NOTE_NODE_FIX,        "Fix is when the node's own GPS solved the position. Fix heard is when the packet reached us, and the row changes its name rather than quietly answering the first question with the second.")
MESH_STR_ENTRY(HELP_NOTE_NODE_TREND,      "A reading over time, drawn against the same scale as the bar beside it. It is only what this client watched while running, so it starts empty after a restart and breaks where the node went quiet.")
/* The four this screen was missing. It is the longest list in the client - ten verbs and a
   hundred facts in a dozen cards - and its help said what the screen was and then explained two
   of the rows, which leaves the reader to discover the presses by trying them. */
MESH_STR_ENTRY(HELP_LABEL_NODE_GROUPS,    "Getting around")
MESH_STR_ENTRY(HELP_NOTE_NODE_GROUPS,     "The rows are grouped into cards. Up and Down stop on each row A acts on and on each card of facts; Left and Right jump a card at a time. A is named only where it does something.")
/* The row that opens the verbs, which are no longer on this screen. First of the paragraphs
   about presses, because it is the only press on the detail that leads anywhere the reader
   cannot see from it. */
MESH_STR_ENTRY(HELP_LABEL_NODE_ACTIONS,   "Acting on this node")
MESH_STR_ENTRY(HELP_NOTE_NODE_ACTIONS,    "The top row opens everything this client can do to the node: write to it, pin it, ask it for a reading, trace the route to it, or drop it. X pins and Y writes from here without opening it.")
MESH_STR_ENTRY(HELP_LABEL_NODE_VERBS,     "Mute, ignore, remove")
MESH_STR_ENTRY(HELP_NOTE_NODE_VERBS,      "Mute stops this node raising notices here and on the radio. Ignore has the radio drop its packets before we ever see them. Remove drops it from the NodeDB; it returns if the node speaks again.")
/* What the padlock in a conversation means, and the row that changes it. Two paragraphs because
   a note is capped at 200 characters, and because they answer two questions: what the mark
   claims, and what to do about it. The last sentence of the second is the one that matters -
   reading the code over the mesh would prove nothing, since the mesh is exactly where an
   impostor would be sitting. */
MESH_STR_ENTRY(HELP_LABEL_NODE_KEY,       "Key")
MESH_STR_ENTRY(HELP_NOTE_NODE_KEY,        "A direct message is encrypted to this node's public key, and the padlock beside it says so. It does not say the key is theirs: a key arrives over the air from whoever sent it.")
MESH_STR_ENTRY(HELP_LABEL_NODE_VERIFY,    "Verifying a key")
MESH_STR_ENTRY(HELP_NOTE_NODE_VERIFY,     "Verify this key swaps a number and a short code with the other person out loud, by phone or face to face, and marks the key proven if both match. Never read either over the mesh.")
/* Remote administration, explained where it is entered. The second sentence is the one that
   matters: holding a key is what lets the request be *sent*, and being in the far radio's admin
   list is what makes it answered - and from here the two are indistinguishable until nothing
   comes back. */
MESH_STR_ENTRY(HELP_LABEL_NODE_ADMIN,     "Configure by radio")
MESH_STR_ENTRY(HELP_NOTE_NODE_ADMIN,      "Points the Settings tab at this node's radio instead of your own, over the mesh. It answers only if your key is in that radio's admin list. About radio brings you back.")
MESH_STR_ENTRY(HELP_LABEL_NODE_SIGNAL,    "SNR, RSSI and hops")
MESH_STR_ENTRY(HELP_NOTE_NODE_SIGNAL,     "SNR is how far above the noise a packet arrived, RSSI how loud it was. Only this radio can measure either, so a node more than one hop away reports the last relay's link and gets no bar.")
MESH_STR_ENTRY(HELP_LABEL_NODE_NEIGHBOURS, "Neighbours and Heard by")
MESH_STR_ENTRY(HELP_NOTE_NODE_NEIGHBOURS, "Neighbours is who this node says it hears. Heard by is the reverse, assembled from what every other node reported - nobody broadcasts it, so it is only as complete as this client's own list.")

/* Waypoints. */
MESH_STR_ENTRY(HELP_LABEL_WAYPOINT_NEW,   "Naming a place")
MESH_STR_ENTRY(HELP_LABEL_WAYPOINT_SHARE, "Who else sees it")
MESH_STR_ENTRY(HELP_LABEL_WAYPOINT_DROP,  "Deleting one")
MESH_STR_ENTRY(HELP_NOTE_WAYPOINTS,       "Places the mesh has agreed on, nearest first from wherever this radio last had a fix. The distance and the bearing are measured from that fix, so they need one to mean anything.")
MESH_STR_ENTRY(HELP_NOTE_WAYPOINT_NEW,    "The last row of the list makes a place where you are standing. It needs a position from the radio, and says so rather than disappearing when there is none.")
MESH_STR_ENTRY(HELP_NOTE_WAYPOINT_SHARE,  "Sharing broadcasts the place on a channel, so everyone holding that channel's key gets it. Sending it again with the same name replaces the copy they hold rather than adding a second.")
MESH_STR_ENTRY(HELP_NOTE_WAYPOINT_DROP,   "Deleting a place you shared asks the whole mesh to forget it. A place somebody else shared is only dropped here, because withdrawing it is theirs to do and not ours.")

/* The map. The first note is the one worth reading: this screen's d-pad is the only one in the
   client that does not move a cursor, and a reader who does not know that will think it is
   broken. The last is about honesty rather than about a control - a marker is where a node said
   it was, which is not always where the node is. */
MESH_STR_ENTRY(HELP_LABEL_MAP_MOVE,       "Moving around")
MESH_STR_ENTRY(HELP_LABEL_MAP_PICK,       "Opening a marker")
MESH_STR_ENTRY(HELP_LABEL_MAP_TRUST,      "How much to believe it")
MESH_STR_ENTRY(HELP_NOTE_MAP,             "Every node and shared place that has reported a position, drawn north-up. There is no map underneath yet, so the grid and the scale bar are what distances are read against.")
MESH_STR_ENTRY(HELP_NOTE_MAP_MOVE,        "The d-pad moves the view, not a cursor: a direction stops on the next marker that way, or slides the view when there is none. The shoulders still change tab and START frames everything.")
MESH_STR_ENTRY(HELP_NOTE_MAP_PICK,        "Whatever is nearest the crosshair in the middle is what A opens, so aiming is panning. A node opens its details and a place opens on the Waypoints tab.")
MESH_STR_ENTRY(HELP_NOTE_MAP_TRUST,       "A marker is where a node last said it was, not where it is now. Senders often round their position on purpose, and the ring around a marker is how far out it may be.")

/* Devices. */
MESH_STR_ENTRY(HELP_LABEL_DEVICES_PAIR,   "Pairing")
MESH_STR_ENTRY(HELP_LABEL_DEVICES_FORGET, "Forgetting one")
MESH_STR_ENTRY(HELP_NOTE_DEVICES,         "The radios this Brick can reach: Bluetooth nodes it can see, and anything plugged into the USB port. A opens a link to the one under the cursor and X closes it.")
MESH_STR_ENTRY(HELP_NOTE_DEVICES_PAIR,    "A Bluetooth radio wants pairing the first time. The radio shows a six-digit code on its own screen and this client asks for it; the pairing is then kept until one side forgets it.")
MESH_STR_ENTRY(HELP_NOTE_DEVICES_FORGET,  "Y twice drops a radio's pairing from this Brick. Connecting again needs the code again, which is what to do when a radio was re-flashed and no longer knows this client.")
MESH_STR_ENTRY(HELP_LABEL_DEVICES_NETWORK, "The network radio")
MESH_STR_ENTRY(HELP_NOTE_DEVICES_NETWORK, "The last row reaches a node over WiFi. It takes an address like 192.168.1.50 or a name like meshtastic.local; add :4403 only for another port. Y edits, clearing forgets.")

/* Status. */
MESH_STR_ENTRY(HELP_LABEL_STATUS_COUNTS,  "Why two node counts differ")
/* The Mesh card's own figures, which is the entry a reader in a field goes looking for: the
   percentages are the two that decide whether the mesh works at all, and neither of them says so
   on the card - there is a bar and a colour, and no room for a sentence. */
MESH_STR_ENTRY(HELP_LABEL_STATUS_AIRTIME, "The airtime figures")
MESH_STR_ENTRY(HELP_LABEL_STATUS_TRAFFIC, "Sent and Heard")
MESH_STR_ENTRY(HELP_LABEL_STATUS_FLOOR,   "The noise floor")
/* The Broker card, which is on screen only for a radio that asked to be proxied for - so the
   note is written for somebody who has one and is wondering why it is not working, rather than
   as an introduction to the feature. */
MESH_STR_ENTRY(HELP_LABEL_STATUS_BROKER,  "The Broker card")
MESH_STR_ENTRY(HELP_NOTE_STATUS,          "How this client, its link and the radio are doing, one card each. A card the radio has told us nothing about says so rather than disappearing, so nothing moves under the cursor.")
MESH_STR_ENTRY(HELP_NOTE_STATUS_COUNTS,   "NodeDB is what the radio still holds and Cached here is what this client remembers, which is deliberately more: a node the radio evicted is gone for good, so we keep it.")
MESH_STR_ENTRY(HELP_NOTE_STATUS_AIRTIME,  "Busy is the share of the air every radio in earshot is using; tx is the part of it this radio sent. Past a quarter busy, hops start failing - which is where the bar is notched.")
MESH_STR_ENTRY(HELP_NOTE_STATUS_TRAFFIC,  "Sent is what this radio transmitted, including what it relayed for others. Heard splits what arrived into new, repeats and malformed. Both are totals since the radio booted.")
MESH_STR_ENTRY(HELP_NOTE_STATUS_FLOOR,    "How loud the channel is with nothing on it, in dBm. It is negative and nearer zero is worse: around -120 is a clean band, and a floor above -100 is something local drowning quiet nodes out.")
MESH_STR_ENTRY(HELP_NOTE_STATUS_BROKER,   "Shown when the radio has asked this client to reach a broker for it. Topics is what we subscribed to: none means no channel has downlink on, so traffic goes out and none comes back.")

/* The trend chart, which is a screen of its own rather than a row on the Status list - so it is
   keyed on its route rather than read off a settings row. */
MESH_STR_ENTRY(HELP_SUBJECT_TREND,        "Airtime trend")
MESH_STR_ENTRY(HELP_SUBJECT_NODE_CHART,   "This node's trend")
/*
 * The share screen. What a reader arrives here wanting is not "what is a QR code" - it is
 * whether the key is in the picture, which it is, and that is the sentence that has to be in
 * the first paragraph rather than the third.
 */
MESH_STR_ENTRY(HELP_NOTE_SHARE,           "Everything needed to join this radio's channels, as one link. Point a phone's camera or the Meshtastic app at the code; typing the link underneath it does the same thing.")
MESH_STR_ENTRY(HELP_LABEL_SHARE_KEYS,     "It carries the keys")
MESH_STR_ENTRY(HELP_NOTE_SHARE_KEYS,      "Anyone who reads this code can read these channels' traffic. It is as secret as the key itself: show it to the people joining, to nobody else, and never to a camera that is recording.")
MESH_STR_ENTRY(HELP_LABEL_SHARE_WHAT,     "What is in it")
MESH_STR_ENTRY(HELP_NOTE_SHARE_WHAT,      "The primary channel, every secondary, and this radio's LoRa settings - region, preset and the rest. Disabled slots are left out. A radio that joins gets all of it and leaves its own channels behind.")
MESH_STR_ENTRY(HELP_LABEL_SHARE_IMPORT,   "Going the other way")
MESH_STR_ENTRY(HELP_NOTE_SHARE_IMPORT,    "There is no camera here, so a link arriving has to be typed: \"Add from a link\" on the channel list opens the keyboard. Just the part after the # will do.")
/*
 * The contact code screen. What somebody arrives here wanting is the difference between this
 * code and the channel one, because both are squares on a screen and only one of them is a
 * secret - so that is the first paragraph rather than a caveat at the bottom.
 */
MESH_STR_ENTRY(HELP_NOTE_CONTACT,         "This radio's name, number and public key, as one link. A phone that reads it can message this radio encrypted without waiting to hear it transmit.")
MESH_STR_ENTRY(HELP_LABEL_CONTACT_SAFE,   "It is not a secret")
MESH_STR_ENTRY(HELP_NOTE_CONTACT_SAFE,    "A public key is meant to be published; this code is safe to show to anyone, unlike the channel one. What it does not carry is the private key, so nobody who reads it can pretend to be this radio.")
MESH_STR_ENTRY(HELP_LABEL_CONTACT_TRUST,  "It is not a verification")
MESH_STR_ENTRY(HELP_NOTE_CONTACT_TRUST,   "A code proves who sent it no more than a name does. A contact added from a link arrives unverified: the padlock still takes the spoken ceremony under \"Verify key\".")
MESH_STR_ENTRY(HELP_LABEL_CONTACT_IMPORT, "Going the other way")
MESH_STR_ENTRY(HELP_NOTE_CONTACT_IMPORT,  "There is no camera here, so a code arriving has to be typed: \"Add from a link\" under your own name opens the keyboard. Just the part after the # will do.")
MESH_STR_ENTRY(HELP_LABEL_TREND_AXES,     "What the axes say")
MESH_STR_ENTRY(HELP_LABEL_TREND_MARKS,    "Columns and lines")
MESH_STR_ENTRY(HELP_LABEL_TREND_SPAN,     "Choosing how far back")
MESH_STR_ENTRY(HELP_NOTE_TREND,           "How busy the air has been, over the reports this client has watched. The card's small line says which way; this says how far and since when.")
MESH_STR_ENTRY(HELP_NOTE_TREND_AXES,      "Up is the share of the air in use, starting at nothing. The top follows the readings up a fixed ladder - 1, 2, 5, 10, 25, 50, 100 - so a quiet mesh is still a shape, and the label says which.")
MESH_STR_ENTRY(HELP_NOTE_TREND_SPAN,      "Left and Right pick how much of the record is on the picture, ending at the newest reading. The words under the plot say what there turned out to be, which is less when that is all there is.")
MESH_STR_ENTRY(HELP_NOTE_TREND_MARKS,     "A column is how busy the air was over that stretch; the line is the part we sent. Faint rules are where the card's bar turns amber. No column means the radio said nothing, not zero.")
/* The chart one of those small graphs opens, which is a screen rather than a row - so its help
   is keyed on the route and sits here with the airtime chart's rather than on a field. */
MESH_STR_ENTRY(HELP_LABEL_NODE_CHART,     "What this shows")
MESH_STR_ENTRY(HELP_NOTE_NODE_CHART,      "One reading of this node over time, starting where the bar you opened it from starts - never the range these readings span, so two visits compare. Across is time, and the span says how long.")
MESH_STR_ENTRY(HELP_LABEL_NODE_CHART_GAPS, "Gaps and rules")
MESH_STR_ENTRY(HELP_LABEL_NODE_CHART_SPAN, "Choosing how far back")
MESH_STR_ENTRY(HELP_NOTE_NODE_CHART_GAPS, "The faint rules are where the reading troubles the node reporting it, not the weather. A break is a stretch it said nothing, not a zero. Nothing here survives a restart: it is what this client saw.")
MESH_STR_ENTRY(HELP_NOTE_NODE_CHART_SPAN, "Left and Right pick how much of the record is on the picture, ending at the newest reading. A node reports every half hour by default, so the shorter spans hold only a reading or two.")
/* And the other face. Two things it has to say and neither is obvious from the screen: that the
   press exists, and that the left-hand column is not a clock. */
MESH_STR_ENTRY(HELP_LABEL_NODE_CHART_READINGS, "Reading the figures")
MESH_STR_ENTRY(HELP_NOTE_NODE_CHART_READINGS, "Y lists the same readings as exact figures instead of drawing them, newest first; Up and Down move through them. The left column is how long before the newest reading each was taken, not a clock time.")


/* ---- settings: field labels ------------------------------------------------------------------- */

/* One per editable row, in the order src/ui/settings/settings.c declares them. Several read the same
   in English - four modules each have an "Enabled" and an "Interval" - and still get an id
   each, because a language that inflects them will not want the same word in all four. */
MESH_STR_ENTRY(SETTINGS_FIELD_USER_LONG_NAME,             "Long name")
MESH_STR_ENTRY(SETTINGS_FIELD_USER_SHORT_NAME,            "Short name")
MESH_STR_ENTRY(SETTINGS_FIELD_USER_LICENSED,              "Licensed operator")
MESH_STR_ENTRY(SETTINGS_FIELD_USER_UNMESSAGEABLE,         "Unmessageable")
MESH_STR_ENTRY(SETTINGS_FIELD_DEVICE_ROLE,                "Role")
MESH_STR_ENTRY(SETTINGS_FIELD_DEVICE_TZDEF,               "Time zone")
MESH_STR_ENTRY(SETTINGS_FIELD_DEVICE_REBROADCAST,         "Rebroadcast")
MESH_STR_ENTRY(SETTINGS_FIELD_DEVICE_NODEINFO_SECS,       "NodeInfo every")
MESH_STR_ENTRY(SETTINGS_FIELD_DEVICE_LED_HEARTBEAT,       "LED heartbeat")
MESH_STR_ENTRY(SETTINGS_FIELD_DEVICE_DOUBLE_TAP,          "Double tap = button")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_GPS_MODE,          "GPS")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_BROADCAST_SECS,    "Broadcast every")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_SMART,             "Smart broadcast")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_SMART_DISTANCE,    "Smart distance")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_SMART_INTERVAL,    "Smart interval")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_GPS_INTERVAL,      "GPS interval")
/* PositionConfig.position_flags, one row per bit. Labels are what the field is rather than
   what the protobuf calls it: SATINVIEW is "Satellites" and SEQ_NO a "Sequence number". */
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_FLAG_ALTITUDE,     "Altitude")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_FLAG_ALTITUDE_MSL, "Altitude is MSL")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_FLAG_GEOIDAL,      "Geoid separation")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_FLAG_DOP,          "Precision (DOP)")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_FLAG_HVDOP,        "Split precision")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_FLAG_SATINVIEW,    "Satellites")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_FLAG_SEQ_NO,       "Sequence number")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_FLAG_TIMESTAMP,    "Fix time")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_FLAG_HEADING,      "Heading")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_FLAG_SPEED,        "Speed")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_LATITUDE,          "Latitude")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_LONGITUDE,         "Longitude")
MESH_STR_ENTRY(SETTINGS_FIELD_POSITION_ALTITUDE,          "Altitude (m)")
MESH_STR_ENTRY(SETTINGS_FIELD_POWER_SAVING,               "Power saving")
MESH_STR_ENTRY(SETTINGS_FIELD_POWER_LS_SECS,              "Light sleep")
MESH_STR_ENTRY(SETTINGS_FIELD_POWER_MIN_WAKE,             "Min wake")
MESH_STR_ENTRY(SETTINGS_FIELD_POWER_WAIT_BT,              "Wait for Bluetooth")
MESH_STR_ENTRY(SETTINGS_FIELD_POWER_SHUTDOWN,             "Shutdown on battery")
MESH_STR_ENTRY(SETTINGS_FIELD_DISPLAY_SCREEN_ON,          "Screen on")
MESH_STR_ENTRY(SETTINGS_FIELD_DISPLAY_CAROUSEL,           "Carousel")
MESH_STR_ENTRY(SETTINGS_FIELD_DISPLAY_COMPASS,            "Compass")
MESH_STR_ENTRY(SETTINGS_FIELD_DISPLAY_12H,                "12-hour clock")
MESH_STR_ENTRY(SETTINGS_FIELD_DISPLAY_UNITS,              "Units")
MESH_STR_ENTRY(SETTINGS_FIELD_DISPLAY_FLIP,               "Flip screen")
MESH_STR_ENTRY(SETTINGS_FIELD_DISPLAY_OLED,               "Panel type")
MESH_STR_ENTRY(SETTINGS_FIELD_DISPLAY_MODE,               "Layout")
MESH_STR_ENTRY(SETTINGS_FIELD_DISPLAY_HEADING_BOLD,       "Bold heading")
