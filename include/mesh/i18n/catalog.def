MESH_STR_ENTRY(CONFIRM_TITLE_RESTORE,     "Restore the configuration?")
MESH_STR_ENTRY(CONFIRM_TITLE_RM_BACKUP,   "Delete the backup?")
MESH_STR_ENTRY(CONFIRM_TITLE_SAVE_CHANNEL,"Save channel %u?")
MESH_STR_ENTRY(CONFIRM_TITLE_SAVE,        "Save %s?")

/* The row that goes ahead. Every one names what it does rather than saying "OK", because the
   sheet is the last thing between a press and something that cannot be undone. */
MESH_STR_ENTRY(CONFIRM_ACCEPT_REBOOT,     "Reboot now")
MESH_STR_ENTRY(CONFIRM_ACCEPT_SHUTDOWN,   "Shut down now")
MESH_STR_ENTRY(CONFIRM_ACCEPT_RESET_DB,   "Reset the node database")
MESH_STR_ENTRY(CONFIRM_ACCEPT_FORGET_OFF, "Forget them")
MESH_STR_ENTRY(CONFIRM_ACCEPT_FORGET_ALL, "Forget them all")
MESH_STR_ENTRY(CONFIRM_ACCEPT_FACTORY_CFG,"Factory reset config")
MESH_STR_ENTRY(CONFIRM_ACCEPT_FACTORY_DEV,"Factory reset device")
MESH_STR_ENTRY(CONFIRM_ACCEPT_BACKUP,     "Back up")
MESH_STR_ENTRY(CONFIRM_ACCEPT_RESTORE,    "Restore")
MESH_STR_ENTRY(CONFIRM_ACCEPT_RM_BACKUP,  "Delete backup")
MESH_STR_ENTRY(CONFIRM_ACCEPT_SAVE,       "Save to radio")

/*
 * The paragraph under it. Four wrapped lines is what the sheet draws, so each of these has to
 * stop inside that - a warning whose last clause is cut off is worse than a shorter one, and a
 * translation that runs longer than the English will be the one that gets cut. Say what is
 * lost, and say what is spared: "favorites excepted" is the difference between a press the
 * user regrets and one they do not.
 */
MESH_STR_ENTRY(CONFIRM_TEXT_REBOOT,       "The radio restarts in a few seconds. The link drops with it and auto-connect brings it back; anything sent to this node meanwhile is lost.")
MESH_STR_ENTRY(CONFIRM_TEXT_SHUTDOWN,     "The radio powers off in a few seconds and nothing here can wake it again: that takes its own button. Everything it has stored survives.")
MESH_STR_ENTRY(CONFIRM_TEXT_RESET_DB,     "The radio forgets every node it heard, favorites excepted. Names come back as each speaks again. The Brick's own list stays; the row below clears it.")
MESH_STR_ENTRY(CONFIRM_TEXT_FORGET_OFF,   "Drops the nodes this Brick remembers and the radio no longer carries - the ones the Nodes tab marks \"off radio\". Pins and ourselves stay.")
MESH_STR_ENTRY(CONFIRM_TEXT_FORGET_ALL,   "Empties this Brick's node list, ourselves and pins excepted. The radio's database is untouched; the list fills again on the next connect.")
MESH_STR_ENTRY(CONFIRM_TEXT_FACTORY_CFG,  "Every setting returns to its factory default, the Bluetooth bond excepted. Channels and keys go too: the node leaves your mesh until set up again.")
MESH_STR_ENTRY(CONFIRM_TEXT_FACTORY_DEV,  "Every setting and the node database return to factory defaults, and the Bluetooth bond is cleared: forget the node in Devices (Y) and pair again.")
MESH_STR_ENTRY(CONFIRM_TEXT_BACKUP,       "The radio copies every setting it holds to its own flash, replacing whatever backup was there before. Nothing on the mesh changes.")
MESH_STR_ENTRY(CONFIRM_TEXT_RESTORE,      "Every setting on the radio goes back to whatever the backup holds, this client's own settings excepted. The radio restarts; without a backup nothing happens.")
MESH_STR_ENTRY(CONFIRM_TEXT_RM_BACKUP,    "The saved copy is erased from the radio's flash. The settings it is running now are untouched, and there is nothing left to restore from.")
MESH_STR_ENTRY(CONFIRM_TEXT_BLUETOOTH,    "The radio will reboot. Changing the pairing mode or PIN invalidates the Brick's bond: forget the node in Devices (Y) and connect again to pair with the new PIN. Turning Bluetooth off cuts this client off entirely.")
MESH_STR_ENTRY(CONFIRM_TEXT_CHANNELS,     "The radio will reboot. A new key or name moves this radio to a different channel: every other node needs the same settings to keep talking to it.")
MESH_STR_ENTRY(CONFIRM_TEXT_LORA,         "The radio will reboot. A region or preset the other nodes do not share takes this radio off the mesh, and a wrong region may be illegal to transmit on. Transmit off makes it receive-only.")
MESH_STR_ENTRY(CONFIRM_TEXT_SECURITY,     "A new private key changes this node's identity: peers must learn it again and old direct messages stay unreadable. Managed mode locks out every client whose key is not an admin key, this one included.")
MESH_STR_ENTRY(CONFIRM_TEXT_POWER,        "The radio will reboot. Power saving puts the radio to sleep between packets, and a short light-sleep or wake time can leave too little Bluetooth on for this client to reconnect on its own.")
MESH_STR_ENTRY(CONFIRM_TEXT_DEFAULT,      "The radio will reboot to apply this.")

/* ---- transport status ------------------------------------------------------------------------- */

/*
 * What the header and the Status screen say the link is doing. These are one word each because
 * they share the top line with the connected node's name.
 *
 * "BlueZ" is the Linux Bluetooth stack's own name and stays as it is; so does "adapter", which
 * is what BlueZ calls the radio in the Brick.
 */
MESH_STR_ENTRY(TRANSPORT_UNKNOWN,         "unknown")
MESH_STR_ENTRY(TRANSPORT_DISABLED,        "disabled")
MESH_STR_ENTRY(TRANSPORT_INACTIVE,        "inactive")
MESH_STR_ENTRY(TRANSPORT_STOPPED,         "stopped")
MESH_STR_ENTRY(TRANSPORT_UNAVAILABLE,     "unavailable")
MESH_STR_ENTRY(TRANSPORT_RUNNING,         "running")
MESH_STR_ENTRY(TRANSPORT_CONNECTING,      "connecting")
MESH_STR_ENTRY(TRANSPORT_CONNECTED,       "connected")
MESH_STR_ENTRY(TRANSPORT_PAIRING,         "pairing")
MESH_STR_ENTRY(TRANSPORT_WAITING_BLUEZ,   "waiting-for-bluez")
MESH_STR_ENTRY(TRANSPORT_WAITING_ADAPTER, "waiting-for-adapter")
MESH_STR_ENTRY(TRANSPORT_NO_PORTS,        "no-ports")

/* ---- delivery ---------------------------------------------------------------------------------- */

/*
 * Why a message did not arrive, from the Routing_Error the mesh sent back. Without these a
 * failed message is only "!!" on a bubble, which says nothing about whether to try again, move
 * the node, or fix a key - and those are three different problems.
 */
MESH_STR_ENTRY(ACK_DELIVERED,             "delivered")
MESH_STR_ENTRY(ACK_NO_ROUTE,              "no route to that node")
MESH_STR_ENTRY(ACK_GOT_NAK,               "rejected by the mesh")
MESH_STR_ENTRY(ACK_TIMEOUT,               "timed out")
MESH_STR_ENTRY(ACK_NO_INTERFACE,          "no radio interface")
/* The common one: the packet went out and nothing acknowledged it. Out of range, on another
   LoRa config, or switched off. */
MESH_STR_ENTRY(ACK_MAX_RETRANSMIT,        "no ack after retries")
MESH_STR_ENTRY(ACK_NO_CHANNEL,            "no matching channel")
MESH_STR_ENTRY(ACK_TOO_LARGE,             "message too large")
MESH_STR_ENTRY(ACK_NO_RESPONSE,           "no response")
MESH_STR_ENTRY(ACK_DUTY_CYCLE,            "duty cycle limit")
MESH_STR_ENTRY(ACK_BAD_REQUEST,           "bad request")
MESH_STR_ENTRY(ACK_NOT_AUTHORIZED,        "not authorized")
MESH_STR_ENTRY(ACK_PKI_FAILED,            "encryption failed")
MESH_STR_ENTRY(ACK_PKI_UNKNOWN_PUBKEY,    "no public key for that node")
MESH_STR_ENTRY(ACK_ADMIN_BAD_SESSION,     "admin session expired")
MESH_STR_ENTRY(ACK_ADMIN_UNAUTHORIZED,    "admin key not authorized")
MESH_STR_ENTRY(ACK_RATE_LIMIT,            "rate limited")
MESH_STR_ENTRY(ACK_PKI_SEND_FAIL,         "public key send failed")
MESH_STR_ENTRY(ACK_UNKNOWN_ERROR,         "unknown error")

/* ---- the link ------------------------------------------------------------------------------------ */

/*
 * What a transport says when a connect, a pairing or a link goes wrong.
 *
 * These reach the user as a toast, through take_error() - the transports' one user-facing
 * surface - so they are the same kind of string as the ones below and are held to the same
 * width. "%s" is usually a node, named by the last four hex digits of its address, which is
 * what the Meshtastic apps show and what is printed on the case: "6D:DA" beats a full MAC in a
 * line this short.
 *
 * "A" and "Devices" are the Brick's button and this client's own tab; keep them recognisable.
 */
MESH_STR_ENTRY(LINK_BT_STOPPED,           "Bluetooth stopped")
MESH_STR_ENTRY(LINK_BT_UNAVAILABLE,       "Bluetooth is unavailable")
MESH_STR_ENTRY(LINK_BT_NOT_READY,         "Bluetooth is not ready yet")
MESH_STR_ENTRY(LINK_NOT_IN_RANGE,         "%s is not in range")
MESH_STR_ENTRY(LINK_NEEDS_PAIRING,        "%s needs pairing; press A on it in Devices")
/* A node, then whichever of the failure words below fits - or the C library's own description
   of an errno, which arrives untranslated. */
MESH_STR_ENTRY(LINK_DETAIL,               "%s: %s")
MESH_STR_ENTRY(LINK_NO_ANSWER,            "%s did not answer; is it in range?")
MESH_STR_ENTRY(LINK_DISCOVERY_FAILED,     "%s: service discovery failed")
MESH_STR_ENTRY(LINK_NO_GATT,              "%s: no GATT services; try re-pairing")
MESH_STR_ENTRY(LINK_NOT_MESHTASTIC,       "%s is not a Meshtastic node")
MESH_STR_ENTRY(LINK_DROPPED,              "%s dropped the link; press A on it in Devices to pair")
MESH_STR_ENTRY(LINK_SUBSCRIBE_FAILED,     "%s: could not subscribe (%d)")
MESH_STR_ENTRY(LINK_PAIRING_START_FAILED, "%s: could not start pairing (%d)")
MESH_STR_ENTRY(LINK_PAIRING_TIMEOUT,      "%s: pairing timed out")
MESH_STR_ENTRY(LINK_FORGET_FAILED,        "%s: could not be forgotten (%d)")
/* The errnos bluez_client maps its D-Bus errors onto, in words. Each of these is the second
   half of LINK_DETAIL, so it reads as "6D:DA: is not in range". */
MESH_STR_ENTRY(LINK_FAIL_NEEDS_PAIRING,   "needs pairing (PIN mode)")
MESH_STR_ENTRY(LINK_FAIL_NO_ANSWER,       "did not answer; is it in range?")
MESH_STR_ENTRY(LINK_FAIL_BUSY,            "already connecting")
MESH_STR_ENTRY(LINK_FAIL_NOT_IN_RANGE,    "is not in range")
MESH_STR_ENTRY(LINK_FAIL_BT_NOT_READY,    "Bluetooth is not ready")
MESH_STR_ENTRY(LINK_FAIL_GENERIC,         "connect failed")
/* Pairing's own two, in the same place. "wrong PIN" is only said when the node rejected what
   was typed - a PIN nobody was there to type reads as LINK_NEEDS_PAIRING instead, so that this
   one never sends the user looking for a typo they did not make. */
MESH_STR_ENTRY(LINK_FAIL_WRONG_PIN,       "wrong PIN")
MESH_STR_ENTRY(LINK_FAIL_PAIRING,         "pairing failed")
/* USB. On the Brick a node has no serial driver until this client asks for one, so "no driver"
   is a state a working cable reaches and not necessarily a fault. */
MESH_STR_ENTRY(LINK_USB_DISABLED,         "USB serial is disabled")
MESH_STR_ENTRY(LINK_USB_GONE,             "USB port is gone; is it still plugged in?")
MESH_STR_ENTRY(LINK_USB_NO_DRIVER,        "%.20s: no USB serial driver (%d)")
MESH_STR_ENTRY(LINK_USB_OPEN_FAILED,      "Cannot open %.24s: %.20s")
MESH_STR_ENTRY(LINK_USB_NO_ANSWER,        "%.24s: the radio did not answer")

/* ---- the banner --------------------------------------------------------------------------------- */

/*
 * The persistent notice under the tab strip: something is true of the whole client and stays
 * true until it is resolved.
 *
 * Two slots per banner, and they are separate strings on purpose. The first says *what is
 * true* and the second says *what to do about it*, so a translator is never asked to fit both
 * into one line - the component draws them on two, and the second is dropped before the first
 * when a panel is too narrow to hold them.
 *
 * Neither carries the version number. It is drawn against the trailing edge of the first line,
 * untranslated, in the same category as a region code or a hardware model name (docs/i18n.md).
 */
MESH_STR_ENTRY(BANNER_UPDATE_READY,       "Update installed")
MESH_STR_ENTRY(BANNER_UPDATE_READY_HINT,  "Restart the client to run it")
MESH_STR_ENTRY(BANNER_UPDATE_AVAILABLE,   "Update available")
/* "Settings" names the tab and should read exactly as it does on MESH_STR_TAB_SETTINGS -
   somebody is being sent there. The section within it is not named: About is the first row of
   that tab, and a hint carrying the whole path would be a breadcrumb spelled into a sentence. */
MESH_STR_ENTRY(BANNER_UPDATE_AVAILABLE_HINT, "Install it from the Settings tab")

/* ---- toasts ------------------------------------------------------------------------------------ */

/*
 * The line that appears over the footer for a few seconds after a press.
 *
 * A toast is about sixty bytes and one line, and names are bounded with a precision - "%.20s" -
 * so a long node name cannot push the verb off the end. Keep those precisions when translating:
 * they are what stops the sentence being the part that gets cut.
 *
 * Every "(%d)" is an errno the press came back with. It is there because a toast that only says
 * something failed cannot be turned into a bug report.
 */
MESH_STR_ENTRY(TOAST_NOT_CONNECTED,       "Not connected to a node")
MESH_STR_ENTRY(TOAST_NODE_GONE,           "That node is no longer in the list")
MESH_STR_ENTRY(TOAST_BLE_UNAVAILABLE,     "BLE transport unavailable")
MESH_STR_ENTRY(TOAST_BUSY_RETRY,          "Busy; try again in a moment")
MESH_STR_ENTRY(TOAST_CONNECTING,          "Connecting to %.40s")
MESH_STR_ENTRY(TOAST_CONNECT_FAILED,      "Connect failed (%d)")
MESH_STR_ENTRY(TOAST_SENT_TO,             "Sent to %s")
/* A tapback went out. It names no destination because it does not choose one - it goes where
   the message it answers came from. */
MESH_STR_ENTRY(TOAST_REACTION_SENT,       "Reaction sent")
MESH_STR_ENTRY(TOAST_SEND_FAILED,         "Send failed (%d)")
/* A settings refresh, with the count of pending edits it is keeping. */
MESH_STR_PLURAL_ENTRY(TOAST_REFRESH_EDITS, "Refreshing %d sections; %u edit kept, Y saves", "Refreshing %d sections; %u edits kept, Y saves")
MESH_STR_ENTRY(TOAST_REFRESHING,          "Refreshing %d settings sections")
MESH_STR_ENTRY(TOAST_REFRESH_IN_PROGRESS, "Refresh already in progress")
MESH_STR_ENTRY(TOAST_REFRESH_FAILED,      "Refresh failed (%d)")
/* The radio actions, each saying what will happen next rather than that the press landed. */
MESH_STR_ENTRY(TOAST_REBOOTING,           "Rebooting; reconnecting shortly")
MESH_STR_ENTRY(TOAST_SHUTTING_DOWN,       "Shutting down; switch it on by hand")
MESH_STR_ENTRY(TOAST_NODEDB_RESET,        "Radio DB reset; Brick's list kept (forget it below)")
MESH_STR_ENTRY(TOAST_FACTORY_CONFIG,      "Factory reset sent; radio restarting")
MESH_STR_ENTRY(TOAST_FACTORY_DEVICE,      "Factory reset sent; forget it in Devices")
MESH_STR_ENTRY(TOAST_BACKED_UP,           "Backup sent to the radio's flash")
MESH_STR_ENTRY(TOAST_RESTORED,            "Restore sent; re-reading the settings")
MESH_STR_ENTRY(TOAST_BACKUP_REMOVED,      "Backup deleted from the radio's flash")
MESH_STR_ENTRY(TOAST_ALREADY_REQUESTED,   "Already requested")
MESH_STR_ENTRY(TOAST_REQUEST_FAILED,      "Request failed (%d)")
/* Asking a Store & Forward router for the traffic missed while this client was off. Two
   toasts because the press does two different things: with a router already known it asks
   it, and with none it has to find one first, which takes a moment longer. */
MESH_STR_ENTRY(TOAST_HISTORY_ASKED,       "Asked %.16s for the missed messages")
MESH_STR_ENTRY(TOAST_HISTORY_LOOKING,     "Looking for a Store & Forward router")
MESH_STR_ENTRY(TOAST_HISTORY_RUNNING,     "Already asking; the messages arrive as they come")
MESH_STR_ENTRY(TOAST_HISTORY_FAILED,      "Could not ask for the missed messages (%d)")
/* Dropping cached nodes. */
MESH_STR_PLURAL_ENTRY(TOAST_FORGOT_NODES, "Forgot %d node; pins kept", "Forgot %d nodes; pins kept")
MESH_STR_ENTRY(TOAST_NOTHING_CACHED,      "Nothing cached to forget")
MESH_STR_ENTRY(TOAST_ALL_ON_RADIO,        "Every cached node is on the radio")
MESH_STR_ENTRY(TOAST_FORGET_FAILED,       "Forget failed (%d)")
/* Pinning a node to the top of the list. */
/* Waypoints. "Shared" and "Deleted" say the mesh was told; "Saved" and "Forgot" say only this
   client was, which is what happens with no link up or on somebody else's locked place. */
MESH_STR_ENTRY(TOAST_WAYPOINT_SHARED,     "Shared %.30s")
MESH_STR_ENTRY(TOAST_WAYPOINT_SAVED,      "Saved %.30s here only")
MESH_STR_ENTRY(TOAST_WAYPOINT_DELETED,    "Deleted %.30s from the mesh")
MESH_STR_ENTRY(TOAST_WAYPOINT_FORGOT,     "Forgot %.30s here only")
MESH_STR_ENTRY(TOAST_WAYPOINT_NO_FIX,     "No position to put a waypoint at")
MESH_STR_ENTRY(TOAST_WAYPOINT_NAME_NEEDED, "Give the place a name first")
MESH_STR_ENTRY(TOAST_WAYPOINT_GONE,       "That place is no longer in the list")
MESH_STR_ENTRY(TOAST_WAYPOINT_FAILED,     "Waypoint failed (%d)")

MESH_STR_ENTRY(TOAST_PINNED,              "Pinned %.20s")
MESH_STR_ENTRY(TOAST_UNPINNED,            "Unpinned %.20s")
MESH_STR_ENTRY(TOAST_ALREADY_PINNED,      "%.20s is already pinned")
MESH_STR_ENTRY(TOAST_ALREADY_UNPINNED,    "%.20s is already unpinned")
MESH_STR_ENTRY(TOAST_PIN_FAILED,          "Pin failed (%d)")
/* Asking a node for something. */
MESH_STR_ENTRY(TOAST_ASKED_NAME,          "Asked %.20s to introduce itself")
MESH_STR_ENTRY(TOAST_ASKED_POSITION,      "Asked %.20s for its position")
MESH_STR_ENTRY(TOAST_ASKED_TELEMETRY,     "Asked %.20s for its telemetry")
MESH_STR_ENTRY(TOAST_STILL_SYNCING,       "Still syncing; try again in a moment")
MESH_STR_ENTRY(TOAST_CANNOT_ASK,          "Cannot ask this node")
/* Ignoring a node: the radio drops its packets before we ever see them. */
MESH_STR_ENTRY(TOAST_IGNORING,            "Dropping packets from %.20s")
MESH_STR_ENTRY(TOAST_UNIGNORING,          "Hearing %.20s again")
MESH_STR_ENTRY(TOAST_ALREADY_IGNORED,     "%.20s is already ignored")
MESH_STR_ENTRY(TOAST_ALREADY_UNIGNORED,   "%.20s is already not ignored")
MESH_STR_ENTRY(TOAST_CANNOT_IGNORE,       "Cannot ignore this node")
MESH_STR_ENTRY(TOAST_IGNORE_FAILED,       "Ignore failed (%d)")
/* Muting: we still hear it, it just stops raising alerts. */
MESH_STR_ENTRY(TOAST_MUTE_REQUESTED,      "Mute already requested")
MESH_STR_ENTRY(TOAST_MUTED,               "Muted %.20s")
MESH_STR_ENTRY(TOAST_UNMUTED,             "Unmuted %.20s")
MESH_STR_ENTRY(TOAST_MUTE_FAILED,         "Mute failed (%d)")
/* Removing a node from the radio's database. It comes back the moment it transmits again. */
MESH_STR_ENTRY(TOAST_REMOVED_NODE,        "Removed %.14s; back when it speaks")
MESH_STR_ENTRY(TOAST_REMOVE_SELF,         "That is the radio you are connected to")
MESH_STR_ENTRY(TOAST_REMOVE_FAILED,       "Remove failed (%d)")
MESH_STR_PLURAL_ENTRY(TOAST_DELETED_MESSAGES, "Deleted %u message from %.16s", "Deleted %u messages from %.16s")
MESH_STR_ENTRY(TOAST_NOTHING_TO_DELETE,   "Nothing to delete in %.20s")
MESH_STR_ENTRY(TOAST_TRACING,             "Tracing route to %.20s")
MESH_STR_ENTRY(TOAST_TRACE_RUNNING,       "A traceroute is already running")
MESH_STR_ENTRY(TOAST_CANNOT_TRACE,        "Cannot trace a route to this node")
MESH_STR_ENTRY(TOAST_TRACE_FAILED,        "Traceroute failed (%d)")
/* The link itself. */
MESH_STR_ENTRY(TOAST_DISCONNECTED_FROM,   "Disconnected from %.30s")
MESH_STR_ENTRY(TOAST_DISCONNECTED,        "Disconnected")
MESH_STR_ENTRY(TOAST_NOTHING_CONNECTED,   "Nothing is connected")
MESH_STR_ENTRY(TOAST_DISCONNECT_FAILED,   "Disconnect failed (%d)")
MESH_STR_ENTRY(TOAST_BLE_ONLY_PAIRING,    "Only Bluetooth nodes are paired")
MESH_STR_ENTRY(TOAST_FORGOT_DEVICE,       "Forgot %.30s; pair again to use it")
MESH_STR_ENTRY(TOAST_FORGET_DEVICE_FAILED,"Could not forget it (%d)")
MESH_STR_ENTRY(TOAST_PAIRING,             "Pairing...")
MESH_STR_ENTRY(TOAST_PAIRING_EXPIRED,     "The pairing request expired")
MESH_STR_ENTRY(TOAST_PAIRING_FAILED,      "Pairing failed (%d)")
MESH_STR_ENTRY(TOAST_PAIRING_CANCELLED,   "Pairing cancelled")
/* About. MESHCLIENT_THEME is an environment variable name and is not translated. */
MESH_STR_ENTRY(TOAST_UPDATE_CHANNEL,      "Update channel: %.*s")
MESH_STR_ENTRY(TOAST_THEME_HELD,          "MESHCLIENT_THEME is holding the theme")
MESH_STR_ENTRY(TOAST_THEME,               "Theme: %.*s")
MESH_STR_ENTRY(TOAST_DEV_UPDATES_ON,      "Dev updates on; check again")
MESH_STR_ENTRY(TOAST_DEV_UPDATES_OFF,     "Dev updates off")
MESH_STR_ENTRY(TOAST_CHECKING_UPDATES,    "Checking for updates")
MESH_STR_ENTRY(TOAST_UPDATES_UNAVAILABLE, "Updates are unavailable here")
MESH_STR_ENTRY(TOAST_ALREADY_CHECKING,    "Already checking")
MESH_STR_ENTRY(TOAST_UPDATE_CHECK_FAILED, "Update check failed (%d)")
MESH_STR_ENTRY(TOAST_DOWNLOADING,         "Downloading %.20s")
MESH_STR_ENTRY(TOAST_ALREADY_WORKING,     "Already working")
MESH_STR_ENTRY(TOAST_CHECK_FIRST,         "Check for an update first")
MESH_STR_ENTRY(TOAST_UPDATE_FAILED,       "Update failed (%d)")
/* Settings writes. "edits kept" matters: the user's typing survives the failure. */
MESH_STR_ENTRY(TOAST_COORDS_NOT_NUMBERS,  "Latitude, longitude and altitude must be numbers")
MESH_STR_ENTRY(TOAST_NEED_COORDS,         "Set a latitude and longitude first")
MESH_STR_ENTRY(TOAST_WORKING_ELLIPSIS,    "%s...")
MESH_STR_ENTRY(TOAST_CLEARING_FIXED_POS,  "Clearing fixed position")
MESH_STR_ENTRY(TOAST_PINNING_POSITION,    "Pinning position")
MESH_STR_ENTRY(TOAST_NOT_CONNECTED_KEPT,  "Not connected to a node; edits kept")
MESH_STR_ENTRY(TOAST_NOT_ON_EARTH,        "That is not a place on Earth")
MESH_STR_ENTRY(TOAST_FAILED_KEPT,         "Failed (%d); edits kept")
MESH_STR_ENTRY(TOAST_SAVING_SECTION,      "Saving %s...")
MESH_STR_ENTRY(TOAST_SECTION_NOT_LOADED,  "%s not loaded yet; X to refresh")
MESH_STR_ENTRY(TOAST_SECTION_READ_ONLY,   "%s is read-only for now")
MESH_STR_ENTRY(TOAST_INVALID_VALUE,       "Invalid value (PIN is 6 digits, key is hex)")
MESH_STR_ENTRY(TOAST_TOO_LONG_KEPT,       "Too long for the radio's list; edits kept")
MESH_STR_ENTRY(TOAST_SAVE_FAILED_KEPT,    "Save failed (%d); edits kept")
MESH_STR_ENTRY(TOAST_SAVE_SESSION_EXPIRED,"%s rejected: session expired, try again")
MESH_STR_ENTRY(TOAST_SAVE_BAD_VALUE,      "%s rejected by the radio (bad value)")
MESH_STR_ENTRY(TOAST_SAVE_NO_REPLY,       "No reply saving %s; X to check")
MESH_STR_ENTRY(TOAST_SAVE_REJECTED,       "%s rejected (error %d)")
MESH_STR_ENTRY(TOAST_SAVED_MAY_RESTART,   "%s saved; radio may restart")
MESH_STR_ENTRY(TOAST_RESTARTING_APPLY,    "Radio restarting to apply; reconnecting")
/* The names the save toasts above put in their %s. */
MESH_STR_ENTRY(SAVE_SECTION_FIXED_POS,    "Fixed position")
MESH_STR_ENTRY(SAVE_SECTION_POSITION,     "Position")
MESH_STR_ENTRY(SAVE_SECTION_CHANNEL,      "Channel %u")
/* Things that happen without a press behind them. */
MESH_STR_ENTRY(TOAST_NOT_DELIVERED,       "Not delivered to %.16s: %s")
MESH_STR_ENTRY(TOAST_RADIO_RESTARTED,     "Radio restarted; reloading its settings")
MESH_STR_ENTRY(TOAST_LINK_LOST,           "Radio link lost; reconnecting")
/* An alert message, which the firmware raises for something worth interrupting for. The text
   of the alert follows the colon. */
MESH_STR_ENTRY(TOAST_ALERT_FROM,          "Alert from %.16s: ")
MESH_STR_ENTRY(TOAST_NODES_OFF_RADIO,     "%u nodes now off radio; forget them in Settings")

/* ---- self-update -------------------------------------------------------------------------------- */

/* What the updater is doing, shown on the About screen when it has nothing more specific. */
MESH_STR_ENTRY(UPDATE_STATE_IDLE,         "idle")
MESH_STR_ENTRY(UPDATE_STATE_CHECKING,     "checking")
MESH_STR_ENTRY(UPDATE_STATE_UP_TO_DATE,   "up to date")
MESH_STR_ENTRY(UPDATE_STATE_AVAILABLE,    "available")
MESH_STR_ENTRY(UPDATE_STATE_DOWNLOADING,  "downloading")
MESH_STR_ENTRY(UPDATE_STATE_VERIFYING,    "verifying")
MESH_STR_ENTRY(UPDATE_STATE_READY,        "ready")
MESH_STR_ENTRY(UPDATE_STATE_FAILED,       "failed")
/* Which releases this build will offer. The automatic pair follows the running build: a
   prerelease build tracks prereleases, a release build tracks releases. */
MESH_STR_ENTRY(UPDATE_CHANNEL_STABLE,     "Stable")
MESH_STR_ENTRY(UPDATE_CHANNEL_PRERELEASE, "Prerelease")
MESH_STR_ENTRY(UPDATE_CHANNEL_AUTO_PRE,   "Automatic (prerelease)")
MESH_STR_ENTRY(UPDATE_CHANNEL_AUTO_STABLE,"Automatic (stable)")
/* Messages. "curl", "wget", "GitHub" and "pak" are names and stay as they are. */
MESH_STR_ENTRY(UPDATE_NO_FETCHER,         "No curl or wget on this device")
MESH_STR_ENTRY(UPDATE_DEV_DISABLED,       "Dev build; updates disabled")
MESH_STR_ENTRY(UPDATE_DEV_ENABLED,        "Dev build; updates enabled")
MESH_STR_ENTRY(UPDATE_CHANNEL_CHANGED,    "Channel changed; check again")
MESH_STR_ENTRY(UPDATE_SETTING_CHANGED,    "Setting changed; check again")
MESH_STR_ENTRY(UPDATE_START_FAILED,       "Could not start the downloader")
MESH_STR_ENTRY(UPDATE_CHECKING,           "Checking for updates")
MESH_STR_ENTRY(UPDATE_EMPTY_REPLY,        "Empty reply from GitHub")
MESH_STR_ENTRY(UPDATE_NO_ASSET,           "No usable release asset")
MESH_STR_ENTRY(UPDATE_LATEST_DEV,         "Latest is %s; dev build, not installing")
MESH_STR_ENTRY(UPDATE_LATEST_RUNNING,     "Running the latest release")
MESH_STR_ENTRY(UPDATE_NO_CHECKSUM,        "Release has no checksum; not installing")
MESH_STR_ENTRY(UPDATE_BAD_SIZE,           "Release asset size looks wrong")
/* The newer version, and the one this build is. */
MESH_STR_ENTRY(UPDATE_AVAILABLE,          "%s available (running %s)")
MESH_STR_ENTRY(UPDATE_DOWNLOAD_START_FAIL,"Could not start the download")
MESH_STR_ENTRY(UPDATE_DOWNLOADING,        "Downloading %s")
MESH_STR_ENTRY(UPDATE_RESPONSE_TOO_LARGE, "Response too large")
MESH_STR_ENTRY(UPDATE_READ_FAILED,        "Read from downloader failed")
MESH_STR_ENTRY(UPDATE_VERIFYING,          "Verifying download")
MESH_STR_ENTRY(UPDATE_FILE_MISSING,       "Downloaded file is missing")
MESH_STR_ENTRY(UPDATE_FILE_WRONG_SIZE,    "Downloaded file is the wrong size")
MESH_STR_ENTRY(UPDATE_HASH_FAILED,        "Could not hash the download")
MESH_STR_ENTRY(UPDATE_CHECKSUM_MISMATCH,  "Checksum mismatch; discarded")
MESH_STR_ENTRY(UPDATE_CHMOD_FAILED,       "Could not make the update executable")
/* The %s is the C library's own description of an errno and arrives untranslated. */
MESH_STR_ENTRY(UPDATE_INSTALL_FAILED,     "Install failed: %s")
MESH_STR_ENTRY(UPDATE_INSTALLED,          "%s installed - relaunch to run it")
MESH_STR_ENTRY(UPDATE_TIMED_OUT,          "Timed out talking to GitHub")
/* The TLS failures are worth telling apart: one is a bad certificate, the other is a pak
   installed without its CA bundle, and only the second is fixed by reinstalling. */
MESH_STR_ENTRY(UPDATE_TLS_UNVERIFIED,     "Could not verify GitHub's certificate")
MESH_STR_ENTRY(UPDATE_NO_CA_BUNDLE,       "No CA certificates; reinstall the pak")
MESH_STR_ENTRY(UPDATE_CHECK_EXIT,         "Check failed (%s exit %d)")
MESH_STR_ENTRY(UPDATE_DOWNLOAD_EXIT,      "Download failed (%s exit %d)")

/* ---- language ------------------------------------------------------------------------------------ */

/*
 * The Settings > About row naming the language in force.
 *
 * Only the label is here. The *name* of a language comes from `name` on struct
 * mesh_i18n_locale, which every locale must fill in with its own name for itself - "Deutsch",
 * not "German". It is deliberately not a catalog entry: a catalog entry may be left
 * untranslated, and a locale whose name fell back to English would have About reporting the
 * wrong language.
 */
MESH_STR_ENTRY(ABOUT_LANGUAGE,            "Language")

