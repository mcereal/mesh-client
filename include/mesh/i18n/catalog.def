MESH_STR_ENTRY(VALUE_IPV4,                "%u.%u.%u.%u")

/* Radio actions: the things the radio does rather than keeps. */
MESH_STR_ENTRY(ACTION_REBOOT,             "Reboot")
MESH_STR_ENTRY(ACTION_SHUTDOWN,           "Shutdown")
MESH_STR_ENTRY(ACTION_SHUTDOWN_UNSUPPORTED, "not supported")
