/* ---- settings: formatted values ---------------------------------------------------------------- */

/* Durations, as a settings row writes them: whole hours, whole minutes, else seconds. */
MESH_STR_ENTRY(VALUE_HOURS,               "%uh")
MESH_STR_ENTRY(VALUE_MINUTES,             "%um")
MESH_STR_ENTRY(VALUE_SECONDS,             "%us")
MESH_STR_ENTRY(VALUE_MILLISECONDS,        "%ums")
/* A NUMBER row whose 0 means nothing in particular - a plain zero rather than "off". */
MESH_STR_ENTRY(VALUE_ZERO,                "0")
/*
 * What 0 means on the NUMBER rows that have a word for it, from field_spec.zero_label. They
 * read the same as the common words above and are separate ids on purpose: "off" answering
 * "how often?" and "off" answering "is it on?" are one word in English and two most other
 * places, and only an id apiece lets a translator tell them apart.
 */
MESH_STR_ENTRY(ZERO_OFF,                  "off")
MESH_STR_ENTRY(ZERO_DEFAULT,              "default")
MESH_STR_ENTRY(ZERO_NONE,                 "none")
MESH_STR_ENTRY(ZERO_NEVER,                "never")
MESH_STR_ENTRY(ZERO_ONCE,                 "once")
MESH_STR_ENTRY(VALUE_PLAIN,               "%u")
/* Position precision, which is a bit count on the wire and a distance to a reader. */
MESH_STR_ENTRY(VALUE_PRECISION_OFF,       "off")
MESH_STR_ENTRY(VALUE_PRECISION_EXACT,     "precise")
MESH_STR_ENTRY(VALUE_PRECISION_BITS,      "%u bits")
MESH_STR_ENTRY(VALUE_KILOMETRES,          "%u km")
MESH_STR_ENTRY(VALUE_METRES,              "%u m")
/* LoRa. The two fractional bandwidths are spelled out because "%u kHz" would round them. */
MESH_STR_ENTRY(VALUE_BANDWIDTH_31,        "31.25 kHz")
MESH_STR_ENTRY(VALUE_BANDWIDTH_62,        "62.5 kHz")
MESH_STR_ENTRY(VALUE_BANDWIDTH_KHZ,       "%u kHz")
/* A coding rate is written as the fraction 4/n. */
MESH_STR_ENTRY(VALUE_CODING_RATE,         "4/%u")
/* Transmit power: 0 means "whatever the region allows", not zero power. */
MESH_STR_ENTRY(VALUE_TX_POWER_MAX,        "max")
MESH_STR_ENTRY(VALUE_DBM,                 "%d dBm")
MESH_STR_ENTRY(VALUE_MILLIAMPS,           "%u mA")
/* A GPIO pin, or none chosen. */
MESH_STR_ENTRY(VALUE_PIN_UNSET,           "unset")
MESH_STR_ENTRY(VALUE_PIN,                 "GPIO %u")
/* Distances offered for position precision, from the coarsest upward. */
MESH_STR_ENTRY(VALUE_PRECISION_23KM,      "~23 km")
MESH_STR_ENTRY(VALUE_PRECISION_12KM,      "~12 km")
MESH_STR_ENTRY(VALUE_PRECISION_6KM,       "~6 km")
MESH_STR_ENTRY(VALUE_PRECISION_3KM,       "~3 km")
MESH_STR_ENTRY(VALUE_PRECISION_1_5KM,     "~1.5 km")
MESH_STR_ENTRY(VALUE_PRECISION_730M,      "~730 m")
MESH_STR_ENTRY(VALUE_PRECISION_360M,      "~360 m")
MESH_STR_ENTRY(VALUE_PRECISION_180M,      "~180 m")
MESH_STR_ENTRY(VALUE_PRECISION_90M,       "~90 m")
MESH_STR_ENTRY(VALUE_PRECISION_45M,       "~45 m")

/* ---- settings: rows and their values ------------------------------------------------------------ */

/* A TEXT row with nothing in it, and one holding a credential. The mask is a fixed length so
   it does not give away how long the secret is. */
MESH_STR_ENTRY(SETTINGS_TEXT_EMPTY,       "-")
MESH_STR_ENTRY(SETTINGS_TEXT_SECRET,      "********")
/* Encryption keys. The first four bytes are shown as a fingerprint - enough to check against
   the phone app, not enough to be read over a shoulder. */
MESH_STR_ENTRY(SETTINGS_KEY_NONE,         "none")
MESH_STR_ENTRY(SETTINGS_KEY_NO_ENCRYPTION,"no encryption")
MESH_STR_ENTRY(SETTINGS_KEY_DEFAULT,      "default key")
MESH_STR_ENTRY(SETTINGS_KEY_SIMPLE,       "simple key %u")
MESH_STR_ENTRY(SETTINGS_KEY_AES,          "%.8s... (AES-%u)")
MESH_STR_ENTRY(SETTINGS_KEY_BITS,         "%.8s... (%u-bit)")
MESH_STR_ENTRY(SETTINGS_KEY_FINGERPRINT,  "%s... (%u bytes)")
MESH_STR_ENTRY(SETTINGS_KEY_INVALID,      "invalid key")
/* What a KEY row will do when the section is saved. */
MESH_STR_ENTRY(SETTINGS_KEY_NEW_AES128,   "new random AES-128")
MESH_STR_ENTRY(SETTINGS_KEY_NEW_AES256,   "new random AES-256")
MESH_STR_ENTRY(SETTINGS_KEY_NEW_KEY,      "new random key")
MESH_STR_ENTRY(SETTINGS_KEY_CLEAR,        "none (clear)")
/* A section the radio has not sent yet, and a row that needs a link it has not got. */
MESH_STR_ENTRY(SETTINGS_NOT_LOADED,       "not loaded")
MESH_STR_ENTRY(SETTINGS_NOT_CONNECTED,    "not connected")
MESH_STR_ENTRY(SETTINGS_EMPTY_DISCONNECT, "Connect to a radio to read its settings")
MESH_STR_ENTRY(SETTINGS_EMPTY_SECTION,    "Not sent by the radio yet; X to refresh")
/* Titles down the Settings tree. Each is one level's *name* and nothing else: the breadcrumb
   used to be "Settings > %s%s%s", which handed a translator the trail's grammar along with its
   words and glued a badge on with a %s. The app bar stacks the levels itself and draws the
   separators as icons, so what is left here is a word per level and a count per badge. */
MESH_STR_ENTRY(SETTINGS_TITLE,            "Settings")
MESH_STR_ENTRY(SETTINGS_TITLE_CHANNEL,    "Channel %u")
MESH_STR_ENTRY(SETTINGS_UNSAVED,          "%u unsaved")

