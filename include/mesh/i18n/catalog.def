/*
 * The catalog: every string the user reads, one line each.
 *
 * This file is included more than once, with the two macros defined differently each time -
 * once to build `enum mesh_str_id`, once to build the English table, once by
 * scripts/gen-locale.py to build a translation template. That is why it has no include guard
 * and why it is not a .h: `make format` would reflow the table into something no translator
 * could scan, and there is nothing here for clang-format to be right about.
 *
 *   MESH_STR_ENTRY(ID, "text")
 *   MESH_STR_PLURAL_ENTRY(ID, "one", "other")   -> MESH_STR_ID_ONE and MESH_STR_ID_OTHER
 *
 * Rules for a good entry:
 *
 *   - One whole sentence or label per id, %-specifiers included. "Sent to %s" is one string.
 *     Never build a sentence by concatenating catalog entries: the word order is the
 *     translator's to change, and a caller that glues two halves together has taken that away.
 *   - The id says where it is read, not what it says: TOAST_SEND_FAILED, not SEND_FAILED_TEXT.
 *     An id is forever; the English behind it is not.
 *   - A word that reads the same in two places still gets two ids when it is doing two jobs.
 *     "Off" under Bluetooth and "off" as a duration are one word in English and two in most
 *     other languages, and an id per job is what lets a translator tell them apart.
 *   - Keep the specifiers, their order and their types identical across locales.
 *     mesh_i18n_validate() enforces it; see docs/i18n.md.
 *
 * Comments here are addressed to translators as much as to the next maintainer. A string with
 * no context is a string that gets translated wrong.
 */

/* ---- common words ------------------------------------------------------------------------- */

/*
 * Id 0, and deliberately empty.
 *
 * A table field that names a string - field_spec's zero_label, say - has to be able to say
 * "nothing here", and a zero-initialised field is what a designated initialiser leaves behind.
 * Keeping the empty string at 0 means that reads as nothing rather than as whichever entry
 * happened to be written first.
 */
MESH_STR_ENTRY(NONE,                      "")

/* The stand-in for a value the client cannot name: an enum the radio sent that this build
   does not know, a timestamp in the future. Short on purpose - it shares a row with real
   values and must not widen it. */
MESH_STR_ENTRY(COMMON_UNKNOWN_SHORT,      "?")
MESH_STR_ENTRY(COMMON_UNKNOWN,            "unknown")
MESH_STR_ENTRY(COMMON_NONE,               "none")
MESH_STR_ENTRY(COMMON_ON,                 "on")
MESH_STR_ENTRY(COMMON_OFF,                "off")
MESH_STR_ENTRY(COMMON_YES,                "yes")
MESH_STR_ENTRY(COMMON_NO,                 "no")
/* A setting left at whatever the radio firmware chooses, rather than a number we picked. */
MESH_STR_ENTRY(COMMON_DEFAULT,            "default")
MESH_STR_ENTRY(COMMON_CANCEL,             "Cancel")
/* A row that offers an action and is waiting to be pressed. "A" is the button's own printed
   label and stays as it is. */
MESH_STR_ENTRY(COMMON_PRESS_A,            "press A")

/* ---- durations and relative times --------------------------------------------------------- */

/* Compact ages, drawn in the corner of a list row where there is room for about six cells.
   The letters are unit abbreviations: seconds, minutes, hours, days. */
MESH_STR_ENTRY(TIME_NOW,                  "now")
MESH_STR_ENTRY(TIME_SECONDS_SHORT,        "%us")
MESH_STR_ENTRY(TIME_MINUTES_SHORT,        "%um")
MESH_STR_ENTRY(TIME_HOURS_SHORT,          "%uh")
MESH_STR_ENTRY(TIME_DAYS_SHORT,           "%ud")
/* Two-part durations, for an uptime or a gap that deserves more than one unit. */
MESH_STR_ENTRY(TIME_DAYS_HOURS,           "%ud %uh")
MESH_STR_ENTRY(TIME_HOURS_MINUTES,        "%uh %um")
/* "how long ago", spelled out; these sit in a value column with room to breathe. */
MESH_STR_ENTRY(TIME_AGO_SECONDS,          "%us ago")
MESH_STR_ENTRY(TIME_AGO_MINUTES,          "%um ago")
MESH_STR_ENTRY(TIME_AGO_HOURS,            "%uh ago")
MESH_STR_ENTRY(TIME_AGO_DAYS,             "%ud ago")
/* Date separators above a run of messages. TODAY and YESTERDAY replace the date entirely;
   DATE is "<weekday> <day of month> <month>", and the three arguments are in that order, so a
   language that writes the month first reorders the specifiers rather than the code. */
MESH_STR_ENTRY(DATE_TODAY,                "Today")
MESH_STR_ENTRY(DATE_YESTERDAY,            "Yesterday")
MESH_STR_ENTRY(DATE_WEEKDAY_DAY_MONTH,    "%s %d %s")

/* ---- tabs --------------------------------------------------------------------------------- */

MESH_STR_ENTRY(TAB_MESSAGES,              "Messages")
MESH_STR_ENTRY(TAB_NODES,                 "Nodes")
MESH_STR_ENTRY(TAB_WAYPOINTS,             "Waypoints")
MESH_STR_ENTRY(TAB_DEVICES,               "Devices")
MESH_STR_ENTRY(TAB_STATUS,                "Status")
MESH_STR_ENTRY(TAB_SETTINGS,              "Settings")

/* ---- the action bar ------------------------------------------------------------------------ */

/*
 * What the buttons do here, one verb per button.
 *
 * These used to be whole sentences - "A open node  X pin  Y write  L/R tabs" - because the
 * footer drew one line of text. It draws an action bar now (fb_draw_action_bar), which is a
 * keycap and a label per action, so a sentence has nothing for it to iterate: it would either
 * draw the whole thing on every key or go looking for the button letters inside a translation,
 * and reading a translation back is the one thing this layer exists to prevent.
 *
 * So an action is a *pair* - a button, and one of the ids below - and src/ui/actions.c is where
 * a screen's set of them is decided. A, B, X, Y and START are printed on the Brick's case and
 * are not text; only the verb after each is.
 *
 * Keep them to a word or two. The bar drops actions from the end when they do not fit, so a
 * long verb does not wrap - it costs whichever action was written last its place on screen.
 */
MESH_STR_ENTRY(ACTION_SELECT,             "select")
MESH_STR_ENTRY(ACTION_BACK,               "back")
MESH_STR_ENTRY(ACTION_OPEN,               "open")
/* Move to the next tab along - what the shoulder buttons do on every screen. */
MESH_STR_ENTRY(ACTION_TABS,               "tabs")
MESH_STR_ENTRY(ACTION_QUIT,               "quit")
/* Take the highlighted row as the answer, on a screen that exists to ask one. */
MESH_STR_ENTRY(ACTION_CHOOSE,             "choose")
MESH_STR_ENTRY(ACTION_CONFIRM,            "confirm")
MESH_STR_ENTRY(ACTION_CANCEL,             "cancel")
/* The d-pad, on the two screens where moving the cursor is the whole interaction. */
MESH_STR_ENTRY(ACTION_MOVE,               "move")
/* What SELECT does: open the explanation of the screen the user is on (docs/help.md). */
MESH_STR_ENTRY(ACTION_HELP,               "help")
/* The d-pad on the help screen, where there is nothing to choose - the rows are paragraphs, so
   the cursor moves the text rather than a selection. A different verb from "move" on purpose. */
MESH_STR_ENTRY(ACTION_SCROLL,             "scroll")
/* The shoulder buttons inside a long picker: ten rows at a time rather than one. */
MESH_STR_ENTRY(ACTION_JUMP,               "jump 10")
/* Put the highlighted character into the draft - what A does on the on-screen keyboard. */
MESH_STR_ENTRY(ACTION_TYPE,               "type")
MESH_STR_ENTRY(ACTION_PAIR,               "pair")
MESH_STR_ENTRY(ACTION_DELETE,             "delete")
/* The keyboard's own three: the case layer, a space, and "I have finished typing". */
MESH_STR_ENTRY(ACTION_SHIFT,              "shift")
MESH_STR_ENTRY(ACTION_SPACE,              "space")
MESH_STR_ENTRY(ACTION_DONE,               "done")
MESH_STR_ENTRY(ACTION_SEND,               "send")
/* Answer with one of the canned messages, rather than opening the keyboard to write one. */
MESH_STR_ENTRY(ACTION_REPLY,              "reply")
/* Open the keyboard to compose a message to whoever the cursor is on. */
MESH_STR_ENTRY(ACTION_WRITE,              "write")
/* Put an emoji on the message under the cursor - a tapback, not a message of its own. Every
   messenger has a word for this one and it is rarely "react"; use the one yours uses. */
MESH_STR_ENTRY(ACTION_REACT,              "react")
/* Start a conversation with somebody there is no thread for yet. */
MESH_STR_ENTRY(ACTION_NEW,                "new")
/* Keep this node at the top of the list. The star beside a pinned row is the same fact. */
MESH_STR_ENTRY(ACTION_PIN,                "pin")
/* Broadcast a place to the channel again - the Waypoints tab's verb, and not the same word as
   "send": a waypoint already exists and goes out unchanged, where a message is written once. */
MESH_STR_ENTRY(ACTION_SHARE,              "share")
MESH_STR_ENTRY(ACTION_CONNECT,            "connect")
MESH_STR_ENTRY(ACTION_DISCONNECT,         "disconnect")
/* Drop a radio from the list of ones we know how to reach. */
MESH_STR_ENTRY(ACTION_FORGET,             "forget")
/* Ask the radio for this section again, rather than showing what it last said. */
MESH_STR_ENTRY(ACTION_REFRESH,            "refresh")
/* Write the pending edits to the radio; throw them away. */
MESH_STR_ENTRY(ACTION_SAVE,               "save")
MESH_STR_ENTRY(ACTION_DISCARD,            "discard")
/* Change the value on the highlighted row in place, with Left and Right. */
MESH_STR_ENTRY(ACTION_EDIT,               "edit")
/* Carry out the highlighted row, on the screen whose rows are verbs rather than settings. */
MESH_STR_ENTRY(ACTION_RUN,                "run")
/* Drop a node from the roster we keep after the radio has forgotten it. */
MESH_STR_ENTRY(ACTION_REMOVE,             "remove")

/*
 * The second press, on the four actions that ask for one.
 *
 * A destructive action is armed by its first press and carried out by its second, and while it
 * is armed the bar says so: the button that would go through with it stops offering "delete"
 * and starts offering "confirm delete". The word is longer on purpose - an armed bar should not
 * look like the resting one.
 */
MESH_STR_ENTRY(ACTION_CONFIRM_DELETE,     "confirm delete")
MESH_STR_ENTRY(ACTION_CONFIRM_REMOVE,     "confirm remove")
MESH_STR_ENTRY(ACTION_CONFIRM_FORGET,     "confirm forget")
MESH_STR_ENTRY(ACTION_CONFIRM_DISCARD,    "confirm discard")

/* ---- how to leave -------------------------------------------------------------------------- */

/*
 * Shown beside the transport state while nothing is connected, as a sentence rather than as an
 * action, because that line is prose and not a bar. MENU is the Brick's own button; the second
 * form is what MESHCLIENT_QUIT_KEYS leaves us able to say when somebody has rebound quitting to
 * a key whose name we do not know.
 */
MESH_STR_ENTRY(HINT_QUIT_MENU,            "Press MENU to quit")
MESH_STR_ENTRY(HINT_QUIT_KEY_CODE,        "Quit: key code %u")

/* ---- the header ---------------------------------------------------------------------------- */

/* The transport has not said anything yet: the very first frame after launch. */
MESH_STR_ENTRY(HEADER_TRANSPORT_STARTING, "starting")
/* "<transport state>: <node we are talking to>" along the top. */
MESH_STR_ENTRY(HEADER_STATUS_CONNECTED,   "%s: %s")
/* "<transport state> | <how to quit>", when nothing is connected. */
MESH_STR_ENTRY(HEADER_STATUS_QUIT,        "%s | %s")

/* ---- the Messages tab ---------------------------------------------------------------------- */

MESH_STR_ENTRY(MESSAGES_EMPTY,            "Connect to a node to see conversations.")
/* The placeholder row at the top of the conversation list, which opens a new message. */
MESH_STR_ENTRY(MESSAGES_NEW,              "New message")
MESH_STR_ENTRY(MESSAGES_NEW_PREVIEW,      "Pick a channel or a node")
/* The pseudo-conversation carrying every channel at once. */
MESH_STR_ENTRY(MESSAGES_ALL_TRAFFIC,      "All traffic")
/* A channel's name on a row, which is its own name behind a '#'. Slot 0 with no name is the
   default primary channel - the firmware shows the modem preset there, which this client does
   not track - and a later unnamed slot is shown by its number. */
MESH_STR_ENTRY(CHANNEL_PRIMARY,           "#Primary")
MESH_STR_ENTRY(CHANNEL_NUMBERED,          "#Ch%u")
MESH_STR_ENTRY(MESSAGES_NO_MESSAGES_YET,  "no messages yet")
/* Shown over a conversation row that is one more X press from being deleted. */
MESH_STR_ENTRY(MESSAGES_DELETE_ARMED,     "X again to delete")
/* The unread badge, once the count stops being worth reading exactly. */
MESH_STR_ENTRY(MESSAGES_UNREAD_OVERFLOW,  "99+")
/* A thread with nothing in it. The first is the shared inbox, the second one conversation. */
MESH_STR_ENTRY(THREAD_EMPTY_INBOX,        "No messages yet. B goes back to the list.")
MESH_STR_ENTRY(THREAD_EMPTY,              "Nothing here yet. Y writes one, B goes back.")
/* A thread's title: the conversation, then whether it is a channel or one node, then how many
   older messages have been dropped from the ring. */
MESH_STR_ENTRY(THREAD_TITLE,              "%s  %s")
MESH_STR_ENTRY(THREAD_TITLE_OLDER,        "%s  %s  (+%u older)")
MESH_STR_ENTRY(THREAD_KIND_CHANNEL,       "channel")
MESH_STR_ENTRY(THREAD_KIND_DIRECT,        "direct")

/* A message bubble's own header line. SENT is what one of ours says instead of a name. */
MESH_STR_ENTRY(BUBBLE_SENT,               "sent")
MESH_STR_ENTRY(BUBBLE_SENT_TO,            "to %s")
/* The tag after the name saying where the message came in: a channel by number, a direct
   message, an alert, or a sensor. The leading spaces separate it from the name. */
MESH_STR_ENTRY(BUBBLE_CHANNEL,            "  #%u")
MESH_STR_ENTRY(BUBBLE_DIRECT,             "  dm")
MESH_STR_ENTRY(BUBBLE_ALERT,              "  \U0001F6A8 alert")
MESH_STR_ENTRY(BUBBLE_SENSOR,             "  sensor")
/* What became of a message we sent, in words.
 *
 * The bubble draws a mark rather than any of these - a clock, a double tick, an alert circle,
 * from src/ui/delivery.c - because "ok", ".." and "!!" were two cells of punctuation standing
 * for a state, unreadable until learnt and a translator's problem the moment they were words.
 * The words stay because the mark has to be nameable: a text backend has no sprites, and a test
 * that asserted on a sprite would be asserting on a picture. */
MESH_STR_ENTRY(DELIVERY_SENDING,          "sending")
MESH_STR_ENTRY(DELIVERY_DELIVERED,        "delivered")
MESH_STR_ENTRY(DELIVERY_FAILED,           "failed")

/* ---- the Waypoints tab -----------------------------------------------------------------------
 *
 * A waypoint is a named place somebody broadcast to a channel. This tab lists them with how far
 * away and which way they lie from our own radio's fix, which is what a handheld can say about
 * a point when it has no map to draw it on.
 */

MESH_STR_ENTRY(WAYPOINTS_EMPTY,           "No places have been shared yet.")
MESH_STR_ENTRY(WAYPOINTS_EMPTY_DISCONNECTED, "Connect to a node to see shared places.")
MESH_STR_ENTRY(WAYPOINTS_GONE,            "That place is no longer in the list.")
/* The last row of the list: share our own radio's position as a new place. */
MESH_STR_ENTRY(WAYPOINTS_NEW,             "New waypoint here")
/* ...and what that row says instead of a coordinate when our radio has no position to offer.
   The row stays and says why: one that disappeared would leave nothing to explain itself. */
MESH_STR_ENTRY(WAYPOINTS_NEW_NEEDS_FIX,   "no position yet")
MESH_STR_ENTRY(WAYPOINTS_TITLE_COUNT,     "Waypoints (%u)")
/* A waypoint whose sender left the name empty, which the wire allows. */
MESH_STR_ENTRY(WAYPOINTS_UNNAMED,         "Unnamed place")
/* The list row's second line: who shared it, and how long ago we heard it. */
MESH_STR_ENTRY(WAYPOINTS_ROW_SHARED,      "%s, %s")
/* How a waypoint of our own names its sharer, wherever a node name would go. */
MESH_STR_ENTRY(WAYPOINTS_BY_YOU,          "you")

MESH_STR_ENTRY(WAYPOINT_HEAD_PLACE,       "Place")
MESH_STR_ENTRY(WAYPOINT_HEAD_NOTE,        "Note")
MESH_STR_ENTRY(WAYPOINT_HEAD_SHARED,      "Shared")
MESH_STR_ENTRY(WAYPOINT_HEAD_ACTIONS,     "Actions")

/* How far away it is and which way, from our own fix. */
MESH_STR_ENTRY(WAYPOINT_RANGE,            "Range")
/* The two reasons there is no range to give. They are different facts: one is about this
   waypoint, the other about our own radio, and a row that said "unknown" for both would hide
   which of the two the user can do something about. */
MESH_STR_ENTRY(WAYPOINT_RANGE_NO_FIX,     "no fix of our own")
MESH_STR_ENTRY(WAYPOINT_RANGE_NO_COORDS,  "no coordinates")
/* A distance and a compass point, in that order. */
MESH_STR_ENTRY(WAYPOINT_VAL_RANGE,        "%s %s")
MESH_STR_ENTRY(WAYPOINT_LATITUDE,         "Latitude")
MESH_STR_ENTRY(WAYPOINT_LONGITUDE,        "Longitude")
MESH_STR_ENTRY(WAYPOINT_SHARED_BY,        "Shared by")
MESH_STR_ENTRY(WAYPOINT_CHANNEL,          "Channel")
MESH_STR_ENTRY(WAYPOINT_HEARD,            "Heard")
MESH_STR_ENTRY(WAYPOINT_EXPIRES,          "Expires")
/* The default every app sends: a place that stands until somebody withdraws it. */
MESH_STR_ENTRY(WAYPOINT_EXPIRES_NEVER,    "never")
/* How long a place with an expiry has left. A clock we do not have leaves the row unsaid
   rather than counting down from a date we cannot read. */
MESH_STR_ENTRY(WAYPOINT_EXPIRES_IN,       "in %s")
/* Whether anybody on the mesh may change it, or only the one node it names. */
MESH_STR_ENTRY(WAYPOINT_LOCKED_TO,        "Locked to")
MESH_STR_ENTRY(WAYPOINT_LOCKED_OPEN,      "anyone")

MESH_STR_ENTRY(WAYPOINT_ACT_SHARE,        "Share it again")
/* Two deletes, because they are two different acts. The first withdraws the place from the
   whole mesh; the second only stops this client showing it, because the waypoint is locked to
   somebody else and withdrawing it is not ours to do. */
MESH_STR_ENTRY(WAYPOINT_ACT_DELETE,       "Delete from the mesh")
MESH_STR_ENTRY(WAYPOINT_ACT_FORGET,       "Forget it here")
MESH_STR_ENTRY(WAYPOINT_ACT_DELETE_ARMED, "A again to delete")

/* The compass, at eight points. Short because they share a row with a name, a distance and an
   age - and translated, because the letters are the initials of words: north is N in English
   and Spanish, west is W and O. */
MESH_STR_ENTRY(COMPASS_N,                 "N")
MESH_STR_ENTRY(COMPASS_NE,                "NE")
MESH_STR_ENTRY(COMPASS_E,                 "E")
MESH_STR_ENTRY(COMPASS_SE,                "SE")
MESH_STR_ENTRY(COMPASS_S,                 "S")
MESH_STR_ENTRY(COMPASS_SW,                "SW")
MESH_STR_ENTRY(COMPASS_W,                 "W")
MESH_STR_ENTRY(COMPASS_NW,                "NW")

/* Distances, in whichever units the radio's display is set to. Under a kilometre or a mile the
   figure is whole - a metre of precision on a mesh position is already more than the sender
   knows - and above it there is one decimal, because 1 km and 2 km with nothing between them
   is a scale nobody can walk by. */
MESH_STR_ENTRY(VALUE_DISTANCE_M,          "%u m")
MESH_STR_ENTRY(VALUE_DISTANCE_KM,         "%.1f km")
MESH_STR_ENTRY(VALUE_DISTANCE_FT,         "%u ft")
MESH_STR_ENTRY(VALUE_DISTANCE_MI,         "%.1f mi")

/* ---- the Nodes tab -------------------------------------------------------------------------- */

MESH_STR_ENTRY(NODES_EMPTY_WAITING,       "Waiting for the node list...")
MESH_STR_ENTRY(NODES_EMPTY_DISCONNECTED,  "Connect to a node to see the mesh.")
MESH_STR_ENTRY(NODES_GONE,                "That node is no longer in the list.")
MESH_STR_ENTRY(NODES_DETAIL_EMPTY,        "Nothing reported for this node yet.")
/* Titles: how many of the radio's NodeDB we hold, or how many we keep that it has evicted. */
MESH_STR_ENTRY(NODES_TITLE_OF,            "Nodes (%u of %u)")
MESH_STR_ENTRY(NODES_TITLE_OFF_RADIO,     "Nodes (%u, %u off radio)")
/* Who a broadcast went to, where a direct message would name one node. It is a peer name, so
   it lands wherever a name does - the bubble header reads "to all". */
MESH_STR_ENTRY(PEER_EVERYONE,             "all")
/* A node with no NodeInfo yet has no short name; four dashes hold the column open. */
MESH_STR_ENTRY(NODES_NO_SHORT_NAME,       "----")
/* The right-hand column of a node row: how it was heard, then its age. */
MESH_STR_ENTRY(NODES_ROW_OFF_RADIO,       "off radio %s")
MESH_STR_ENTRY(NODES_ROW_HOPS,            "%uhop %s")
MESH_STR_ENTRY(NODES_ROW_MQTT,            "mqtt %s")
MESH_STR_ENTRY(NODES_ROW_SNR,             "%.1fdB %s")

/* ---- compose, the picker and the keyboard --------------------------------------------------- */

/* A list title with its row count: "Nodes (12)", and "(+3 older)" when the ring has dropped
   messages the count cannot show. */
MESH_STR_ENTRY(LIST_TITLE_COUNT,          "%s (%u)")
MESH_STR_ENTRY(LIST_TITLE_COUNT_OLDER,    "%s (%u, +%u older)")

/* Who a message is being written to, and whether that is a channel or one node. */
MESH_STR_ENTRY(COMPOSE_TO,                "To: %s")
MESH_STR_ENTRY(COMPOSE_TO_KIND,           "To: %s%s")
MESH_STR_ENTRY(COMPOSE_SUFFIX_CHANNEL,    "  (channel)")
MESH_STR_ENTRY(COMPOSE_SUFFIX_DIRECT,     "  (direct)")
MESH_STR_ENTRY(COMPOSE_DRAFT,             "Draft: %s")
MESH_STR_ENTRY(COMPOSE_DRAFT_EMPTY,       "[ Type a message ]")
/* The badge on the compose sheet and the keyboard when what is being written answers one
   message rather than the conversation. One word - it is a capsule, not a sentence. */
MESH_STR_ENTRY(COMPOSE_BADGE_REPLY,       "reply")
/* The tapback picker's heading: %s is the message being reacted to, elided to fit. */
MESH_STR_ENTRY(REACT_TO,                  "React to: %s")
MESH_STR_ENTRY(PICKER_TITLE,              "Send to")
MESH_STR_ENTRY(PICKER_EMPTY,              "No channels or nodes known yet.")

/* The pairing prompt. The PIN is on the *node's* screen, not this one, which is the whole
   reason the title names the node. NODE_FALLBACK stands in when the node has no name yet. */
MESH_STR_ENTRY(PAIRING_CONFIRM,           "Does %s show this?")
MESH_STR_ENTRY(PAIRING_SHOWN_ON,          "PIN shown on %s")
MESH_STR_ENTRY(PAIRING_NODE_FALLBACK,     "the node")

/* Keyboard keys. The three letter rows are the layout itself and are not translated here;
   these are the named keys along the bottom. SHIFT_* are what the shift key shows for the
   layer it would switch *to*. */
MESH_STR_ENTRY(KEY_LAYER_UPPER,           "ABC")
MESH_STR_ENTRY(KEY_LAYER_SYMBOLS,         "#+=")
MESH_STR_ENTRY(KEY_LAYER_LOWER,           "abc")
MESH_STR_ENTRY(KEY_SPACE,                 "space")
MESH_STR_ENTRY(KEY_DELETE,                "del")
MESH_STR_ENTRY(KEY_DONE,                  "done")
MESH_STR_ENTRY(KEY_SEND,                  "send")
MESH_STR_ENTRY(KEY_CANCEL,                "cancel")

/* ---- canned messages ------------------------------------------------------------------------ */

/*
 * The ten one-press replies offered under the draft row. They are overridden wholesale by
 * canned.txt next to the preferences file, so these are only the defaults - but they are the
 * defaults every user sees until they write that file, and they should read naturally in the
 * language they are shown in rather than being translated word for word.
 */
MESH_STR_ENTRY(CANNED_OK,                 "OK")
MESH_STR_ENTRY(CANNED_YES,                "Yes")
MESH_STR_ENTRY(CANNED_NO,                 "No")
MESH_STR_ENTRY(CANNED_ON_MY_WAY,          "On my way")
MESH_STR_ENTRY(CANNED_WHERE_ARE_YOU,      "Where are you?")
MESH_STR_ENTRY(CANNED_IM_HERE,            "I'm here")
MESH_STR_ENTRY(CANNED_CALL_ME,            "Call me")
MESH_STR_ENTRY(CANNED_NEED_HELP,          "Need help")
MESH_STR_ENTRY(CANNED_HEADING_BACK,       "Heading back")
MESH_STR_ENTRY(CANNED_PING,               "Ping")

/* ---- tapbacks -------------------------------------------------------------------------------- */

/*
 * The emoji the React picker offers, named. The glyph is the payload and is not translated -
 * it is what goes on the air - but the row beside it has to say what the glyph means, because
 * a column of eight faces at the panel's glyph scale is not readable as eight distinct things.
 */
MESH_STR_ENTRY(REACTION_THUMBS_UP,        "Thumbs up")
MESH_STR_ENTRY(REACTION_THUMBS_DOWN,      "Thumbs down")
MESH_STR_ENTRY(REACTION_HEART,            "Love")
MESH_STR_ENTRY(REACTION_LAUGH,            "Laugh")
MESH_STR_ENTRY(REACTION_SURPRISE,         "Surprise")
MESH_STR_ENTRY(REACTION_SAD,              "Sad")
MESH_STR_ENTRY(REACTION_QUESTION,         "Question")
MESH_STR_ENTRY(REACTION_IMPORTANT,        "Important")

/* ---- the Devices tab ------------------------------------------------------------------------- */

MESH_STR_ENTRY(DEVICES_EMPTY,             "Scanning for Meshtastic nodes...")
/* A device the adapter has not named. The angle brackets mark it as a stand-in, not a name. */
MESH_STR_ENTRY(DEVICES_UNNAMED,           "<unknown>")
/* What the device is doing, on the row's supporting line. No leading spaces: the line is a
   slot of its own now rather than something concatenated onto the end of the name. */
MESH_STR_ENTRY(DEVICES_BADGE_CONNECTED,   "connected")
MESH_STR_ENTRY(DEVICES_BADGE_WORKING,     "working...")
MESH_STR_ENTRY(DEVICES_BADGE_NEEDS_PAIR,  "needs pairing")
MESH_STR_ENTRY(DEVICES_BADGE_PAIRED,      "paired")
/* How the device is attached, against the row's trailing edge. USB is a bus name and stays as
   it is; dBm is the signal strength of a Bluetooth node. */
MESH_STR_ENTRY(DEVICES_TRAILING_USB,      "USB")
MESH_STR_ENTRY(DEVICES_TRAILING_RSSI,     "%ddBm")
/* The name given to a radio we are talking to but never saw advertise. */
MESH_STR_ENTRY(DEVICES_CONNECTED_NAME,    "Connected")

/* ---- the Status tab -------------------------------------------------------------------------- */

/* Card headings. Each names the *subject* of the rows under it rather than repeating a row
   label, which is why these are their own ids and not reused from the labels below: "Mesh" as a
   heading covers traffic and airtime, while "Mesh" as a row label is one line about whether the
   radio has reported at all, and the two are one word in English and rarely one word elsewhere.
   Short: a heading sits on a card that is already inset from both margins. */
MESH_STR_ENTRY(STATUS_CARD_LINK,          "Link")
MESH_STR_ENTRY(STATUS_CARD_MESH,          "Mesh")
MESH_STR_ENTRY(STATUS_CARD_RADIO,         "Radio")

/* Row labels down the left of the Status screen. They share one narrow column, so a
   translation that will not fit is better shortened than wrapped. */
MESH_STR_ENTRY(STATUS_LABEL_TRANSPORT,    "Transport")
MESH_STR_ENTRY(STATUS_LABEL_RADIO,        "Radio")
MESH_STR_ENTRY(STATUS_LABEL_SYNC,         "Sync")
MESH_STR_ENTRY(STATUS_LABEL_MY_NODE,      "My node")
MESH_STR_ENTRY(STATUS_LABEL_NODEDB,       "NodeDB")
MESH_STR_ENTRY(STATUS_LABEL_CACHED_HERE,  "Cached here")
MESH_STR_ENTRY(STATUS_LABEL_CHANNEL,      "Channel")
MESH_STR_ENTRY(STATUS_LABEL_AIRTIME,      "Airtime")
MESH_STR_ENTRY(STATUS_LABEL_BATTERY,      "Battery")
MESH_STR_ENTRY(STATUS_LABEL_PACKETS,      "Packets")
MESH_STR_ENTRY(STATUS_LABEL_DROPPED,      "Dropped")
MESH_STR_ENTRY(STATUS_LABEL_HEAP,         "Heap")
MESH_STR_ENTRY(STATUS_LABEL_TX_QUEUE,     "TX queue")
MESH_STR_ENTRY(STATUS_LABEL_RADIO_SAID,   "Radio said")
MESH_STR_ENTRY(STATUS_LABEL_REBOOTS,      "Reboots")
MESH_STR_ENTRY(STATUS_LABEL_MESSAGES,     "Messages")
MESH_STR_ENTRY(STATUS_LABEL_DEVICES,      "Devices")

MESH_STR_ENTRY(STATUS_NOT_CONNECTED,      "not connected")
/* How far the settings sync has got, and "(cached)" when what is shown was read from disk
   rather than from the radio just now. */
MESH_STR_ENTRY(STATUS_SYNC_COMPLETE,      "complete")
MESH_STR_ENTRY(STATUS_SYNC_IN_PROGRESS,   "in progress")
/* A 135-node replay runs about seventeen seconds; "in progress" alone could not tell a sync
   that was working from one that had stalled. %u of %u is nodes delivered of nodes the radio
   says it holds. */
MESH_STR_ENTRY(STATUS_SYNC_PROGRESS,      "%u of %u nodes")
MESH_STR_ENTRY(STATUS_SYNC_IDLE,          "idle")
MESH_STR_ENTRY(STATUS_SYNC_CACHED,        " (cached)")
/* The Sync row: how far the sync got, then the cached note when there is one. */
MESH_STR_ENTRY(STATUS_SYNC_VALUE,         "%s%s")
MESH_STR_ENTRY(STATUS_SYNC_WAITING,       "waiting for a radio")
/* Our own short name and node number, as the Meshtastic apps write it: "BRVO !a4c1f209". */
MESH_STR_ENTRY(STATUS_MY_NODE,            "%s !%08x")
/* The radio's own node database: how many it holds, and either how many of those it still
   hears or how many times it has restarted. */
MESH_STR_ENTRY(STATUS_NODEDB_ONLINE,      "%u nodes, %u online")
MESH_STR_ENTRY(STATUS_NODEDB_REBOOTS,     "%u nodes, %u reboots")
/* What this client keeps, which deliberately outlives the radio's own list. */
MESH_STR_ENTRY(STATUS_CACHED_OFF_RADIO,   "%u nodes, %u off radio")
/* Channel busy and our own transmit share, then the noise floor when the radio reports it. */
MESH_STR_ENTRY(STATUS_AIRTIME,            "%s busy, %s tx")
MESH_STR_ENTRY(STATUS_AIRTIME_FLOOR,      "%s busy, %s tx, %d dBm floor")
MESH_STR_ENTRY(STATUS_PERCENT,            "%.1f%%")
/* Battery: a percentage, or running from USB. UPTIME follows it as ", up 3d 4h". */
MESH_STR_ENTRY(STATUS_BATTERY_USB,        "plugged in")
MESH_STR_ENTRY(STATUS_BATTERY_PERCENT,    "%u%%")
MESH_STR_ENTRY(STATUS_BATTERY_UNKNOWN,    "unknown")
MESH_STR_ENTRY(STATUS_UPTIME_SUFFIX,      "%sup %s")
MESH_STR_ENTRY(STATUS_PACKETS,            "%u tx, %u rx, %u relayed")
MESH_STR_ENTRY(STATUS_DROPPED,            "%u bad rx, %u dupe, %u tx")
MESH_STR_ENTRY(STATUS_HEAP,               "%u KB free of %u KB")
MESH_STR_ENTRY(STATUS_MESH_NO_REPORT,     "no report yet")
/* The same, on the Radio card: every row there appears only when the radio has said
   something about itself, so a radio that has said nothing leaves it empty. The card
   stays up regardless, because it is the one carrying the refresh verb. */
MESH_STR_ENTRY(STATUS_RADIO_NO_REPORT,    "no report yet")
MESH_STR_ENTRY(STATUS_LABEL_RADIO_SELF,   "Reported")
/* Room left in the radio's transmit queue, and whether it is currently refusing sends. */
MESH_STR_ENTRY(STATUS_TX_QUEUE,           "%u/%u free%s")
MESH_STR_ENTRY(STATUS_TX_QUEUE_REFUSED,   ", send refused")
/* How long ago the radio last logged something at us, and how many times this connection. */
MESH_STR_ENTRY(STATUS_RADIO_SAID_COUNT,   "%s, %u this connection")
MESH_STR_ENTRY(STATUS_REBOOTS_SINCE,      "%u since connecting")
MESH_STR_ENTRY(STATUS_MESSAGES_KEPT,      "%u kept, %u dropped")
MESH_STR_ENTRY(STATUS_DEVICES_IN_RANGE,   "%zu in range")

/* ---- a node's detail screen ------------------------------------------------------------------ */

/*
 * The group headings, then the label of each row under them.
 *
 * Unit symbols in the value formats below - dB, dBm, hPa, ppm, lux, mA, V, ug/m3 - are SI or
 * near enough and are normally left exactly as they are; what a translator may want to change
 * is the spacing and the order, which is why the whole value is one string rather than a
 * number with a suffix glued on.
 */
MESH_STR_ENTRY(NODE_HEAD_IDENTITY,        "Identity")
MESH_STR_ENTRY(NODE_HEAD_SIGNAL,          "Signal")
MESH_STR_ENTRY(NODE_HEAD_METRICS,         "Device metrics")
MESH_STR_ENTRY(NODE_HEAD_POSITION,        "Position")
MESH_STR_ENTRY(NODE_HEAD_ENVIRONMENT,     "Environment")
MESH_STR_ENTRY(NODE_HEAD_POWER,           "Power")
MESH_STR_ENTRY(NODE_HEAD_AIR_QUALITY,     "Air quality")
MESH_STR_ENTRY(NODE_HEAD_HEALTH,          "Health")
MESH_STR_ENTRY(NODE_HEAD_HOST,            "Host")
MESH_STR_ENTRY(NODE_HEAD_NEIGHBOURS,      "Neighbours")
MESH_STR_ENTRY(NODE_HEAD_HEARD_BY,        "Heard by")
MESH_STR_ENTRY(NODE_HEAD_ROUTE_OUT,       "Route out")
MESH_STR_ENTRY(NODE_HEAD_ROUTE_BACK,      "Route back")

MESH_STR_ENTRY(NODE_LONG_NAME,            "Long name")
MESH_STR_ENTRY(NODE_SHORT_NAME,           "Short name")
MESH_STR_ENTRY(NODE_USER_ID,              "User ID")
MESH_STR_ENTRY(NODE_NUMBER,               "Node number")
MESH_STR_ENTRY(NODE_NAME,                 "Name")
MESH_STR_ENTRY(NODE_NODEDB,               "NodeDB")
MESH_STR_ENTRY(NODE_ROLE,                 "Role")
MESH_STR_ENTRY(NODE_HARDWARE,             "Hardware")
MESH_STR_ENTRY(NODE_PUBLIC_KEY,           "Public key")
MESH_STR_ENTRY(NODE_FLAGS,                "Flags")
MESH_STR_ENTRY(NODE_LAST_HEARD,           "Last heard")
MESH_STR_ENTRY(NODE_SNR,                  "SNR")
MESH_STR_ENTRY(NODE_RSSI,                 "RSSI")
MESH_STR_ENTRY(NODE_HOPS_AWAY,            "Hops away")
MESH_STR_ENTRY(NODE_CHANNEL,              "Channel")
MESH_STR_ENTRY(NODE_HEARD_VIA,            "Heard via")
MESH_STR_ENTRY(NODE_BATTERY,              "Battery")
MESH_STR_ENTRY(NODE_VOLTAGE,              "Voltage")
MESH_STR_ENTRY(NODE_CHANNEL_UTIL,         "Channel util")
MESH_STR_ENTRY(NODE_AIR_UTIL_TX,          "Air util TX")
MESH_STR_ENTRY(NODE_UPTIME,               "Uptime")
/* When the reading above was taken, closing a group. */
MESH_STR_ENTRY(NODE_REPORTED,             "Reported")
MESH_STR_ENTRY(NODE_MEASURED,             "Measured")
MESH_STR_ENTRY(NODE_LATITUDE,             "Latitude")
MESH_STR_ENTRY(NODE_LONGITUDE,            "Longitude")
MESH_STR_ENTRY(NODE_ALTITUDE,             "Altitude")
MESH_STR_ENTRY(NODE_SATELLITES,           "Satellites")
MESH_STR_ENTRY(NODE_PRECISION,            "Precision")
MESH_STR_ENTRY(NODE_FIX,                  "Fix")
/* The same row when the node dated nothing: what we can honestly say is when the fix
   reached us, which is a different question and gets a different word. */
MESH_STR_ENTRY(NODE_FIX_RECEIVED,         "Fix heard")
MESH_STR_ENTRY(NODE_TEMPERATURE,          "Temperature")
MESH_STR_ENTRY(NODE_HUMIDITY,             "Humidity")
MESH_STR_ENTRY(NODE_PRESSURE,             "Pressure")
MESH_STR_ENTRY(NODE_AIR_QUALITY,          "Air quality")
MESH_STR_ENTRY(NODE_LIGHT,                "Light")
MESH_STR_ENTRY(NODE_CURRENT,              "Current")
MESH_STR_ENTRY(NODE_PM25,                 "PM2.5")
MESH_STR_ENTRY(NODE_PM1_PM10,             "PM1 / PM10")
MESH_STR_ENTRY(NODE_PM1,                  "PM1")
MESH_STR_ENTRY(NODE_PM10,                 "PM10")
MESH_STR_ENTRY(NODE_CO2,                  "CO2")
MESH_STR_ENTRY(NODE_VOC_INDEX,            "VOC index")
MESH_STR_ENTRY(NODE_NOX_INDEX,            "NOx index")
MESH_STR_ENTRY(NODE_HEART_RATE,           "Heart rate")
MESH_STR_ENTRY(NODE_SPO2,                 "SpO2")
MESH_STR_ENTRY(NODE_FREE_MEMORY,          "Free memory")
MESH_STR_ENTRY(NODE_FREE_DISK,            "Free disk")
MESH_STR_ENTRY(NODE_LOAD,                 "Load")
/* The row standing in for a neighbour list that came back empty. */
MESH_STR_ENTRY(NODE_NEIGHBOURS_NONE,      "None")
MESH_STR_ENTRY(NODE_HEARS_NO_ONE,         "hears no one")
MESH_STR_ENTRY(NODE_AND_MORE,             "and more")
MESH_STR_ENTRY(NODE_NOT_SHOWN,            "%u not shown")
/* A node we have only ever seen mentioned by others: its name is made up from its number. */
MESH_STR_ENTRY(NODE_DERIVED_NAME,         "derived, no NodeInfo yet")
MESH_STR_ENTRY(NODE_NOT_IN_NODEDB,        "not on the radio")
/* The boolean flags, joined with FLAG_SEPARATOR into one row. */
MESH_STR_ENTRY(NODE_FLAG_IGNORED,         "ignored")
MESH_STR_ENTRY(NODE_FLAG_LICENSED,        "licensed")
MESH_STR_ENTRY(NODE_FLAG_UNMESSAGEABLE,   "no messages")
MESH_STR_ENTRY(NODE_FLAG_SEPARATOR,       ", ")
/* Whether the last packet reached us over the air or through an MQTT bridge. Both are
   protocol names and stay as they are. */
MESH_STR_ENTRY(NODE_VIA_MQTT,             "MQTT")
MESH_STR_ENTRY(NODE_VIA_RF,               "RF")

/* The traceroute row and the states it passes through. */
MESH_STR_ENTRY(NODE_TRACE_ROUTE,          "Trace route")
MESH_STR_ENTRY(NODE_TRACE_RUNNING,        "tracing...")
MESH_STR_ENTRY(NODE_TRACE_TIMEOUT,        "no reply; press A")
/* The first stop of a traced path is the sender, so no link reached it; a later stop with no
   reading is one the firmware did not measure. */
MESH_STR_ENTRY(NODE_HOP_START,            "start")
MESH_STR_ENTRY(NODE_HOP_NO_READING,       "no reading")
/* Each stop after the first is drawn indented behind an arrow drawn in ASCII, because the
   framebuffer font has no arrow glyph. */
MESH_STR_ENTRY(NODE_HOP_ARROW,            "-> ")

/* The action rows at the foot of the screen. */
MESH_STR_ENTRY(NODE_ACT_MESSAGE,          "Message this node")
MESH_STR_ENTRY(NODE_ACT_PIN,              "Pinned to top")
MESH_STR_ENTRY(NODE_ACT_REQUEST_INFO,     "Ask for its name")
MESH_STR_ENTRY(NODE_ACT_REQUEST_POSITION, "Ask where it is")
MESH_STR_ENTRY(NODE_ACT_REQUEST_TELEM,    "Ask for telemetry")
MESH_STR_ENTRY(NODE_ACT_MUTE,             "Mute this node")
MESH_STR_ENTRY(NODE_ACT_IGNORE,           "Ignore this node")
MESH_STR_ENTRY(NODE_ACT_REMOVE,           "Remove from radio")
MESH_STR_ENTRY(NODE_ACT_REMOVE_ARMED,     "A again to remove")
/* Share where this node says it is as a waypoint. Offered only when it has a fix - a place
   with no coordinates is not one. */
MESH_STR_ENTRY(NODE_ACT_WAYPOINT,         "Save this place")

/* Value formats. */
MESH_STR_ENTRY(NODE_VAL_USER_ID_HEX,      "!%08x")
MESH_STR_ENTRY(NODE_VAL_NUMBER,           "%u")
MESH_STR_ENTRY(NODE_VAL_SNR,              "%.2f dB")
MESH_STR_ENTRY(NODE_VAL_RSSI,             "%d dBm")
/* RSSI, plus when it was measured, for a node now reaching us some other way. */
MESH_STR_ENTRY(NODE_VAL_RSSI_AGED,        "%d dBm, %s")
MESH_STR_ENTRY(NODE_VAL_PERCENT,          "%u%%")
MESH_STR_ENTRY(NODE_VAL_PERCENT_FINE,     "%.1f%%")
MESH_STR_ENTRY(NODE_VAL_VOLTS,            "%.2f V")
MESH_STR_ENTRY(NODE_VAL_MILLIAMPS,        "%.0f mA")
MESH_STR_ENTRY(NODE_VAL_MILLIAMPS_FINE,   "%.1f mA")
MESH_STR_ENTRY(NODE_VAL_VOLTS_MILLIAMPS,  "%.2f V, %.0f mA")
MESH_STR_ENTRY(NODE_VAL_DEGREES,          "%.5f")
MESH_STR_ENTRY(NODE_VAL_METRES,           "%d m")
/* Celsius first because the radio reports Celsius; the Fahrenheit conversion follows it. */
MESH_STR_ENTRY(NODE_VAL_TEMPERATURE,      "%.1f C (%.1f F)")
MESH_STR_ENTRY(NODE_VAL_PRESSURE,         "%.1f hPa")
MESH_STR_ENTRY(NODE_VAL_IAQ,              "IAQ %u")
MESH_STR_ENTRY(NODE_VAL_LUX,              "%.0f lux")
MESH_STR_ENTRY(NODE_VAL_PARTICULATES,     "%u ug/m3")
MESH_STR_ENTRY(NODE_VAL_PARTICULATES_TWO, "%u / %u ug/m3")
MESH_STR_ENTRY(NODE_VAL_PPM,              "%u ppm")
MESH_STR_ENTRY(NODE_VAL_INDEX,            "%.0f")
MESH_STR_ENTRY(NODE_VAL_BPM,              "%u bpm")
MESH_STR_ENTRY(NODE_VAL_MEGABYTES,        "%u MB")
MESH_STR_ENTRY(NODE_VAL_GIGABYTES,        "%.1f GB")
/* A Linux load average: one, five and fifteen minutes. */
MESH_STR_ENTRY(NODE_VAL_LOAD,             "%.2f %.2f %.2f")
/* A battery channel on a multi-cell power sensor, numbered from 1. */
MESH_STR_ENTRY(NODE_POWER_CHANNEL,        "Channel %u")

/* ---- settings: sections ---------------------------------------------------------------------- */

/*
 * The Settings tree. A section is a screen; a field is a row on it.
 *
 * Section and field names follow the Meshtastic firmware's own config fields, so a translator
 * should prefer whatever the phone apps call the same setting in that language over a literal
 * translation of the English here - the point of these names is that a user can follow a guide
 * written for the phone app while holding a Brick.
 */
MESH_STR_ENTRY(SETTINGS_SECTION_ABOUT,                    "About MeshClient")
MESH_STR_ENTRY(SETTINGS_SECTION_RADIO,                    "About radio")
MESH_STR_ENTRY(SETTINGS_SECTION_USER,                     "User")
MESH_STR_ENTRY(SETTINGS_SECTION_DEVICE,                   "Device")
MESH_STR_ENTRY(SETTINGS_SECTION_DISPLAY,                  "Display")
MESH_STR_ENTRY(SETTINGS_SECTION_LORA,                     "LoRa")
MESH_STR_ENTRY(SETTINGS_SECTION_BLUETOOTH,                "Bluetooth")
MESH_STR_ENTRY(SETTINGS_SECTION_CHANNELS,                 "Channels")
MESH_STR_ENTRY(SETTINGS_SECTION_SECURITY,                 "Security")
MESH_STR_ENTRY(SETTINGS_SECTION_POSITION,                 "Position")
MESH_STR_ENTRY(SETTINGS_SECTION_POWER,                    "Power")
MESH_STR_ENTRY(SETTINGS_SECTION_MQTT,                     "MQTT")
MESH_STR_ENTRY(SETTINGS_SECTION_STORE_FORWARD,            "Store & Forward")
MESH_STR_ENTRY(SETTINGS_SECTION_TELEMETRY,                "Telemetry")
MESH_STR_ENTRY(SETTINGS_SECTION_ACTIONS,                  "Radio actions")
MESH_STR_ENTRY(SETTINGS_SECTION_MODULES,                  "Modules")
MESH_STR_ENTRY(SETTINGS_SECTION_NEIGHBOR_INFO,            "Neighbor info")
MESH_STR_ENTRY(SETTINGS_SECTION_RANGE_TEST,               "Range test")
MESH_STR_ENTRY(SETTINGS_SECTION_PAXCOUNTER,               "Paxcounter")
MESH_STR_ENTRY(SETTINGS_SECTION_TAK,                      "TAK")
MESH_STR_ENTRY(SETTINGS_SECTION_AMBIENT,                  "Ambient lighting")
MESH_STR_ENTRY(SETTINGS_SECTION_STATUS_MESSAGE,           "Status message")
MESH_STR_ENTRY(SETTINGS_SECTION_DETECTION,                "Detection sensor")
MESH_STR_ENTRY(SETTINGS_SECTION_EXT_NOTIFICATION,         "External notify")
MESH_STR_ENTRY(SETTINGS_SECTION_TRAFFIC,                  "Traffic management")
MESH_STR_ENTRY(SETTINGS_SECTION_RADIO_UI,                 "Radio UI")
MESH_STR_ENTRY(SETTINGS_SECTION_CANNED,                   "Canned messages")

/* ---- the help screen -------------------------------------------------------------------------- */

/* The help screen's own heading. The section it explains is named on the trail beside it, so
   this stays the same word on every one of them. */
MESH_STR_ENTRY(HELP_TITLE,                "Help")
/* The heading over the paragraph that describes the whole screen, before the ones about
   individual rows. */
MESH_STR_ENTRY(HELP_OVERVIEW,             "About this screen")

/* ---- settings: what a section is for ----------------------------------------------------------- */

/*
 * The paragraph the help screen opens with, one per section (docs/help.md).
 *
 * These are addressed to somebody who has just opened the screen and does not already know what
 * it is for, which is a different reader from the one the labels above are written for. Two
 * things each should carry: what the section does, and what goes wrong if it is set badly - the
 * second half being the one worth the room, since a label already gives the first.
 *
 * Keep them under 200 characters. The help screen wraps them across a 3.2" panel, and a note
 * that runs past a screenful stops being read; settings_note_fits_the_panel holds the line.
 *
 * A locale may leave any of these untranslated: mesh_str_in() falls back to English per id, so
 * an omitted note reads in English while the rest of that language stays correct. They are the
 * one class of string in this catalog with that dispensation - see docs/i18n.md.
 */
MESH_STR_ENTRY(SETTINGS_NOTE_ABOUT,                       "MeshClient itself: which version is running, where it keeps its data, and the self-update rows. Nothing on this screen reaches the radio.")
MESH_STR_ENTRY(SETTINGS_NOTE_RADIO,                       "What the attached radio says about itself - its firmware, its hardware and its node number. Read-only: a setting you can change lives in the section that owns it.")
MESH_STR_ENTRY(SETTINGS_NOTE_USER,                        "Your identity on the mesh. The long name is what node lists show; the short name is the few characters other radios draw on their own screens.")
MESH_STR_ENTRY(SETTINGS_NOTE_DEVICE,                      "How this radio behaves on the mesh: the role it plays, how often it announces itself, and what it repeats for other nodes. Role has the widest effect of anything here.")
MESH_STR_ENTRY(SETTINGS_NOTE_DISPLAY,                     "The radio's own screen: how long it stays lit, which way up it draws, and whether it reads in metric or imperial. None of it changes what the Brick shows.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA,                        "The radio link itself - region, modem settings, and how far a message may travel. Two radios must agree on region and preset or they cannot hear each other at all.")
MESH_STR_ENTRY(SETTINGS_NOTE_BLUETOOTH,                   "How the radio accepts a connection from a phone or from this client. Changing the mode or the PIN drops the current link and needs a fresh pairing.")
MESH_STR_ENTRY(SETTINGS_NOTE_CHANNELS,                    "The channels this radio listens on. A channel is a name plus a key: anyone holding the same pair can read its traffic, and anyone without it cannot.")
MESH_STR_ENTRY(SETTINGS_NOTE_SECURITY,                    "The radio's identity key, who may administer it remotely, and which debug surfaces are left open. A new private key makes this a different node to everyone else.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION,                    "Whether the radio shares where it is, how often, and how precisely. Every broadcast costs airtime on a band everyone shares, so the intervals matter.")
MESH_STR_ENTRY(SETTINGS_NOTE_POWER,                       "How the radio sleeps. Longer sleep buys battery life and costs responsiveness: a sleeping node hears nothing and answers nothing until it wakes.")
MESH_STR_ENTRY(SETTINGS_NOTE_MQTT,                        "Bridges this radio's traffic to an internet MQTT broker, joining a local mesh to a wider one. Uplink sends your traffic out; downlink brings other traffic in.")
MESH_STR_ENTRY(SETTINGS_NOTE_STORE_FORWARD,               "Asks a router on the mesh for messages that arrived while this client was off. Only a node configured as a Store & Forward router has anything to replay.")
MESH_STR_ENTRY(SETTINGS_NOTE_TELEMETRY,                   "What the radio measures about itself and its surroundings, and how often it tells the mesh. Each reading you enable is another broadcast on a shared band.")
MESH_STR_ENTRY(SETTINGS_NOTE_ACTIONS,                     "Things the radio does rather than settings it keeps: reboot, shutdown and the resets. The two forget rows are different - they clear this client's own node list.")
MESH_STR_ENTRY(SETTINGS_NOTE_MODULES,                     "The optional features this radio's firmware can run. Each row opens that module's own settings, and its value says whether the module is currently enabled.")
MESH_STR_ENTRY(SETTINGS_NOTE_NEIGHBOR_INFO,               "Reports which nodes this radio hears directly, so the mesh can map its own shape. The firmware floors the interval at four hours because it is a lot of traffic.")
MESH_STR_ENTRY(SETTINGS_NOTE_RANGE_TEST,                  "Sends numbered packets on a timer so you can walk away and find where reception stops. It transmits to everyone on the channel, so turn it off when you are done.")
MESH_STR_ENTRY(SETTINGS_NOTE_PAXCOUNTER,                  "Counts nearby WiFi and Bluetooth devices as a rough headcount, identifying none of them. It needs a board whose hardware can scan both bands.")
MESH_STR_ENTRY(SETTINGS_NOTE_TAK,                         "Bridges this radio to ATAK and WinTAK team awareness software. The team and role here are what other TAK clients draw for this node.")
MESH_STR_ENTRY(SETTINGS_NOTE_AMBIENT,                     "Drives an RGB LED on radios wired for one. The colour rows and the current limit do nothing at all on a board without the hardware.")
MESH_STR_ENTRY(SETTINGS_NOTE_STATUS_MESSAGE,              "A short line this radio publishes about itself, the way a status message works anywhere else.")
MESH_STR_ENTRY(SETTINGS_NOTE_DETECTION,                   "Watches a GPIO pin and tells the mesh when it changes - a door, a switch, a sensor. Pin numbers are the radio board's own, so check its wiring before setting one.")
MESH_STR_ENTRY(SETTINGS_NOTE_EXT_NOTIFICATION,            "Drives a buzzer, a vibration motor or an LED when a message or an alert arrives. Each output names the pin it is on and which of the two alerts triggers it.")
MESH_STR_ENTRY(SETTINGS_NOTE_TRAFFIC,                     "Limits how much other nodes may push through this one. There is no enabled switch: every row here is off at 0, and any other value turns that limit on.")
MESH_STR_ENTRY(SETTINGS_NOTE_RADIO_UI,                    "The graphical interface drawn on the radio's own screen. Not the same as Display: that section is the panel itself, this is what gets drawn on it.")
MESH_STR_ENTRY(SETTINGS_NOTE_CANNED,                      "Short replies stored on the radio for its own buttons. Six slots of 32 characters, because the wire carries the whole list as a single 200-byte string.")

/*
 * Field notes: the rows where knowing the name does not tell you what happens if you get it
 * wrong. Most settings have none, on purpose - see docs/help.md.
 *
 * Same rules as the section notes above: under 200 characters, one or two sentences, and a
 * locale may leave them untranslated. Ordered by section, LoRa first because it is the section
 * the questions actually get asked about.
 */
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_REGION,                 "Which band this radio transmits on, set by law where you are. A radio on the wrong region cannot talk to its neighbours and may not be legal to transmit at all.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_SPREAD,                 "How far each symbol is spread over the air. Higher reaches further and carries less: every step up roughly doubles the time a message takes to send.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_CODING,                 "How much error correction rides along with each message. Higher recovers more damaged packets and makes every packet longer.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_HOPS,                   "How many times a message may be relayed before the mesh drops it. Every extra hop costs the whole mesh airtime, so raise it only to reach a node that is genuinely that far.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_TX_POWER,               "How hard this radio transmits, in dBm. Your region caps this in law, and more power drains the battery faster without helping if the other end cannot answer.")
MESH_STR_ENTRY(SETTINGS_NOTE_LORA_BANDWIDTH,              "How wide a slice of the band each transmission uses. Wider carries more per second and hears more noise with it; narrower reaches further and takes longer to send.")

/*
 * Phase 2: the rows outside LoRa where the label does not tell you what goes wrong.
 *
 * Grouped by the section they are read in rather than by subject, so that adding a note means
 * finding the section it belongs to and writing one line under it.
 */

/* Device. */
MESH_STR_ENTRY(SETTINGS_NOTE_DEVICE_ROLE,                 "What job this radio does for the mesh. Client suits almost everyone; the router roles repeat other people's traffic, which only helps from a spot with a view and costs airtime everywhere else.")
MESH_STR_ENTRY(SETTINGS_NOTE_DEVICE_REBROADCAST,          "Which of the traffic it hears this radio repeats. All is the usual answer; the narrower settings keep other meshes at arm's length, and none makes this node a dead end for anyone behind it.")

/* Position. */
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_SMART,              "Sends your position when the radio has actually moved instead of on a fixed timer. A node that stays put stops transmitting; one that is moving reports sooner than the interval would.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_SMART_DISTANCE,     "How far the radio must move before smart broadcasting sends a new position. Set it too small and a GPS drifting on a windowsill transmits all day without going anywhere.")
MESH_STR_ENTRY(SETTINGS_NOTE_POSITION_SMART_INTERVAL,     "The shortest gap smart broadcasting leaves between two positions, however far the radio has moved. It is the floor that stops somebody in a car flooding the channel.")

/* Channels. */
MESH_STR_ENTRY(SETTINGS_NOTE_CHANNEL_KEY,                 "The key that protects this channel: everyone who can read it holds the same one. The default key is published with the firmware, so a channel meant to be private needs a random key shared by hand.")
MESH_STR_ENTRY(SETTINGS_NOTE_CHANNEL_UPLINK,             "Sends this channel's traffic on to the MQTT broker, when the radio has one. Everything said here then leaves the local mesh for the internet, so leave it off for a private channel.")
MESH_STR_ENTRY(SETTINGS_NOTE_CHANNEL_DOWNLINK,           "Puts traffic from the MQTT broker onto this channel and out over the radio. A busy broker can fill the air with messages nobody nearby asked for, at everyone's expense.")
MESH_STR_ENTRY(SETTINGS_NOTE_CHANNEL_POSITION,           "How precisely positions are shared here. Fewer bits round every location to a coarser square; off shares no coordinates at all, only that the node exists.")

/* Security. */
MESH_STR_ENTRY(SETTINGS_NOTE_SECURITY_ADMIN_KEYS,        "Public keys of the nodes allowed to configure this radio over the mesh. A key here is a key to the radio, so leave all three empty unless you are deliberately setting up remote administration.")

/* Store & Forward. */
MESH_STR_ENTRY(SETTINGS_NOTE_SF_HISTORY_WINDOW,          "How far back this radio goes when another node asks it for missed messages. It is this radio's setting as a router; what somebody else's router replays to you is theirs.")

/* Neighbor info. */
MESH_STR_ENTRY(SETTINGS_NOTE_NEIGHBOR_INTERVAL,          "How often this radio reports the nodes it hears directly. The firmware quietly raises anything under four hours, because every report is a broadcast the whole mesh carries.")

/* ---- the features: what a screen is for ------------------------------------------------------- */

/*
 * The other half of the help screen: the tabs and the overlays, keyed on the route rather than
 * on a settings section (docs/help.md, phase 3).
 *
 * Two kinds of id live here and they follow different rules. A HELP_NOTE_* is a paragraph and
 * plays by the note rules above - under 200 characters, and a locale may leave it untranslated.
 * A HELP_SUBJECT_* or HELP_LABEL_* is a *heading*: a few words naming the screen or the
 * paragraph under it, drawn beside the rest of the chrome, so it is an ordinary string and every
 * locale owes a translation for it.
 *
 * The subjects name what is being explained, on the trail above the title, and only exist where
 * no other string in the catalog already says it. The five tabs use their own tab names.
 */
MESH_STR_ENTRY(HELP_SUBJECT_THREAD,       "Conversation")
MESH_STR_ENTRY(HELP_SUBJECT_REACTION,     "Tapbacks")
MESH_STR_ENTRY(HELP_SUBJECT_NODE,         "Node")
MESH_STR_ENTRY(HELP_SUBJECT_WAYPOINT,     "Place")

/* Messages: the conversation list. */
MESH_STR_ENTRY(HELP_LABEL_MESSAGES_NEW,   "Starting a conversation")
MESH_STR_ENTRY(HELP_LABEL_MESSAGES_DROP,  "Deleting one")
MESH_STR_ENTRY(HELP_NOTE_MESSAGES,        "Every conversation this client has heard, newest first: one node you have exchanged messages with, or one channel. The top row carries all traffic at once.")
MESH_STR_ENTRY(HELP_NOTE_MESSAGES_NEW,    "Y asks who to write to and opens the keyboard on the conversation you pick. A conversation appears here on its own as soon as anything arrives in it.")
MESH_STR_ENTRY(HELP_NOTE_MESSAGES_DROP,   "X twice drops a conversation from this client. It removes nothing from the mesh and nothing from the radio, and anything new in it starts the conversation again.")

/* Messages: one transcript. */
MESH_STR_ENTRY(HELP_LABEL_THREAD_MARKS,   "The mark on a message")
MESH_STR_ENTRY(HELP_LABEL_THREAD_REPLY,   "Replies and tapbacks")
MESH_STR_ENTRY(HELP_LABEL_THREAD_ALL,     "The all-traffic view")
MESH_STR_ENTRY(HELP_NOTE_THREAD,          "What was said here, oldest at the top. Your own messages sit on the right; a padlock means the channel was encrypted, and the hop count is how far the message travelled.")
MESH_STR_ENTRY(HELP_NOTE_THREAD_MARKS,    "A clock means the radio is still waiting to hear that a message arrived, a double tick that a node confirmed it, an alert that it did not. A broadcast asks for no answer and carries no mark.")
MESH_STR_ENTRY(HELP_NOTE_THREAD_REPLY,    "A answers the message under the cursor and X puts an emoji on it; Y writes to the conversation instead. A reply stays aimed at the message you pressed on, however far the transcript moves underneath.")
MESH_STR_ENTRY(HELP_NOTE_THREAD_ALL,      "The top row of the list is every message the radio heard, whoever it was for. There is nobody to reply to in it, so it offers no reply and no tapback - open the conversation itself for those.")

/* Messages: the tapback picker. */
MESH_STR_ENTRY(HELP_LABEL_REACTION_SEND,  "What it costs")
MESH_STR_ENTRY(HELP_NOTE_REACTION,        "A tapback is an emoji aimed at one message. It draws as a chip on the message it names rather than as a bubble of its own, so it answers without taking a line of the conversation.")
MESH_STR_ENTRY(HELP_NOTE_REACTION_SEND,   "One small packet, sent without asking to be acknowledged - so it earns no delivery mark and costs the mesh no retry. The set is fixed so that every client can draw what you sent.")

/* Nodes. */
MESH_STR_ENTRY(HELP_LABEL_NODES_PIN,      "Pinned nodes")
MESH_STR_ENTRY(HELP_LABEL_NODES_CACHED,   "Nodes the radio has forgotten")
MESH_STR_ENTRY(HELP_NOTE_NODES,           "Everyone this client has heard of, the most recently heard first. A node that has never said what it is called is listed by its node number, exactly as the phone apps list it.")
MESH_STR_ENTRY(HELP_NOTE_NODES_PIN,       "X pins a node to the top of the list and keeps it there. Pins are this client's own and are kept across a restart; they change nothing on the radio.")
MESH_STR_ENTRY(HELP_NOTE_NODES_CACHED,    "The radio holds about eighty nodes and drops the oldest, so this list is deliberately longer than its NodeDB and marks what the radio no longer carries. Settings > Radio actions clears them.")

/* One node's detail. */
MESH_STR_ENTRY(HELP_LABEL_NODE_FIX,       "Fix and Fix heard")
MESH_STR_ENTRY(HELP_LABEL_NODE_TREND,     "The small graphs")
MESH_STR_ENTRY(HELP_NOTE_NODE,            "What this client knows about one node: who it says it is, where it said it was, and how well this radio hears it. All of it is what the node last told the mesh.")
MESH_STR_ENTRY(HELP_NOTE_NODE_FIX,        "Fix is when the node's own GPS solved the position. Fix heard is when the packet reached us, and the row changes its name rather than quietly answering the first question with the second.")
MESH_STR_ENTRY(HELP_NOTE_NODE_TREND,      "A reading over time, drawn against the same scale as the bar beside it. It is only what this client watched while running, so it starts empty after a restart and breaks where the node went quiet.")

/* Waypoints. */
MESH_STR_ENTRY(HELP_LABEL_WAYPOINT_NEW,   "Naming a place")
MESH_STR_ENTRY(HELP_LABEL_WAYPOINT_SHARE, "Who else sees it")
MESH_STR_ENTRY(HELP_LABEL_WAYPOINT_DROP,  "Deleting one")
MESH_STR_ENTRY(HELP_NOTE_WAYPOINTS,       "Places the mesh has agreed on, nearest first from wherever this radio last had a fix. The distance and the bearing are measured from that fix, so they need one to mean anything.")
MESH_STR_ENTRY(HELP_NOTE_WAYPOINT_NEW,    "The last row of the list makes a place where you are standing. It needs a position from the radio, and says so rather than disappearing when there is none.")
MESH_STR_ENTRY(HELP_NOTE_WAYPOINT_SHARE,  "Sharing broadcasts the place on a channel, so everyone holding that channel's key gets it. Sending it again with the same name replaces the copy they hold rather than adding a second.")
MESH_STR_ENTRY(HELP_NOTE_WAYPOINT_DROP,   "Deleting a place you shared asks the whole mesh to forget it. A place somebody else shared is only dropped here, because withdrawing it is theirs to do and not ours.")

/* Devices. */
MESH_STR_ENTRY(HELP_LABEL_DEVICES_PAIR,   "Pairing")
MESH_STR_ENTRY(HELP_LABEL_DEVICES_FORGET, "Forgetting one")
MESH_STR_ENTRY(HELP_NOTE_DEVICES,         "The radios this Brick can reach: Bluetooth nodes it can see, and anything plugged into the USB port. A opens a link to the one under the cursor and X closes it.")
MESH_STR_ENTRY(HELP_NOTE_DEVICES_PAIR,    "A Bluetooth radio wants pairing the first time. The radio shows a six-digit code on its own screen and this client asks for it; the pairing is then kept until one side forgets it.")
MESH_STR_ENTRY(HELP_NOTE_DEVICES_FORGET,  "Y twice drops a radio's pairing from this Brick. Connecting again needs the code again, which is what to do when a radio was re-flashed and no longer knows this client.")

/* Status. */
MESH_STR_ENTRY(HELP_LABEL_STATUS_COUNTS,  "Why two node counts differ")
MESH_STR_ENTRY(HELP_NOTE_STATUS,          "How this client, its link and the radio are doing, one card each. A card the radio has told us nothing about says so rather than disappearing, so nothing moves under the cursor.")
MESH_STR_ENTRY(HELP_NOTE_STATUS_COUNTS,   "NodeDB is what the radio still holds and Cached here is what this client remembers, which is deliberately more: a node the radio evicted is gone for good, so we keep it.")


