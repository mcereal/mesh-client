/* ---- settings: what a value is called --------------------------------------------------------- */

/* DisplayConfig.CompassOrientation: how far the compass rose is turned, and whether it is
   mirrored. "deg" is degrees; "flip" is the mirrored set. */
MESH_STR_ENTRY(ENUM_COMPASS_0,            "0 deg")
MESH_STR_ENTRY(ENUM_COMPASS_90,           "90 deg")
MESH_STR_ENTRY(ENUM_COMPASS_180,          "180 deg")
MESH_STR_ENTRY(ENUM_COMPASS_270,          "270 deg")
MESH_STR_ENTRY(ENUM_COMPASS_0_FLIP,       "0 flip")
MESH_STR_ENTRY(ENUM_COMPASS_90_FLIP,      "90 flip")
MESH_STR_ENTRY(ENUM_COMPASS_180_FLIP,     "180 flip")
MESH_STR_ENTRY(ENUM_COMPASS_270_FLIP,     "270 flip")
/* Which measurement system the radio's own screen uses. */
MESH_STR_ENTRY(ENUM_UNITS_METRIC,         "Metric")
MESH_STR_ENTRY(ENUM_UNITS_IMPERIAL,       "Imperial")
/* DisplayConfig.OledType: the panel the radio drives, when its autodetect needs overriding.
   Named by the controller part number, which is what is printed on the module and what every
   board's documentation calls it - there is no friendlier name for an SH1107. */
MESH_STR_ENTRY(ENUM_OLED_AUTO,            "Auto")
MESH_STR_ENTRY(ENUM_OLED_SSD1306,         "SSD1306")
MESH_STR_ENTRY(ENUM_OLED_SH1106,          "SH1106")
MESH_STR_ENTRY(ENUM_OLED_SH1107,          "SH1107")
MESH_STR_ENTRY(ENUM_OLED_SH1107_128,      "SH1107 128x128")
MESH_STR_ENTRY(ENUM_OLED_SH1107_ROT,      "SH1107 rotated")
/* DisplayConfig.DisplayMode: how the radio lays its screen out. Named for the panel each one
   suits rather than for the constant - "Two-colour" says what TWOCOLOR is for. */
MESH_STR_ENTRY(ENUM_DISPLAYMODE_DEFAULT,  "Default")
MESH_STR_ENTRY(ENUM_DISPLAYMODE_TWOCOLOR, "Two-colour")
MESH_STR_ENTRY(ENUM_DISPLAYMODE_INVERTED, "Two-colour inverted")
MESH_STR_ENTRY(ENUM_DISPLAYMODE_COLOR,    "Colour")
/* DetectionSensorConfig.TriggerType: what the monitored pin has to do to count as a trigger.
   Named for the pin's behaviour rather than for the protobuf constant. */
MESH_STR_ENTRY(ENUM_TRIGGER_LOW,          "Low")
MESH_STR_ENTRY(ENUM_TRIGGER_HIGH,         "High")
MESH_STR_ENTRY(ENUM_TRIGGER_FALLING,      "Falling edge")
MESH_STR_ENTRY(ENUM_TRIGGER_RISING,       "Rising edge")
MESH_STR_ENTRY(ENUM_TRIGGER_EITHER_LOW,   "Any edge, low")
MESH_STR_ENTRY(ENUM_TRIGGER_EITHER_HIGH,  "Any edge, high")
/* DeviceUIConfig's own enums: the radio's screen, not this client's theme. */
MESH_STR_ENTRY(ENUM_UI_THEME_DARK,        "Dark")
MESH_STR_ENTRY(ENUM_UI_THEME_LIGHT,       "Light")
MESH_STR_ENTRY(ENUM_UI_THEME_RED,         "Red")
MESH_STR_ENTRY(ENUM_UI_COMPASS_DYNAMIC,   "Dynamic ring")
MESH_STR_ENTRY(ENUM_UI_COMPASS_FIXED,     "Fixed ring")
MESH_STR_ENTRY(ENUM_UI_COMPASS_FREEZE,    "Freeze heading")
MESH_STR_ENTRY(ENUM_UI_GPS_DEC,           "Decimal")
MESH_STR_ENTRY(ENUM_UI_GPS_DMS,           "Deg min sec")
MESH_STR_ENTRY(ENUM_UI_GPS_UTM,           "UTM")
MESH_STR_ENTRY(ENUM_UI_GPS_MGRS,          "MGRS")
MESH_STR_ENTRY(ENUM_UI_GPS_OLC,           "Plus codes")
MESH_STR_ENTRY(ENUM_UI_GPS_OSGR,          "OS grid")
MESH_STR_ENTRY(ENUM_UI_GPS_MLS,           "Maidenhead")
MESH_STR_ENTRY(ENUM_UI_CLOCK_DIGITAL,     "Digital")
MESH_STR_ENTRY(ENUM_UI_CLOCK_ANALOG,      "Analog")
/* Config.DeviceConfig.RebroadcastMode: which packets this node passes on. */
MESH_STR_ENTRY(ENUM_REBROADCAST_ALL,      "All")
MESH_STR_ENTRY(ENUM_REBROADCAST_ALL_SKIP, "All skip decoding")
MESH_STR_ENTRY(ENUM_REBROADCAST_LOCAL,    "Local only")
MESH_STR_ENTRY(ENUM_REBROADCAST_KNOWN,    "Known only")
MESH_STR_ENTRY(ENUM_REBROADCAST_NONE,     "None")
MESH_STR_ENTRY(ENUM_REBROADCAST_CORE,     "Core portnums only")
/* PositionConfig.GpsMode. NOT_PRESENT is the radio saying it has no GPS at all, which is a
   different thing from having one switched off. */
MESH_STR_ENTRY(ENUM_GPS_DISABLED,         "Disabled")
MESH_STR_ENTRY(ENUM_GPS_ENABLED,          "Enabled")
MESH_STR_ENTRY(ENUM_GPS_NOT_PRESENT,      "Not present")
/* A channel slot's role. The primary slot is never offered here - see build_channel(). */
MESH_STR_ENTRY(ENUM_CHANNEL_DISABLED,     "Disabled")
MESH_STR_ENTRY(ENUM_CHANNEL_SECONDARY,    "Secondary")
MESH_STR_ENTRY(ENUM_CHANNEL_PRIMARY,      "Primary")
/* BluetoothConfig.PairingMode: how the radio proves it is the one you meant to pair with. */
MESH_STR_ENTRY(ENUM_PAIRING_RANDOM_PIN,   "Random PIN")
MESH_STR_ENTRY(ENUM_PAIRING_FIXED_PIN,    "Fixed PIN")
MESH_STR_ENTRY(ENUM_PAIRING_NO_PIN,       "No PIN")
/* Two device roles upstream has retired. They still have to be steppable, because an older
   radio reports them and the row could not otherwise show what a node is set to - the
   "(retired)" is there to stop anyone choosing one on purpose. */
MESH_STR_ENTRY(ENUM_ROLE_ROUTER_CLIENT,   "Router Client (retired)")
MESH_STR_ENTRY(ENUM_ROLE_REPEATER,        "Repeater (retired)")
/* How strictly this node checks the signatures on packets it receives. */
MESH_STR_ENTRY(ENUM_SIGNATURE_COMPATIBLE, "Compatible")
MESH_STR_ENTRY(ENUM_SIGNATURE_BALANCED,   "Balanced")
MESH_STR_ENTRY(ENUM_SIGNATURE_STRICT,     "Strict")
/* Mesh beacon's two ways of saying a value is absent, which are not the same thing: an offer
   that names no preset is not offering one, while a target that names none goes out on whatever
   the radio is already running. */
MESH_STR_ENTRY(ENUM_BEACON_NOT_OFFERED,   "not offered")
MESH_STR_ENTRY(ENUM_BEACON_AS_RUNNING,    "as configured")
/* ATAK team colours and roles, from atak.proto. A translator should use whatever ATAK itself
   calls these in the target language rather than translating the English, so that a team set
   on the Brick matches what the TAK client shows. */
MESH_STR_ENTRY(ENUM_TAK_TEAM_DEFAULT,     "Default (cyan)")
MESH_STR_ENTRY(ENUM_TAK_TEAM_WHITE,       "White")
MESH_STR_ENTRY(ENUM_TAK_TEAM_YELLOW,      "Yellow")
MESH_STR_ENTRY(ENUM_TAK_TEAM_ORANGE,      "Orange")
MESH_STR_ENTRY(ENUM_TAK_TEAM_MAGENTA,     "Magenta")
MESH_STR_ENTRY(ENUM_TAK_TEAM_RED,         "Red")
MESH_STR_ENTRY(ENUM_TAK_TEAM_MAROON,      "Maroon")
MESH_STR_ENTRY(ENUM_TAK_TEAM_PURPLE,      "Purple")
MESH_STR_ENTRY(ENUM_TAK_TEAM_DARK_BLUE,   "Dark blue")
MESH_STR_ENTRY(ENUM_TAK_TEAM_BLUE,        "Blue")
MESH_STR_ENTRY(ENUM_TAK_TEAM_CYAN,        "Cyan")
MESH_STR_ENTRY(ENUM_TAK_TEAM_TEAL,        "Teal")
MESH_STR_ENTRY(ENUM_TAK_TEAM_GREEN,       "Green")
MESH_STR_ENTRY(ENUM_TAK_TEAM_DARK_GREEN,  "Dark green")
MESH_STR_ENTRY(ENUM_TAK_TEAM_BROWN,       "Brown")
MESH_STR_ENTRY(ENUM_TAK_ROLE_DEFAULT,     "Default (member)")
MESH_STR_ENTRY(ENUM_TAK_ROLE_MEMBER,      "Team member")
MESH_STR_ENTRY(ENUM_TAK_ROLE_LEAD,        "Team lead")
MESH_STR_ENTRY(ENUM_TAK_ROLE_HQ,          "HQ")
MESH_STR_ENTRY(ENUM_TAK_ROLE_SNIPER,      "Sniper")
MESH_STR_ENTRY(ENUM_TAK_ROLE_MEDIC,       "Medic")
MESH_STR_ENTRY(ENUM_TAK_ROLE_FORWARD_OBS, "Forward observer")
MESH_STR_ENTRY(ENUM_TAK_ROLE_RTO,         "RTO")
MESH_STR_ENTRY(ENUM_TAK_ROLE_K9,          "K9")

/* ---- settings: formatted values ---------------------------------------------------------------- */

/* Durations, as a settings row writes them: whole hours, whole minutes, else seconds. */
MESH_STR_ENTRY(VALUE_HOURS,               "%uh")
MESH_STR_ENTRY(VALUE_MINUTES,             "%um")
MESH_STR_ENTRY(VALUE_SECONDS,             "%us")
/* A typed frequency with its unit after it. Two rows of LoRa sit next to each other in
   megahertz and hertz, and the bare numbers say nothing about which is which. */
MESH_STR_ENTRY(VALUE_MEGAHERTZ,           "%s MHz")
MESH_STR_ENTRY(VALUE_HERTZ,               "%s Hz")
MESH_STR_ENTRY(VALUE_MILLISECONDS,        "%ums")
/* A NUMBER row whose 0 means nothing in particular - a plain zero rather than "off". */
MESH_STR_ENTRY(VALUE_ZERO,                "0")
/*
 * What 0 means on the NUMBER rows that have a word for it, from field_spec.zero_label. They
 * read the same as the common words above and are separate ids on purpose: "off" answering
 * "how often?" and "off" answering "is it on?" are one word in English and two most other
 * places, and only an id apiece lets a translator tell them apart.
 */
MESH_STR_ENTRY(ZERO_OFF,                  "off")
MESH_STR_ENTRY(ZERO_DEFAULT,              "default")
MESH_STR_ENTRY(ZERO_NONE,                 "none")
MESH_STR_ENTRY(ZERO_NEVER,                "never")
MESH_STR_ENTRY(ZERO_ONCE,                 "once")
MESH_STR_ENTRY(VALUE_PLAIN,               "%u")
/* Position precision, which is a bit count on the wire and a distance to a reader. */
MESH_STR_ENTRY(VALUE_PRECISION_OFF,       "off")
MESH_STR_ENTRY(VALUE_PRECISION_EXACT,     "precise")
MESH_STR_ENTRY(VALUE_PRECISION_BITS,      "%u bits")
MESH_STR_ENTRY(VALUE_KILOMETRES,          "%u km")
MESH_STR_ENTRY(VALUE_METRES,              "%u m")
/* LoRa. The two fractional bandwidths are spelled out because "%u kHz" would round them. */
MESH_STR_ENTRY(VALUE_BANDWIDTH_31,        "31.25 kHz")
MESH_STR_ENTRY(VALUE_BANDWIDTH_62,        "62.5 kHz")
MESH_STR_ENTRY(VALUE_BANDWIDTH_KHZ,       "%u kHz")
/* A coding rate is written as the fraction 4/n. */
MESH_STR_ENTRY(VALUE_CODING_RATE,         "4/%u")
/* Transmit power: 0 means "whatever the region allows", not zero power. */
MESH_STR_ENTRY(VALUE_TX_POWER_MAX,        "max")
MESH_STR_ENTRY(VALUE_DBM,                 "%d dBm")
MESH_STR_ENTRY(VALUE_MILLIAMPS,           "%u mA")
/* A GPIO pin, or none chosen. */
MESH_STR_ENTRY(VALUE_PIN_UNSET,           "unset")
MESH_STR_ENTRY(VALUE_PIN,                 "GPIO %u")
/* Distances offered for position precision, from the coarsest upward. */
MESH_STR_ENTRY(VALUE_PRECISION_23KM,      "~23 km")
MESH_STR_ENTRY(VALUE_PRECISION_12KM,      "~12 km")
MESH_STR_ENTRY(VALUE_PRECISION_6KM,       "~6 km")
MESH_STR_ENTRY(VALUE_PRECISION_3KM,       "~3 km")
MESH_STR_ENTRY(VALUE_PRECISION_1_5KM,     "~1.5 km")
MESH_STR_ENTRY(VALUE_PRECISION_730M,      "~730 m")
MESH_STR_ENTRY(VALUE_PRECISION_360M,      "~360 m")
MESH_STR_ENTRY(VALUE_PRECISION_180M,      "~180 m")
MESH_STR_ENTRY(VALUE_PRECISION_90M,       "~90 m")
MESH_STR_ENTRY(VALUE_PRECISION_45M,       "~45 m")
/* The same ten footprints for a reader whose radio is set to imperial. Written out rather than
   converted at the point of use, for the reason the metric ten are: every one of these is a round
   number somebody can picture, and running 730 m through a conversion yields "2395 ft", which is a
   figure precise about a rounding. */
MESH_STR_ENTRY(VALUE_PRECISION_14MI,      "~14 mi")
MESH_STR_ENTRY(VALUE_PRECISION_7_5MI,     "~7.5 mi")
MESH_STR_ENTRY(VALUE_PRECISION_3_6MI,     "~3.6 mi")
MESH_STR_ENTRY(VALUE_PRECISION_1_8MI,     "~1.8 mi")
MESH_STR_ENTRY(VALUE_PRECISION_0_9MI,     "~0.9 mi")
MESH_STR_ENTRY(VALUE_PRECISION_2400FT,    "~2400 ft")
MESH_STR_ENTRY(VALUE_PRECISION_1200FT,    "~1200 ft")
MESH_STR_ENTRY(VALUE_PRECISION_600FT,     "~600 ft")
MESH_STR_ENTRY(VALUE_PRECISION_300FT,     "~300 ft")
MESH_STR_ENTRY(VALUE_PRECISION_150FT,     "~150 ft")

/* ---- settings: rows and their values ------------------------------------------------------------ */

/* A TEXT row with nothing in it, and one holding a credential. The mask is a fixed length so
   it does not give away how long the secret is. */
MESH_STR_ENTRY(SETTINGS_TEXT_EMPTY,       "-")
MESH_STR_ENTRY(SETTINGS_TEXT_SECRET,      "********")
/* Encryption keys. The first four bytes are shown as a fingerprint - enough to check against
   the phone app, not enough to be read over a shoulder. */
MESH_STR_ENTRY(SETTINGS_KEY_NONE,         "none")
MESH_STR_ENTRY(SETTINGS_KEY_NO_ENCRYPTION,"no encryption")
MESH_STR_ENTRY(SETTINGS_KEY_DEFAULT,      "default key")
MESH_STR_ENTRY(SETTINGS_KEY_SIMPLE,       "simple key %u")
MESH_STR_ENTRY(SETTINGS_KEY_AES,          "%.8s... (AES-%u)")
MESH_STR_ENTRY(SETTINGS_KEY_BITS,         "%.8s... (%u-bit)")
MESH_STR_ENTRY(SETTINGS_KEY_FINGERPRINT,  "%s... (%u bytes)")
MESH_STR_ENTRY(SETTINGS_KEY_INVALID,      "invalid key")
/* What a KEY row will do when the section is saved. */
MESH_STR_ENTRY(SETTINGS_KEY_NEW_AES128,   "new random AES-128")
MESH_STR_ENTRY(SETTINGS_KEY_NEW_AES256,   "new random AES-256")
MESH_STR_ENTRY(SETTINGS_KEY_NEW_KEY,      "new random key")
MESH_STR_ENTRY(SETTINGS_KEY_CLEAR,        "none (clear)")
/* A section the radio has not sent yet, and a row that needs a link it has not got. */
MESH_STR_ENTRY(SETTINGS_NOT_LOADED,       "not loaded")
MESH_STR_ENTRY(SETTINGS_NOT_CONNECTED,    "not connected")
/* The other reason a section is empty, and the one a refresh will never change: this radio's
   firmware was built without it (DeviceMetadata.excluded_modules). Said as a separate pair
   from "not loaded" because the answer to one is to wait and the answer to the other is not. */
MESH_STR_ENTRY(SETTINGS_NOT_IN_FIRMWARE,  "not in firmware")
MESH_STR_ENTRY(SETTINGS_EMPTY_DISCONNECT, "Connect to a radio to read its settings")
MESH_STR_ENTRY(SETTINGS_EMPTY_SECTION,    "Not sent by the radio yet; X to refresh")
MESH_STR_ENTRY(SETTINGS_EMPTY_EXCLUDED,   "This radio's firmware was built without it")
/* Titles down the Settings tree. Each is one level's *name* and nothing else: the breadcrumb
   used to be "Settings > %s%s%s", which handed a translator the trail's grammar along with its
   words and glued a badge on with a %s. The app bar stacks the levels itself and draws the
   separators as icons, so what is left here is a word per level and a count per badge. */
MESH_STR_ENTRY(SETTINGS_TITLE,            "Settings")
MESH_STR_ENTRY(SETTINGS_TITLE_CHANNEL,    "Channel %u")
MESH_STR_ENTRY(SETTINGS_UNSAVED,          "%u unsaved")

/* About. */
MESH_STR_ENTRY(ABOUT_VERSION,             "Version")
MESH_STR_ENTRY(ABOUT_UI_BACKEND,          "UI backend")
MESH_STR_ENTRY(ABOUT_DATA,                "Data")
/*
 * The crash report rows, shown only when a previous run left one behind.
 *
 * "Crash report" names the file and the value column says where it is; the discard row is the
 * verb. Two rows rather than one because the path is the half somebody has to copy off the
 * screen and the press is the half that makes the banner go away, and a single row cannot both
 * show a path and offer a press.
 */
MESH_STR_ENTRY(ABOUT_CRASH_REPORT,        "Crash report")
MESH_STR_ENTRY(ABOUT_CRASH_DISCARD,       "Discard report")
MESH_STR_ENTRY(ABOUT_THEME,               "Theme")
/* The theme is being held by MESHCLIENT_THEME, so the row is a fact rather than a switch. */
MESH_STR_ENTRY(ABOUT_THEME_ENV,           "Theme (env)")
MESH_STR_ENTRY(ABOUT_UPDATES,             "Updates")
MESH_STR_ENTRY(ABOUT_UPDATES_UNAVAILABLE, "unavailable")
MESH_STR_ENTRY(ABOUT_UPDATE_CHANNEL,      "Update channel")
MESH_STR_ENTRY(ABOUT_DEV_UPDATES,         "Dev updates")
MESH_STR_ENTRY(ABOUT_DEV_UPDATES_ENV,     "on (environment)")
MESH_STR_ENTRY(ABOUT_UPDATE_STATUS,       "Update status")
MESH_STR_ENTRY(ABOUT_WORKING,             "Working")
MESH_STR_ENTRY(ABOUT_WORKING_DOWNLOAD,    "downloading...")
MESH_STR_ENTRY(ABOUT_WORKING_CHECK,       "checking...")
/* The same row once the download has a size to divide by. Just the figure: the bar beside it
   carries the shape, and the row above it already says which step is running - so repeating
   "downloading" here would clip the one thing this row adds. A whole percent, because
   tenths on a number that moves every second are noise. */
MESH_STR_ENTRY(ABOUT_WORKING_PERCENT,     "%u%%")
MESH_STR_ENTRY(ABOUT_INSTALLED,           "Installed")
MESH_STR_ENTRY(ABOUT_INSTALLED_RELAUNCH,  "quit and relaunch")
MESH_STR_ENTRY(ABOUT_CHECK_UPDATES,       "Check for updates")
/* The row that installs a named release. The version goes in the label so the value column is
   free to say how to act on it. */
MESH_STR_ENTRY(ABOUT_INSTALL_VERSION,     "Install %.*s")
MESH_STR_ENTRY(ABOUT_INSTALLING,          "Installing")
MESH_STR_ENTRY(ABOUT_TURN_ON_DEV,         "turn on Dev updates")

/* Radio: what the connected node is, read-only. */
MESH_STR_ENTRY(RADIO_FIRMWARE,            "Firmware")
MESH_STR_ENTRY(RADIO_HARDWARE,            "Hardware")
MESH_STR_ENTRY(RADIO_NODE_NUMBER,         "Node number")
MESH_STR_ENTRY(RADIO_REBOOTS,             "Reboots")
MESH_STR_ENTRY(RADIO_CAPABILITIES,        "Capabilities")
MESH_STR_ENTRY(RADIO_CAN_SHUT_DOWN,       "Can shut down")
/* Whether this build can check the signatures the Security section's "Packet signing" row is
   about. A row rather than another word in the capabilities line, because a capabilities value
   of five concatenated words is wider than the column and this one answers a question the
   other screen asks. */
MESH_STR_ENTRY(RADIO_SIGNATURE_CHECKS,    "Signature checks")
/* The capability words, each with its trailing space, concatenated into one value. */
MESH_STR_ENTRY(RADIO_CAP_BLE,             "BLE ")
MESH_STR_ENTRY(RADIO_CAP_WIFI,            "WiFi ")
MESH_STR_ENTRY(RADIO_CAP_ETHERNET,        "Ethernet ")
MESH_STR_ENTRY(RADIO_CAP_PKC,             "PKC")
MESH_STR_ENTRY(RADIO_CAP_NONE,            "none")
/* The admin session: whether the radio is answering our AdminMessages. */
MESH_STR_ENTRY(RADIO_ADMIN_SESSION,       "Admin session")
MESH_STR_ENTRY(RADIO_ADMIN_OK,            "ok (%u replies)%s")
MESH_STR_ENTRY(RADIO_ADMIN_SAVING,        ", saving")
MESH_STR_ENTRY(RADIO_ADMIN_REFRESHING,    ", refreshing")
MESH_STR_ENTRY(RADIO_ADMIN_WAITING,       "waiting for reply")
MESH_STR_ENTRY(RADIO_ADMIN_NO_REPLY,      "no reply yet")
/*
 * Remote administration: which radio this whole tab is describing, and the way back.
 *
 * The heading says how, the row says who, and the third says where back to. "my radio" in the
 * last is the one on the end of the link - the one in the reader's hand - and the row is only
 * ever drawn while it is not the one being configured, so the contrast with the node named two
 * rows up is the whole of what makes it readable. Nothing here names that node: it is the value
 * on the middle row, and it is a name off the mesh rather than a word.
 */
MESH_STR_ENTRY(RADIO_ADMIN_REMOTE_HEAD,   "Over the mesh")
MESH_STR_ENTRY(RADIO_ADMIN_REMOTE_NODE,   "Configuring")
MESH_STR_ENTRY(RADIO_ADMIN_REMOTE_RETURN, "Back to my radio")

/* The channel list. A slot with role 0 is a free slot: A sets it up. */
MESH_STR_ENTRY(CHANNELS_NONE_KNOWN,       "none known yet")
MESH_STR_ENTRY(CHANNELS_SLOT,             "%u %s")
MESH_STR_ENTRY(CHANNELS_SLOT_EMPTY,       "%u (empty)")
MESH_STR_ENTRY(CHANNELS_SET_UP,           "disabled")
/* One slot in a line: what it is, and how it is keyed. Its MQTT bits used to be here too and
   did not fit - a settings value column is about two dozen cells - so they are read as the two
   toggles at the top of the slot's own section, where a bit that is a setting belongs. */
MESH_STR_ENTRY(CHANNELS_SUMMARY,          "%s, %s")
MESH_STR_ENTRY(CHANNELS_ROLE_PRIMARY,     "primary")
MESH_STR_ENTRY(CHANNELS_ROLE_SECONDARY,   "secondary")
MESH_STR_ENTRY(CHANNELS_KEY_NONE,         "no key")
MESH_STR_ENTRY(CHANNELS_KEY_DEFAULT,      "default key")
MESH_STR_ENTRY(CHANNELS_KEY_AES128,       "AES-128")
MESH_STR_ENTRY(CHANNELS_KEY_AES256,       "AES-256")
/* A key length the firmware should never produce, kept so the row cannot lie about it. */
MESH_STR_ENTRY(CHANNELS_KEY_ODD,          "odd key")

/*
 * Channel sharing: the Meshtastic link, which is how the phone apps hand a mesh to a group.
 *
 * Two rows at the foot of the channel list and the screen one of them opens. "Scan" is the
 * word to keep in the share screen's text: what the reader does is point a phone at the panel,
 * and the QR code is the only part of this that needs no explanation at all.
 */
/* The last row of one channel's own list. "Clear" rather than "Delete": the slot does not go
   away - the table is eight fixed slots - so what the press empties is what is in it. */
MESH_STR_ENTRY(CHANNELS_CLEAR_ROW,        "Clear this slot")
MESH_STR_ENTRY(CHANNELS_SHARE_ROW,        "Share these channels")
MESH_STR_ENTRY(CHANNELS_IMPORT_ROW,       "Add from a link")
MESH_STR_ENTRY(SHARE_TITLE,               "Share channels")
/* Under the code. Says what is in it and what to do with it, in that order. */
MESH_STR_PLURAL_ENTRY(SHARE_SUMMARY,      "%u channel. Scan it with the Meshtastic app to join.", "%u channels. Scan them with the Meshtastic app to join.")
/* The radio has not sent its channel table, or has sent one with no primary in it. */
MESH_STR_ENTRY(SHARE_NOTHING,             "Nothing to share yet: this radio has not sent its channels.")
/* A link too long for the largest code this client draws. Not reachable with eight slots and
   256-bit keys, and said rather than drawn as an empty square if it ever is. */
MESH_STR_ENTRY(SHARE_NO_CODE,             "Too long to show as a code. The link itself still works.")
/* The keyboard that collects one. */
MESH_STR_ENTRY(IMPORT_PROMPT,             "Channel link")
/* A channel whose name is the empty string, which upstream reads as "the preset's default
   channel" rather than as a channel with no name. Named here so a sheet asking whether to join
   one has something to put in its headline. */
MESH_STR_ENTRY(CHANNELS_DEFAULT_NAME,     "the default channel")

/*
 * Contact sharing: the other Meshtastic link, which is how the phone apps hand one *node* to
 * each other rather than a mesh.
 *
 * Two rows at the foot of the user section and the screen one of them opens. "Scan" is the word
 * to keep, as it is for channels - but the thing being scanned is this radio's own identity, so
 * the sentence says what the reader gains rather than what they join.
 */
MESH_STR_ENTRY(USER_CONTACT_HEAD,         "Contact code")
MESH_STR_ENTRY(USER_SHARE_CONTACT_ROW,    "Show my contact code")
/* "Add from a link", the same words the channel list uses, and short enough for the label
   column: the heading above these two says which kind of link it is. */
MESH_STR_ENTRY(USER_ADD_CONTACT_ROW,      "Add from a link")
MESH_STR_ENTRY(CONTACT_TITLE,             "My contact code")
/* Under the code: whose it is, then what to do with it. The name and number are there so
   somebody showing the code can see at a glance that it is their own radio's. */
MESH_STR_ENTRY(CONTACT_SUMMARY,           "%s (%s). Scan it with the Meshtastic app to add this radio.")
/* The owner reply has not landed, or landed with no public key - a radio with PKC turned off. */
MESH_STR_ENTRY(CONTACT_NOTHING,           "Nothing to show yet: this radio has not sent its name and key.")
/* A contact link too long for the largest code this client draws. Not reachable with a 256-bit
   key and a 40-character name, and said rather than drawn as an empty square if it ever is. */
MESH_STR_ENTRY(CONTACT_NO_CODE,           "Too long to show as a code. The link itself still works.")
/* The keyboard that collects one. */
MESH_STR_ENTRY(CONTACT_IMPORT_PROMPT,     "Contact link")
/* A contact whose link carries no name at all, so the sheet asking whether to add it has
   something to put in its headline. Its node number is shown beside this. */
MESH_STR_ENTRY(CONTACT_NO_NAME,           "an unnamed node")

/* Section headings inside a module's own screen. */
/* Position: the ten bits of position_flags, which are a set rather than ten settings - so the
   heading names what the set is about and the rows under it are checkboxes. */
MESH_STR_ENTRY(HEAD_POSITION_CARRIES,     "Sent with a position")
MESH_STR_ENTRY(HEAD_MAP_REPORT,           "Map report")
MESH_STR_ENTRY(HEAD_SERVER,               "Server")
/* Store & Forward, the half of the module that is about *this* client rather than about
   running one: a router on the mesh has been keeping the traffic that arrived while this
   handheld was switched off, and these rows are how it is asked for. */
MESH_STR_ENTRY(HEAD_MISSED,               "Missed messages")
/* And the other half of the same section: the rows that configure the module itself. */
MESH_STR_ENTRY(HEAD_MODULE,               "Module")
MESH_STR_ENTRY(HEAD_DEVICE,               "Device")
MESH_STR_ENTRY(HEAD_ENVIRONMENT,          "Environment")
MESH_STR_ENTRY(HEAD_AIR_QUALITY,          "Air quality")
MESH_STR_ENTRY(HEAD_POWER,                "Power")
MESH_STR_ENTRY(HEAD_HEALTH,               "Health")
MESH_STR_ENTRY(HEAD_TRANSMITTER,          "Transmitter")
MESH_STR_ENTRY(HEAD_LOG_ESP32,            "Log (ESP32 only)")
MESH_STR_ENTRY(HEAD_COUNT_ABOVE,          "Count above")
MESH_STR_ENTRY(HEAD_COLOUR,               "Colour")
MESH_STR_ENTRY(HEAD_WIRING,               "Wiring")
MESH_STR_ENTRY(HEAD_OUTPUT,               "Output")
MESH_STR_ENTRY(HEAD_VIBRA,                "Vibra")
MESH_STR_ENTRY(HEAD_BUZZER,               "Buzzer")
MESH_STR_ENTRY(HEAD_RATE_LIMIT,           "Rate limit")
MESH_STR_ENTRY(HEAD_NODES_RADIO,          "Nodes on the radio")
MESH_STR_ENTRY(HEAD_NODES_CACHED,         "Nodes cached here")
MESH_STR_ENTRY(HEAD_FACTORY_RESET,        "Factory reset")
MESH_STR_ENTRY(HEAD_BACKUP,               "Configuration backup")
MESH_STR_ENTRY(HEAD_RINGTONE,             "Ringtone")
/* Mesh beacon. The target heading is numbered, because four groups of identical rows are only
   tellable apart by the title above them. */
MESH_STR_ENTRY(HEAD_BEACON_BROADCAST,     "Broadcast")
MESH_STR_ENTRY(HEAD_BEACON_OFFER,         "Channel offered")
MESH_STR_ENTRY(HEAD_BEACON_TARGET,        "Target %u")
MESH_STR_ENTRY(HEAD_LOCKS,                "Set on the radio")
MESH_STR_ENTRY(HEAD_CONN_WIFI,            "WiFi")
MESH_STR_ENTRY(HEAD_CONN_ETHERNET,        "Ethernet")
MESH_STR_ENTRY(HEAD_CONN_BLUETOOTH,       "Bluetooth")
MESH_STR_ENTRY(HEAD_CONN_SERIAL,          "Serial")
/* Two notes that are rows rather than headings, because they explain the rows around them. */
MESH_STR_ENTRY(NOTE_TEST_PACKETS,         "Test packets")
MESH_STR_ENTRY(NOTE_TEST_PACKETS_VALUE,   "go to everyone on the channel")
MESH_STR_ENTRY(NOTE_EACH_LIMIT,           "Each limit")
MESH_STR_ENTRY(NOTE_EACH_LIMIT_VALUE,     "is off when it is 0")
/* Rows the Position screen adds outside the field table. */
MESH_STR_ENTRY(SETTINGS_FIXED_POSITION,   "Fixed position")
MESH_STR_ENTRY(SETTINGS_SET_FIXED_POS,    "Set fixed position")
MESH_STR_ENTRY(SETTINGS_CLEAR_FIXED_POS,  "Clear fixed position")
MESH_STR_ENTRY(SETTINGS_SET_HAM_MODE,     "Switch to ham mode")
MESH_STR_ENTRY(SETTINGS_CHANNELS_ROW,     "Channels")
MESH_STR_ENTRY(SETTINGS_ROLE_ROW,         "Role")
MESH_STR_ENTRY(SETTINGS_PUBLIC_KEY_ROW,   "Public key")
/* Rows the Radio UI and Canned messages screens add outside the field table. */
MESH_STR_ENTRY(SETTINGS_UI_SCREEN_LOCK,   "Screen lock")
MESH_STR_ENTRY(SETTINGS_UI_SETTINGS_LOCK, "Settings lock")
MESH_STR_ENTRY(SETTINGS_UI_LANGUAGE,      "Language")
MESH_STR_ENTRY(SETTINGS_CANNED_KEPT,      "Also on radio")
MESH_STR_ENTRY(SETTINGS_CANNED_KEPT_N,    "%u more, kept")
MESH_STR_ENTRY(SETTINGS_RINGTONE_ROW,     "RTTTL")
/* The Network section: what the radio was told to do about WiFi and Ethernet, as against what
   the CONN_ rows below say it is doing. The key is not among them and has no row. */
MESH_STR_ENTRY(NETWORK_WIFI,              "WiFi")
/* The SSID. "Network name" rather than the About screen's "Network", because on a section
   already called Network a row called Network says nothing. */
MESH_STR_ENTRY(NETWORK_SSID,              "Network name")
MESH_STR_ENTRY(NETWORK_ETHERNET,          "Ethernet")
MESH_STR_ENTRY(NETWORK_IPV6,              "IPv6")
MESH_STR_ENTRY(NETWORK_ADDRESS,           "Address")
MESH_STR_ENTRY(NETWORK_GATEWAY,           "Gateway")
MESH_STR_ENTRY(NETWORK_SUBNET,            "Subnet mask")
MESH_STR_ENTRY(NETWORK_DNS,               "DNS")
MESH_STR_ENTRY(NETWORK_NTP,               "NTP server")
MESH_STR_ENTRY(NETWORK_SYSLOG,            "Syslog server")
MESH_STR_ENTRY(NETWORK_UDP_BROADCAST,     "UDP broadcast")
/* The heading over the four static rows, which are only drawn when the mode is Static - under
