MESH_STR_ENTRY(ACTION_REMOVE_BACKUP,      "Delete the backup")
MESH_STR_ENTRY(ACTION_FORGET_OFF_RADIO,   "Forget off-radio")
MESH_STR_ENTRY(ACTION_FORGET_ALL,         "Forget all cached")
/* Under the "Factory reset" heading, so the rows name only what it does not: the
   confirm sheet still spells both out in full. */
MESH_STR_ENTRY(ACTION_FACTORY_CONFIG,     "Config")
MESH_STR_ENTRY(ACTION_FACTORY_DEVICE,     "Everything")
/* The value column of a forget row is the count the press would drop, so a row with nothing
   to drop is a fact rather than a press that does nothing. */
MESH_STR_ENTRY(ACTION_NOTHING_TO_DROP,    "nothing to drop")

/* ---- Store & Forward ------------------------------------------------------------------ */

/* The row that asks a router for the traffic missed while this client was off, and the
   row above it naming the router that would answer. */
MESH_STR_ENTRY(SF_ROUTER,                 "Router")
MESH_STR_ENTRY(SF_ROUTER_NONE,            "none heard yet")
/* A router that says it is not this mesh's primary one. It is still a router, and on a mesh
   whose primary is off it is the only one - so the row names it and adds the caveat. */
MESH_STR_ENTRY(SF_ROUTER_SECONDARY,       "%s (secondary)")
MESH_STR_ENTRY(SF_REQUEST,                "Get missed messages")
MESH_STR_ENTRY(SF_LAST_REQUEST,           "Last request")
/* What the router says it is holding, when it has volunteered its own statistics. */
MESH_STR_ENTRY(SF_ROUTER_HOLDS,           "Router holds")
MESH_STR_ENTRY(SF_HOLDS_COUNT,            "%u of %u")

/* Where a request has got to, as the value column of the two rows above. */
MESH_STR_ENTRY(SF_SEEKING,                "looking for a router")
MESH_STR_ENTRY(SF_WAITING,                "waiting for the router")
/* A replay in progress: how many of the messages the router announced have landed. */
MESH_STR_ENTRY(SF_REPLAYING,              "%u of %u")
/* The same while the router has not said how many are coming. */
MESH_STR_ENTRY(SF_REPLAYING_UNKNOWN,      "%u so far")
/*
   A finished replay, counted twice on purpose. A router replays its whole window, most of
   which a client that was only briefly off already heard live - so the first number is what
   was added to the conversations and the second is what the router sent. No noun, so no
   plural in English; a language that needs one has both counts to agree with. */
MESH_STR_ENTRY(SF_ADDED,                  "%u new of %u")
MESH_STR_ENTRY(SF_NOTHING_NEW,            "%u replayed, none new")
/* The router answered and its window held nothing for us. Not a failure. */
MESH_STR_ENTRY(SF_NOTHING_MISSED,         "nothing missed")
MESH_STR_ENTRY(SF_BUSY,                   "router busy, try again")
MESH_STR_ENTRY(SF_NO_ROUTER,              "no router answered")
MESH_STR_ENTRY(SF_NO_REPLY,               "the router did not reply")
MESH_STR_ENTRY(SF_FAILED,                 "the request failed")
MESH_STR_PLURAL_ENTRY(ACTION_FORGET_COUNT, "%u node", "%u nodes")

/* ---- settings: the confirmation sheet ------------------------------------------------------------ */

/* The question at the top of the sheet. */
MESH_STR_ENTRY(CONFIRM_TITLE_REBOOT,      "Reboot the radio?")
MESH_STR_ENTRY(CONFIRM_TITLE_SHUTDOWN,    "Shut the radio down?")
MESH_STR_ENTRY(CONFIRM_TITLE_RESET_DB,    "Reset the node database?")
MESH_STR_ENTRY(CONFIRM_TITLE_FORGET_OFF,  "Forget off-radio nodes?")
MESH_STR_ENTRY(CONFIRM_TITLE_FORGET_ALL,  "Forget every cached node?")
MESH_STR_ENTRY(CONFIRM_TITLE_FACTORY_CFG, "Factory reset the config?")
MESH_STR_ENTRY(CONFIRM_TITLE_FACTORY_DEV, "Factory reset everything?")
MESH_STR_ENTRY(CONFIRM_TITLE_BACKUP,      "Back up the configuration?")
MESH_STR_ENTRY(CONFIRM_TITLE_RESTORE,     "Restore the configuration?")
MESH_STR_ENTRY(CONFIRM_TITLE_RM_BACKUP,   "Delete the backup?")
MESH_STR_ENTRY(CONFIRM_TITLE_HAM_MODE,    "Switch to ham mode?")
MESH_STR_ENTRY(CONFIRM_TITLE_FW_USB,      "Update the radio over USB?")
MESH_STR_ENTRY(CONFIRM_TITLE_FW_BLE,      "Update the radio over Bluetooth?")
MESH_STR_ENTRY(CONFIRM_TITLE_CLEAR_CHAN,  "Clear channel %u?")
MESH_STR_ENTRY(CONFIRM_TITLE_SAVE_CHANNEL,"Save channel %u?")
MESH_STR_ENTRY(CONFIRM_TITLE_SAVE,        "Save %s?")

/* The row that goes ahead. Every one names what it does rather than saying "OK", because the
   sheet is the last thing between a press and something that cannot be undone. */
MESH_STR_ENTRY(CONFIRM_ACCEPT_REBOOT,     "Reboot now")
MESH_STR_ENTRY(CONFIRM_ACCEPT_SHUTDOWN,   "Shut down now")
MESH_STR_ENTRY(CONFIRM_ACCEPT_RESET_DB,   "Reset the node database")
MESH_STR_ENTRY(CONFIRM_ACCEPT_CLEAR_CHAN, "Clear the slot")
MESH_STR_ENTRY(CONFIRM_ACCEPT_FORGET_OFF, "Forget them")
MESH_STR_ENTRY(CONFIRM_ACCEPT_FORGET_ALL, "Forget them all")
MESH_STR_ENTRY(CONFIRM_ACCEPT_FACTORY_CFG,"Factory reset config")
MESH_STR_ENTRY(CONFIRM_ACCEPT_FACTORY_DEV,"Factory reset device")
MESH_STR_ENTRY(CONFIRM_ACCEPT_BACKUP,     "Back up")
MESH_STR_ENTRY(CONFIRM_ACCEPT_RESTORE,    "Restore")
MESH_STR_ENTRY(CONFIRM_ACCEPT_RM_BACKUP,  "Delete backup")
MESH_STR_ENTRY(CONFIRM_ACCEPT_HAM_MODE,   "Switch to ham mode")
MESH_STR_ENTRY(CONFIRM_ACCEPT_FW_USB,     "Update over USB")
MESH_STR_ENTRY(CONFIRM_ACCEPT_FW_BLE,     "Update over Bluetooth")
MESH_STR_ENTRY(CONFIRM_ACCEPT_SAVE,       "Save to radio")
MESH_STR_ENTRY(CONFIRM_ACCEPT_IMPORT,     "Join")
/* "Add", not "Import": what the press does is put one node in a list. */
MESH_STR_ENTRY(CONFIRM_ACCEPT_ADD_CONTACT, "Add")

/*
 * The paragraph under it. Four wrapped lines is what the sheet draws, so each of these has to
 * stop inside that - a warning whose last clause is cut off is worse than a shorter one, and a
 * translation that runs longer than the English will be the one that gets cut. Say what is
 * lost, and say what is spared: "favorites excepted" is the difference between a press the
 * user regrets and one they do not.
 */
/*
 * Added to whichever sheet is up while the Settings tab is configuring another node's radio.
 *
 * A sentence of its own rather than a second spelling of every sheet above, because the
 * question does not change - "reboot the radio" is still what is being asked - and the answer
 * to "which radio" is a name off the mesh rather than a word. The leading space is deliberate:
 * it is joined to the end of the sheet's own body.
 *
 * The last clause is not decoration. Three of those bodies say the link drops, which is true of
 * every radio action taken against the radio in your hand and of none taken over the mesh - so
 * without it this sentence would leave two halves of one paragraph contradicting each other.
 */
MESH_STR_ENTRY(CONFIRM_TEXT_REMOTE,       " This goes to %.20s over the mesh, not to the radio in your hand - your own link stays up.")
MESH_STR_ENTRY(CONFIRM_TEXT_REBOOT,       "The radio restarts in a few seconds. The link drops with it and auto-connect brings it back; anything sent to this node meanwhile is lost.")
MESH_STR_ENTRY(CONFIRM_TEXT_SHUTDOWN,     "The radio powers off in a few seconds and nothing here can wake it again: that takes its own button. Everything it has stored survives.")
MESH_STR_ENTRY(CONFIRM_TEXT_RESET_DB,     "The radio forgets every node it heard, favorites excepted. Names come back as each speaks again. The Brick's own list stays; the row below clears it.")
MESH_STR_ENTRY(CONFIRM_TEXT_CLEAR_CHAN,   "The name, key and MQTT settings are erased and the role goes to Disabled. A key with no copy elsewhere is gone for good.")
MESH_STR_ENTRY(CONFIRM_TEXT_FORGET_OFF,   "Drops the nodes this Brick remembers and the radio no longer carries - the ones the Nodes tab marks \"off radio\". Pins and ourselves stay.")
MESH_STR_ENTRY(CONFIRM_TEXT_FORGET_ALL,   "Empties this Brick's node list, ourselves and pins excepted. The radio's database is untouched; the list fills again on the next connect.")
MESH_STR_ENTRY(CONFIRM_TEXT_FACTORY_CFG,  "Every setting returns to its factory default, the Bluetooth bond excepted. Channels and keys go too: the node leaves your mesh until set up again.")
MESH_STR_ENTRY(CONFIRM_TEXT_FACTORY_DEV,  "Every setting and the node database return to factory defaults, and the Bluetooth bond is cleared: forget the node in Devices (Y) and pair again.")
MESH_STR_ENTRY(CONFIRM_TEXT_BACKUP,       "The radio copies every setting it holds to its own flash, replacing whatever backup was there before. Nothing on the mesh changes.")
MESH_STR_ENTRY(CONFIRM_TEXT_RESTORE,      "Every setting on the radio goes back to whatever the backup holds, this client's own settings excepted. The radio restarts; without a backup nothing happens.")
MESH_STR_ENTRY(CONFIRM_TEXT_RM_BACKUP,    "The saved copy is erased from the radio's flash. The settings it is running now are untouched, and there is nothing left to restore from.")
MESH_STR_ENTRY(CONFIRM_TEXT_BLUETOOTH,    "The radio will reboot. Changing the pairing mode or PIN invalidates the Brick's bond: forget the node in Devices (Y) and connect again to pair with the new PIN. Turning Bluetooth off cuts this client off entirely.")
MESH_STR_ENTRY(CONFIRM_TEXT_CHANNELS,     "The radio will reboot. A new key or name moves this radio to a different channel: every other node needs the same settings to keep talking to it.")
MESH_STR_ENTRY(CONFIRM_TEXT_LORA,         "The radio will reboot. A region or preset the other nodes do not share takes this radio off the mesh, and a wrong region may be illegal to transmit on. Transmit off makes it receive-only.")
MESH_STR_ENTRY(CONFIRM_TEXT_SECURITY,     "A new private key changes this node's identity: peers must learn it again and old direct messages stay unreadable. Managed mode locks out every client whose key is not an admin key, this one included.")
MESH_STR_ENTRY(CONFIRM_TEXT_POWER,        "The radio will reboot. Power saving puts the radio to sleep between packets, and a short light-sleep or wake time can leave too little Bluetooth on for this client to reconnect on its own.")
MESH_STR_ENTRY(CONFIRM_TEXT_HAM_MODE,     "Renames this node to your call sign, moves it to the frequency above and turns the primary channel's encryption off. Licensed operators only.")
/*
 * The two firmware sheets, and they are two sheets rather than one with a noun swapped,
 * because what is actually true differs. Over USB the worst case is a board sitting in its
 * bootloader waiting to be written again, which any computer can do; over Bluetooth the radio
 * reboots into a loader it cannot leave until an image finishes arriving. That second sentence
 * is the whole reason the sheet is not optional.
 */
MESH_STR_ENTRY(CONFIRM_TEXT_FW_USB,       "The image downloads, then the radio restarts into its bootloader and the blocks are written over the cable. Keep it plugged in: an interrupted write leaves the bootloader running and is retried by writing again.")
MESH_STR_ENTRY(CONFIRM_TEXT_FW_BLE,       "The image downloads, then the radio leaves the mesh and reboots into its update loader. There is no way back out of that loader except finishing, which takes about four minutes. Keep the Brick near the radio until it does.")
MESH_STR_ENTRY(CONFIRM_TEXT_DEFAULT,      "The radio will reboot to apply this.")
/*
 * Joining a link. The headline names the mesh being joined, because that is the fact the user
 * is agreeing to and a channel's name is the only part of a link a person can read.
 */
MESH_STR_ENTRY(CONFIRM_TITLE_IMPORT,      "Join %s?")
MESH_STR_PLURAL_ENTRY(CONFIRM_TEXT_IMPORT, "The link carries %u channel and this radio's LoRa settings. It replaces every channel on this radio and the radio will reboot; nodes on the old channels can no longer reach it.", "The link carries %u channels and this radio's LoRa settings. They replace every channel on this radio and the radio will reboot; nodes on the old channels can no longer reach it.")
/* The sheet in front of a typed contact link. The headline names the node, because the name is
   the part of a link a person can read and the part they were told to look for; the paragraph
   says the one thing adding a contact does *not* do, which is vouch for it. */
MESH_STR_ENTRY(CONFIRM_TITLE_ADD_CONTACT, "Add %s?")
MESH_STR_ENTRY(CONFIRM_TEXT_ADD_CONTACT,  "Node %s goes into this radio's contacts with its public key, so messages to it can be encrypted before it has ever been heard. The key is not marked as verified: that still takes the spoken ceremony.")

/* ---- transport status ------------------------------------------------------------------------- */

/*
 * What the header and the Status screen say the link is doing. These are one word each because
 * they share the top line with the connected node's name.
 *
 * "BlueZ" is the Linux Bluetooth stack's own name and stays as it is; so does "adapter", which
 * is what BlueZ calls the radio in the Brick.
 */
MESH_STR_ENTRY(TRANSPORT_UNKNOWN,         "unknown")
MESH_STR_ENTRY(TRANSPORT_DISABLED,        "disabled")
MESH_STR_ENTRY(TRANSPORT_INACTIVE,        "inactive")
MESH_STR_ENTRY(TRANSPORT_STOPPED,         "stopped")
MESH_STR_ENTRY(TRANSPORT_UNAVAILABLE,     "unavailable")
MESH_STR_ENTRY(TRANSPORT_RUNNING,         "running")
MESH_STR_ENTRY(TRANSPORT_CONNECTING,      "connecting")
MESH_STR_ENTRY(TRANSPORT_CONNECTED,       "connected")
MESH_STR_ENTRY(TRANSPORT_PAIRING,         "pairing")
MESH_STR_ENTRY(TRANSPORT_WAITING_BLUEZ,   "waiting-for-bluez")
MESH_STR_ENTRY(TRANSPORT_WAITING_ADAPTER, "waiting-for-adapter")
MESH_STR_ENTRY(TRANSPORT_NO_PORTS,        "no-ports")
/* The TCP link's equivalent of "no-ports". A network cannot be scanned for radios the way a USB
   bus or a Bluetooth adapter can, so this link has nothing to look for until somebody writes an
   address down: it is idle because it was never told where to go, not because nothing answered. */
MESH_STR_ENTRY(TRANSPORT_NO_HOST,         "no-host")

/* ---- delivery ---------------------------------------------------------------------------------- */

/*
 * Why a message did not arrive, from the Routing_Error the mesh sent back. Without these a
 * failed message is only "!!" on a bubble, which says nothing about whether to try again, move
 * the node, or fix a key - and those are three different problems.
 */
MESH_STR_ENTRY(ACK_DELIVERED,             "delivered")
MESH_STR_ENTRY(ACK_NO_ROUTE,              "no route to that node")
MESH_STR_ENTRY(ACK_GOT_NAK,               "rejected by the mesh")
MESH_STR_ENTRY(ACK_TIMEOUT,               "timed out")
MESH_STR_ENTRY(ACK_NO_INTERFACE,          "no radio interface")
/* The common one: the packet went out and nothing acknowledged it. Out of range, on another
   LoRa config, or switched off. */
MESH_STR_ENTRY(ACK_MAX_RETRANSMIT,        "no ack after retries")
MESH_STR_ENTRY(ACK_NO_CHANNEL,            "no matching channel")
MESH_STR_ENTRY(ACK_TOO_LARGE,             "message too large")
MESH_STR_ENTRY(ACK_NO_RESPONSE,           "no response")
MESH_STR_ENTRY(ACK_DUTY_CYCLE,            "duty cycle limit")
MESH_STR_ENTRY(ACK_BAD_REQUEST,           "bad request")
MESH_STR_ENTRY(ACK_NOT_AUTHORIZED,        "not authorized")
MESH_STR_ENTRY(ACK_PKI_FAILED,            "encryption failed")
MESH_STR_ENTRY(ACK_PKI_UNKNOWN_PUBKEY,    "no public key for that node")
MESH_STR_ENTRY(ACK_ADMIN_BAD_SESSION,     "admin session expired")
MESH_STR_ENTRY(ACK_ADMIN_UNAUTHORIZED,    "admin key not authorized")
MESH_STR_ENTRY(ACK_RATE_LIMIT,            "rate limited")
MESH_STR_ENTRY(ACK_PKI_SEND_FAIL,         "public key send failed")
MESH_STR_ENTRY(ACK_UNKNOWN_ERROR,         "unknown error")

/* ---- the link ------------------------------------------------------------------------------------ */

/*
 * What a transport says when a connect, a pairing or a link goes wrong.
 *
 * These reach the user as a toast, through take_error() - the transports' one user-facing
 * surface - so they are the same kind of string as the ones below and are held to the same
 * width. "%s" is usually a node, named by the last four hex digits of its address, which is
 * what the Meshtastic apps show and what is printed on the case: "6D:DA" beats a full MAC in a
 * line this short.
 *
 * "A" and "Devices" are the Brick's button and this client's own tab; keep them recognisable.
 */
MESH_STR_ENTRY(LINK_BT_STOPPED,           "Bluetooth stopped")
MESH_STR_ENTRY(LINK_BT_UNAVAILABLE,       "Bluetooth is unavailable")
MESH_STR_ENTRY(LINK_BT_NOT_READY,         "Bluetooth is not ready yet")
MESH_STR_ENTRY(LINK_NOT_IN_RANGE,         "%s is not in range")
MESH_STR_ENTRY(LINK_NEEDS_PAIRING,        "%s needs pairing; press A on it in Devices")
/* A node, then whichever of the failure words below fits - or the C library's own description
   of an errno, which arrives untranslated. */
MESH_STR_ENTRY(LINK_DETAIL,               "%s: %s")
MESH_STR_ENTRY(LINK_NO_ANSWER,            "%s did not answer; is it in range?")
MESH_STR_ENTRY(LINK_DISCOVERY_FAILED,     "%s: service discovery failed")
MESH_STR_ENTRY(LINK_NO_GATT,              "%s: no GATT services; try re-pairing")
MESH_STR_ENTRY(LINK_NOT_MESHTASTIC,       "%s is not a Meshtastic node")
MESH_STR_ENTRY(LINK_DROPPED,              "%s dropped the link; press A on it in Devices to pair")
MESH_STR_ENTRY(LINK_SUBSCRIBE_FAILED,     "%s: could not subscribe (%d)")
MESH_STR_ENTRY(LINK_PAIRING_START_FAILED, "%s: could not start pairing (%d)")
MESH_STR_ENTRY(LINK_PAIRING_TIMEOUT,      "%s: pairing timed out")
MESH_STR_ENTRY(LINK_FORGET_FAILED,        "%s: could not be forgotten (%d)")
/* The errnos inkwell's BLE central maps a stack's errors onto, in words. Each of these is the second
   half of LINK_DETAIL, so it reads as "6D:DA: is not in range". */
MESH_STR_ENTRY(LINK_FAIL_NEEDS_PAIRING,   "needs pairing (PIN mode)")
MESH_STR_ENTRY(LINK_FAIL_NO_ANSWER,       "did not answer; is it in range?")
MESH_STR_ENTRY(LINK_FAIL_BUSY,            "already connecting")
MESH_STR_ENTRY(LINK_FAIL_NOT_IN_RANGE,    "is not in range")
MESH_STR_ENTRY(LINK_FAIL_BT_NOT_READY,    "Bluetooth is not ready")
MESH_STR_ENTRY(LINK_FAIL_GENERIC,         "connect failed")
/* Pairing's own two, in the same place. "wrong PIN" is only said when the node rejected what
   was typed - a PIN nobody was there to type reads as LINK_NEEDS_PAIRING instead, so that this
   one never sends the user looking for a typo they did not make. */
MESH_STR_ENTRY(LINK_FAIL_WRONG_PIN,       "wrong PIN")
MESH_STR_ENTRY(LINK_FAIL_PAIRING,         "pairing failed")
/* USB. On the Brick a node has no serial driver until this client asks for one, so "no driver"
   is a state a working cable reaches and not necessarily a fault. */
MESH_STR_ENTRY(LINK_USB_DISABLED,         "USB serial is disabled")
MESH_STR_ENTRY(LINK_USB_GONE,             "USB port is gone; is it still plugged in?")
MESH_STR_ENTRY(LINK_USB_NO_DRIVER,        "%.20s: no USB serial driver (%d)")
MESH_STR_ENTRY(LINK_USB_OPEN_FAILED,      "Cannot open %.24s: %.20s")
MESH_STR_ENTRY(LINK_USB_NO_ANSWER,        "%.24s: the radio did not answer")
/* Said of a node sitting in its UF2 bootloader: the cable is fine and the device is there, but
   what is on the other end speaks no protobuf. Names the way out, because a single press of
   reset is the whole of it. */
MESH_STR_ENTRY(LINK_USB_BOOTLOADER,       "%.20s is in its bootloader; press reset to run it")
/*
 * Getting to a host, shared by every link that does it: the TCP transport and the MQTT proxy
 * today, and whatever reaches a network next.
 *
 * One entry per `enum inkwell_net_reason` that all of them mean the same thing by, which is
 * what src/i18n/net_reason.c turns a reason into. These were two sets until the reason had
 * somewhere to live - "no such host" was written out under LINK_TCP_ and again under
 * LINK_MQTT_, and translated twice in every language, because the only thing a transport could
 * hand back was a string id and an id belongs to one caller.
 *
 * "%s" here is an address and a port as the user wrote them, not a node name: nothing has been
 * heard from the far end yet at the point most of these are said. An IP address is not
 * translated, and neither is the C library's own word for an errno.
 */
/* A name that resolved to nothing: a typo, or a host that is not on this network. */
MESH_STR_ENTRY(LINK_UNKNOWN_HOST,         "%.24s: no such host")
/* And the other half - the lookup itself did not work, which says nothing about the name. One
   sentence for both of inkwell's lookup reasons: a resolver that failed and one that ran out of
   time are two things to inkwell and one thing to read, and collapsing them is this table's
   decision to make rather than the layer's. */
MESH_STR_ENTRY(LINK_LOOKUP_FAILED,        "%.24s: could not look up the name")
MESH_STR_ENTRY(LINK_UNREACHABLE,          "%.24s: %.20s")
MESH_STR_ENTRY(LINK_TIMEOUT,              "%.32s did not answer")
MESH_STR_ENTRY(LINK_CLOSED,               "%.32s closed the connection")
/* The second slot is the TLS library's own sentence for what went wrong with the certificate or
   the handshake. Untranslated, in the same category as the C library's word for an errno. */
MESH_STR_ENTRY(LINK_TLS,                  "%.24s: %.64s")

/* The rest of the network link's, which are its own: a policy, a target only it knows the shape
   of, and a radio that did not finish the handshake once the socket was up. */
MESH_STR_ENTRY(LINK_TCP_DISABLED,         "Network links are disabled")
MESH_STR_ENTRY(LINK_TCP_BAD_TARGET,       "%.32s is not an address and port")
MESH_STR_ENTRY(LINK_TCP_NO_ANSWER,        "%.24s: the radio did not answer")

/*
 * The MQTT client proxy: this client holding a broker connection on behalf of a radio that has
 * no route to the internet of its own. Every one of these names the *broker*, never the radio -
 * the radio is fine, and saying so is the difference between a user checking their WiFi and a
 * user power-cycling a node that was never at fault.
 *
 * The refusals are kept apart rather than collapsed into "the broker said no" because they are
 * three different things to do next: a wrong password is a setting, a client that is not
 * permitted is an account, and a broker that is unavailable is somebody else's outage.
 */
MESH_STR_ENTRY(LINK_MQTT_BAD_ADDRESS,     "%.32s is not a broker address")
MESH_STR_ENTRY(LINK_MQTT_PROTOCOL,        "%.32s is not speaking MQTT")
MESH_STR_ENTRY(LINK_MQTT_BAD_LOGIN,       "%.32s rejected the username or password")
MESH_STR_ENTRY(LINK_MQTT_NOT_ALLOWED,     "%.32s did not allow this client")
MESH_STR_ENTRY(LINK_MQTT_BROKER_BUSY,     "%.32s is not accepting connections")
MESH_STR_ENTRY(LINK_MQTT_REFUSED,         "%.24s refused the connection (%u)")
MESH_STR_ENTRY(LINK_MQTT_NO_TLS,          "%.32s needs TLS and this build has none")

/*
 * Where the broker connection has got to, one string per state of `enum inkwell_mqtt_client_state`.
 *
 * They are a set rather than a sentence with a variable in it because each is a different length
 * of wait and a different thing to do about it. "Signing in" in particular is worth its own
 * line: a connection that reaches it has found the broker and been let onto the socket, so
 * everything after that is about credentials rather than about the network.
 */
MESH_STR_ENTRY(MQTT_STATE_OFF,            "Off")
MESH_STR_ENTRY(MQTT_STATE_RESOLVING,      "Looking up the broker")
MESH_STR_ENTRY(MQTT_STATE_CONNECTING,     "Connecting")
MESH_STR_ENTRY(MQTT_STATE_SECURING,       "Securing the connection")
MESH_STR_ENTRY(MQTT_STATE_GREETING,       "Signing in")
MESH_STR_ENTRY(MQTT_STATE_READY,          "Connected")
MESH_STR_ENTRY(MQTT_STATE_WAITING,        "Reconnecting shortly")

/* ---- the banner --------------------------------------------------------------------------------- */

/*
 * The persistent notice under the tab strip: something is true of the whole client and stays
 * true until it is resolved.
 *
 * Two slots per banner, and they are separate strings on purpose. The first says *what is
 * true* and the second says *what to do about it*, so a translator is never asked to fit both
 * into one line - the component draws them on two, and the second is dropped before the first
 * when a panel is too narrow to hold them.
 *
 * Neither carries the version number. It is drawn against the trailing edge of the first line,
 * untranslated, in the same category as a region code or a hardware model name (docs/i18n.md).
 */
MESH_STR_ENTRY(BANNER_UPDATE_READY,       "Update installed")
MESH_STR_ENTRY(BANNER_UPDATE_READY_HINT,  "Restart the client to run it")
MESH_STR_ENTRY(BANNER_UPDATE_AVAILABLE,   "Update available")
/* "Settings" names the tab and should read exactly as it does on MESH_STR_TAB_SETTINGS -
   somebody is being sent there. The section within it is not named: About is the first row of
   that tab, and a hint carrying the whole path would be a breadcrumb spelled into a sentence. */
MESH_STR_ENTRY(BANNER_UPDATE_AVAILABLE_HINT, "Install it from the Settings tab")

/*
 * The previous run ended in a fault and left a report on the card.
 *
 * The headline says what happened rather than what was written, because "MeshClient crashed" is
 * the thing the reader already half knows and is waiting to have confirmed. The hint sends them
 * to the tab, exactly as the update hint does and for the same reason - the section is the first
 * row of it, and a path spelled into a sentence is a breadcrumb in the wrong place.
 */
MESH_STR_ENTRY(BANNER_CRASH_REPORT,       "MeshClient stopped unexpectedly")
MESH_STR_ENTRY(BANNER_CRASH_REPORT_HINT,  "A report is saved; see the Settings tab")

/*
 * The Settings tab is pointed at somebody else's radio, over the mesh.
 *
 * The headline is deliberately not "remote administration": what the reader needs to know is
 * that a save from here lands somewhere other than the radio in their hand, and the node's own
 * name - which the banner carries beside these words rather than inside them - is what says
 * where. The hint names the section that can undo it, the way the update hints name the tab.
 */
MESH_STR_ENTRY(BANNER_REMOTE_ADMIN,       "Configuring another radio")
MESH_STR_ENTRY(BANNER_REMOTE_ADMIN_HINT,  "Settings changes go to this node; About radio comes back")

/* ---- toasts ------------------------------------------------------------------------------------ */

/*
 * The line that appears over the footer for a few seconds after a press.
 *
 * A toast is about sixty bytes and one line, and names are bounded with a precision - "%.20s" -
 * so a long node name cannot push the verb off the end. Keep those precisions when translating:
 * they are what stops the sentence being the part that gets cut.
 *
 * Every "(%d)" is an errno the press came back with. It is there because a toast that only says
 * something failed cannot be turned into a bug report.
 */
MESH_STR_ENTRY(TOAST_NOT_CONNECTED,       "Not connected to a node")
MESH_STR_ENTRY(TOAST_NODE_GONE,           "That node is no longer in the list")
MESH_STR_ENTRY(TOAST_BLE_UNAVAILABLE,     "BLE transport unavailable")
MESH_STR_ENTRY(TOAST_BUSY_RETRY,          "Busy; try again in a moment")
MESH_STR_ENTRY(TOAST_CONNECTING,          "Connecting to %.40s")
MESH_STR_ENTRY(TOAST_CONNECT_FAILED,      "Connect failed (%d)")
MESH_STR_ENTRY(TOAST_SENT_TO,             "Sent to %s")
/* The retry of a message that came back undelivered went out. A separate sentence from the one
   above because what the user pressed was "try that again", and "Sent to" would read as though
   a second message had been written. */
MESH_STR_ENTRY(TOAST_RESENT_TO,           "Resent to %s")
/* A tapback went out. It names no destination because it does not choose one - it goes where
   the message it answers came from. */
MESH_STR_ENTRY(TOAST_REACTION_SENT,       "Reaction sent")
MESH_STR_ENTRY(TOAST_SEND_FAILED,         "Send failed (%d)")
/* A settings refresh, with the count of pending edits it is keeping. */
MESH_STR_PLURAL_ENTRY(TOAST_REFRESH_EDITS, "Refreshing %d sections; %u edit kept, Y saves", "Refreshing %d sections; %u edits kept, Y saves")
MESH_STR_ENTRY(TOAST_REFRESHING,          "Refreshing %d settings sections")
MESH_STR_ENTRY(TOAST_REFRESH_IN_PROGRESS, "Refresh already in progress")
MESH_STR_ENTRY(TOAST_REFRESH_FAILED,      "Refresh failed (%d)")
/* The radio actions, each saying what will happen next rather than that the press landed. */
MESH_STR_ENTRY(TOAST_REBOOTING,           "Rebooting; reconnecting shortly")
MESH_STR_ENTRY(TOAST_SHUTTING_DOWN,       "Shutting down; switch it on by hand")
MESH_STR_ENTRY(TOAST_NODEDB_RESET,        "Radio DB reset; Brick's list kept (forget it below)")
MESH_STR_ENTRY(TOAST_FACTORY_CONFIG,      "Factory reset sent; radio restarting")
MESH_STR_ENTRY(TOAST_FACTORY_DEVICE,      "Factory reset sent; forget it in Devices")
MESH_STR_ENTRY(TOAST_BACKED_UP,           "Backup sent to the radio's flash")
MESH_STR_ENTRY(TOAST_RESTORED,            "Restore sent; re-reading the settings")
MESH_STR_ENTRY(TOAST_BACKUP_REMOVED,      "Backup deleted from the radio's flash")
MESH_STR_ENTRY(TOAST_ALREADY_REQUESTED,   "Already requested")
MESH_STR_ENTRY(TOAST_REQUEST_FAILED,      "Request failed (%d)")
/* Asking a Store & Forward router for the traffic missed while this client was off. Two
   toasts because the press does two different things: with a router already known it asks
   it, and with none it has to find one first, which takes a moment longer. */
MESH_STR_ENTRY(TOAST_HISTORY_ASKED,       "Asked %.16s for the missed messages")
MESH_STR_ENTRY(TOAST_HISTORY_LOOKING,     "Looking for a Store & Forward router")
MESH_STR_ENTRY(TOAST_HISTORY_RUNNING,     "Already asking; the messages arrive as they come")
MESH_STR_ENTRY(TOAST_HISTORY_FAILED,      "Could not ask for the missed messages (%d)")
/* Dropping cached nodes. */
MESH_STR_PLURAL_ENTRY(TOAST_FORGOT_NODES, "Forgot %d node; pins kept", "Forgot %d nodes; pins kept")
/* Channel sharing. The refusal says which of the two things went wrong, because "that is not a
   link" and "there is no radio to put it on" are fixed in different places. */
MESH_STR_ENTRY(TOAST_IMPORT_NOT_A_LINK,   "Not a Meshtastic channel link")
MESH_STR_PLURAL_ENTRY(TOAST_IMPORT_QUEUED, "Joining: %u channel being written", "Joining: %u channels being written")
MESH_STR_ENTRY(TOAST_IMPORT_FAILED,       "Could not write the channels to the radio")
MESH_STR_ENTRY(TOAST_IMPORT_NO_CHANGE,    "This radio is already on those channels")
/*
 * The contact link's four answers. "%s" is the node's name, or a stand-in when the link carried
 * none.
 *
 * Their own ids rather than the TOAST_CONTACT_* block further down, which announces the same
 * admin write reached from a node's own row: the two are read on different screens with
 * different things around them, and this set has to account for a link as well as for a write.
 * "Sent" rather than "added" is kept from that block, and for its reason - the radio's database
 * may be full, and what settles it is the node's next NodeInfo rather than this request's ack.
 */
MESH_STR_ENTRY(TOAST_CONTACT_LINK_INVALID, "Not a Meshtastic contact link")
MESH_STR_ENTRY(TOAST_CONTACT_LINK_QUEUED, "Sent %s to the radio's contacts")
MESH_STR_ENTRY(TOAST_CONTACT_LINK_IS_SELF, "That code is this radio's own")
MESH_STR_ENTRY(TOAST_CONTACT_LINK_FAILED, "Could not send the contact to the radio")
MESH_STR_ENTRY(TOAST_NOTHING_CACHED,      "Nothing cached to forget")
MESH_STR_ENTRY(TOAST_ALL_ON_RADIO,        "Every cached node is on the radio")
MESH_STR_ENTRY(TOAST_FORGET_FAILED,       "Forget failed (%d)")
/* Pinning a node to the top of the list. */
/* Waypoints. "Shared" and "Deleted" say the mesh was told; "Saved" and "Forgot" say only this
   client was, which is what happens with no link up or on somebody else's locked place. */
MESH_STR_ENTRY(TOAST_WAYPOINT_SHARED,     "Shared %.30s")
MESH_STR_ENTRY(TOAST_WAYPOINT_SAVED,      "Saved %.30s here only")
MESH_STR_ENTRY(TOAST_WAYPOINT_DELETED,    "Deleted %.30s from the mesh")
MESH_STR_ENTRY(TOAST_WAYPOINT_FORGOT,     "Forgot %.30s here only")
MESH_STR_ENTRY(TOAST_WAYPOINT_NO_FIX,     "No position to put a waypoint at")
MESH_STR_ENTRY(TOAST_WAYPOINT_NAME_NEEDED, "Give the place a name first")
MESH_STR_ENTRY(TOAST_WAYPOINT_GONE,       "That place is no longer in the list")
MESH_STR_ENTRY(TOAST_WAYPOINT_FAILED,     "Waypoint failed (%d)")

MESH_STR_ENTRY(TOAST_PINNED,              "Pinned %.20s")
MESH_STR_ENTRY(TOAST_UNPINNED,            "Unpinned %.20s")
MESH_STR_ENTRY(TOAST_ALREADY_PINNED,      "%.20s is already pinned")
MESH_STR_ENTRY(TOAST_ALREADY_UNPINNED,    "%.20s is already unpinned")
MESH_STR_ENTRY(TOAST_PIN_FAILED,          "Pin failed (%d)")
/* Asking a node for something. */
MESH_STR_ENTRY(TOAST_ASKED_NAME,          "Asked %.20s to introduce itself")
MESH_STR_ENTRY(TOAST_ASKED_POSITION,      "Asked %.20s for its position")
MESH_STR_ENTRY(TOAST_ASKED_TELEMETRY,     "Asked %.20s for its telemetry")
MESH_STR_ENTRY(TOAST_STILL_SYNCING,       "Still syncing; try again in a moment")
MESH_STR_ENTRY(TOAST_CANNOT_ASK,          "Cannot ask this node")
/*
 * Pointing the Settings tab at another node's radio, and bringing it back.
 *
 * The first two say what the tab is now describing rather than that a request went out, because
 * that is what changed: the round trips behind it are the refresh, and the progress bar already
 * reports those. The third is the one gate this side can check - a node nobody holds a key for
 * cannot be sent an encrypted admin request at all - and it says what is missing rather than
 * that the press failed.
 */
MESH_STR_ENTRY(TOAST_ADMIN_REMOTE,        "Configuring %.20s by radio")
MESH_STR_ENTRY(TOAST_ADMIN_LOCAL,         "Configuring this radio again")
MESH_STR_ENTRY(TOAST_ADMIN_NO_KEY,        "No key held for %.20s")
MESH_STR_ENTRY(TOAST_ADMIN_FAILED,        "Cannot configure that node (%d)")
/* Ignoring a node: the radio drops its packets before we ever see them. */
MESH_STR_ENTRY(TOAST_IGNORING,            "Dropping packets from %.20s")
MESH_STR_ENTRY(TOAST_UNIGNORING,          "Hearing %.20s again")
MESH_STR_ENTRY(TOAST_ALREADY_IGNORED,     "%.20s is already ignored")
MESH_STR_ENTRY(TOAST_ALREADY_UNIGNORED,   "%.20s is already not ignored")
MESH_STR_ENTRY(TOAST_CANNOT_IGNORE,       "Cannot ignore this node")
MESH_STR_ENTRY(TOAST_IGNORE_FAILED,       "Ignore failed (%d)")
/* Muting: we still hear it, it just stops raising alerts. */
MESH_STR_ENTRY(TOAST_MUTE_REQUESTED,      "Mute already requested")
MESH_STR_ENTRY(TOAST_MUTED,               "Muted %.20s")
MESH_STR_ENTRY(TOAST_UNMUTED,             "Unmuted %.20s")
MESH_STR_ENTRY(TOAST_MUTE_FAILED,         "Mute failed (%d)")
/* Muting a *conversation*, which is this client's own doing and not the radio's - hence a
   different sentence from the two above, so a reader can tell which of the two they just did.
   The third is the press that cannot do its job: the radio is already muting that node, so
   there is nothing a local unmute could change, and the row says which one is in force. */
MESH_STR_ENTRY(TOAST_CONVO_MUTED,         "Muted %.20s; it will not interrupt")
MESH_STR_ENTRY(TOAST_CONVO_UNMUTED,       "Unmuted %.20s")
MESH_STR_ENTRY(TOAST_CONVO_MUTED_ON_RADIO, "%.20s is muted on the radio")
/* Removing a node from the radio's database. It comes back the moment it transmits again. */
MESH_STR_ENTRY(TOAST_REMOVED_NODE,        "Removed %.14s; back when it speaks")
MESH_STR_ENTRY(TOAST_REMOVE_SELF,         "That is the radio you are connected to")
MESH_STR_ENTRY(TOAST_REMOVE_FAILED,       "Remove failed (%d)")
/* Handing a node we remember back to the radio, key and all. "Sent" rather than "added":
   the radio's database is small and may be full, and what settles it is the node's next
   NodeInfo rather than the ack for this request. */
MESH_STR_ENTRY(TOAST_CONTACT_SENT,        "Sent %.14s to the radio")
MESH_STR_ENTRY(TOAST_CONTACT_NO_KEY,      "No key held for %.16s")
MESH_STR_ENTRY(TOAST_CONTACT_FAILED,      "Could not send it (%d)")
/* The key verification ceremony. The first is what happens after the press - the radios have
   to reach each other before anything is asked of anybody. */
MESH_STR_ENTRY(TOAST_VERIFY_STARTED,      "Asking %.16s to verify")
MESH_STR_ENTRY(TOAST_VERIFY_DONE,         "%.16s verified in person")
MESH_STR_ENTRY(TOAST_VERIFY_REFUSED,      "%.16s left unverified")
MESH_STR_ENTRY(TOAST_VERIFY_TIMEOUT,      "%.16s never answered")
MESH_STR_ENTRY(TOAST_VERIFY_NO_KEY,       "Nothing to verify: no key yet")
MESH_STR_ENTRY(TOAST_VERIFY_BUSY,         "Already verifying that node")
MESH_STR_ENTRY(TOAST_VERIFY_FAILED,       "Verification failed (%d)")
MESH_STR_PLURAL_ENTRY(TOAST_DELETED_MESSAGES, "Deleted %u message from %.16s", "Deleted %u messages from %.16s")
MESH_STR_ENTRY(TOAST_NOTHING_TO_DELETE,   "Nothing to delete in %.20s")
MESH_STR_ENTRY(TOAST_MESSAGE_DELETED,     "Message deleted")
MESH_STR_ENTRY(TOAST_MESSAGE_NOT_FOUND,   "That message has already gone")
MESH_STR_ENTRY(TOAST_TRACING,             "Tracing route to %.20s")
MESH_STR_ENTRY(TOAST_TRACE_RUNNING,       "A traceroute is already running")
MESH_STR_ENTRY(TOAST_CANNOT_TRACE,        "Cannot trace a route to this node")
MESH_STR_ENTRY(TOAST_TRACE_FAILED,        "Traceroute failed (%d)")
/* The link itself. */
MESH_STR_ENTRY(TOAST_DISCONNECTED_FROM,   "Disconnected from %.30s")
MESH_STR_ENTRY(TOAST_DISCONNECTED,        "Disconnected")
MESH_STR_ENTRY(TOAST_NOTHING_CONNECTED,   "Nothing is connected")
MESH_STR_ENTRY(TOAST_DISCONNECT_FAILED,   "Disconnect failed (%d)")
MESH_STR_ENTRY(TOAST_BLE_ONLY_PAIRING,    "Only Bluetooth nodes are paired")
/* The network address was cleared: nothing is configured and auto-connect stops reaching for
   it. Said of a host rather than of a bond, which is what the Devices tab's other forget is. */
MESH_STR_ENTRY(TOAST_FORGOT_NETWORK,      "Forgot the network address")
MESH_STR_ENTRY(TOAST_NO_NETWORK_HOST,     "No network address set")
MESH_STR_ENTRY(TOAST_FORGOT_DEVICE,       "Forgot %.30s; pair again to use it")
MESH_STR_ENTRY(TOAST_FORGET_DEVICE_FAILED,"Could not forget it (%d)")
MESH_STR_ENTRY(TOAST_PAIRING,             "Pairing...")
MESH_STR_ENTRY(TOAST_PAIRING_EXPIRED,     "The pairing request expired")
MESH_STR_ENTRY(TOAST_PAIRING_FAILED,      "Pairing failed (%d)")
MESH_STR_ENTRY(TOAST_PAIRING_CANCELLED,   "Pairing cancelled")
/* About. MESHCLIENT_THEME is an environment variable name and is not translated. */
MESH_STR_ENTRY(TOAST_UPDATE_CHANNEL,      "Update channel: %.*s")
MESH_STR_ENTRY(TOAST_THEME_HELD,          "MESHCLIENT_THEME is holding the theme")
MESH_STR_ENTRY(TOAST_THEME,               "Theme: %.*s")
MESH_STR_ENTRY(TOAST_DEV_UPDATES_ON,      "Dev updates on; check again")
MESH_STR_ENTRY(TOAST_DEV_UPDATES_OFF,     "Dev updates off")
/* The crash report has been deleted. The "(%d)" on the failure is an errno, for the reason
   every other errno in this section is there: a toast saying only that something did not work
   cannot be turned into a bug report. */
MESH_STR_ENTRY(TOAST_CRASH_DISCARDED,     "Crash report deleted")
MESH_STR_ENTRY(TOAST_CRASH_DISCARD_FAILED, "Could not delete the report (%d)")
MESH_STR_ENTRY(TOAST_CHECKING_UPDATES,    "Checking for updates")
MESH_STR_ENTRY(TOAST_UPDATES_UNAVAILABLE, "Updates are unavailable here")
MESH_STR_ENTRY(TOAST_ALREADY_CHECKING,    "Already checking")
MESH_STR_ENTRY(TOAST_UPDATE_CHECK_FAILED, "Update check failed (%d)")
MESH_STR_ENTRY(TOAST_DOWNLOADING,         "Downloading %.20s")
MESH_STR_ENTRY(TOAST_ALREADY_WORKING,     "Already working")
MESH_STR_ENTRY(TOAST_CHECK_FIRST,         "Check for an update first")
MESH_STR_ENTRY(TOAST_UPDATE_FAILED,       "Update failed (%d)")
/* Settings writes. "edits kept" matters: the user's typing survives the failure. */
MESH_STR_ENTRY(TOAST_COORDS_NOT_NUMBERS,  "Latitude, longitude and altitude must be numbers")
MESH_STR_ENTRY(TOAST_NEED_COORDS,         "Set a latitude and longitude first")
MESH_STR_ENTRY(TOAST_WORKING_ELLIPSIS,    "%s...")
MESH_STR_ENTRY(TOAST_CLEARING_FIXED_POS,  "Clearing fixed position")
MESH_STR_ENTRY(TOAST_PINNING_POSITION,    "Pinning position")
/* Ham mode, which is a press rather than a section save: nothing is read back, so the toast
   says what was asked for. %s is the call sign. */
MESH_STR_ENTRY(TOAST_HAM_BAD_FREQUENCY,   "Ham frequency must be a number in MHz")
MESH_STR_ENTRY(TOAST_HAM_NEED_CALL_SIGN,  "Enter your call sign first")
MESH_STR_ENTRY(TOAST_HAM_SWITCHING,       "Switching to ham mode as %s...")
MESH_STR_ENTRY(TOAST_NOT_CONNECTED_KEPT,  "Not connected to a node; edits kept")
MESH_STR_ENTRY(TOAST_NOT_ON_EARTH,        "That is not a place on Earth")
MESH_STR_ENTRY(TOAST_FAILED_KEPT,         "Failed (%d); edits kept")
MESH_STR_ENTRY(TOAST_SAVING_SECTION,      "Saving %s...")
MESH_STR_ENTRY(TOAST_SECTION_NOT_LOADED,  "%s not loaded yet; X to refresh")
MESH_STR_ENTRY(TOAST_SECTION_READ_ONLY,   "%s is read-only for now")
MESH_STR_ENTRY(TOAST_INVALID_VALUE,       "Invalid value (PIN is 6 digits, key is hex)")
MESH_STR_ENTRY(TOAST_TOO_LONG_KEPT,       "Too long for the radio's list; edits kept")
MESH_STR_ENTRY(TOAST_SAVE_FAILED_KEPT,    "Save failed (%d); edits kept")
MESH_STR_ENTRY(TOAST_SAVE_SESSION_EXPIRED,"%s rejected: session expired, try again")
MESH_STR_ENTRY(TOAST_SAVE_BAD_VALUE,      "%s rejected by the radio (bad value)")
MESH_STR_ENTRY(TOAST_SAVE_NO_REPLY,       "No reply saving %s; X to check")
MESH_STR_ENTRY(TOAST_SAVE_REJECTED,       "%s rejected (error %d)")
MESH_STR_ENTRY(TOAST_SAVED_MAY_RESTART,   "%s saved; radio may restart")
MESH_STR_ENTRY(TOAST_RESTARTING_APPLY,    "Radio restarting to apply; reconnecting")
/* The names the save toasts above put in their %s. */
MESH_STR_ENTRY(SAVE_SECTION_FIXED_POS,    "Fixed position")
MESH_STR_ENTRY(SAVE_SECTION_POSITION,     "Position")
MESH_STR_ENTRY(SAVE_SECTION_CHANNEL,      "Channel %u")
/* Things that happen without a press behind them. */
MESH_STR_ENTRY(TOAST_NOT_DELIVERED,       "Not delivered to %.16s: %s")
MESH_STR_ENTRY(TOAST_RADIO_RESTARTED,     "Radio restarted; reloading its settings")
MESH_STR_ENTRY(TOAST_LINK_LOST,           "Radio link lost; reconnecting")
/* An alert message, which the firmware raises for something worth interrupting for. The text
   of the alert follows the colon. */
MESH_STR_ENTRY(TOAST_ALERT_FROM,          "Alert from %.16s: ")
/* A direct message arriving while the reader is somewhere else. The message itself follows the
   colon, exactly as an alert's text does. Only the sender's name here: a broadcast raises
   nothing, so there is no channel to name. */
MESH_STR_ENTRY(TOAST_MESSAGE_FROM,        "%.16s: ")
MESH_STR_ENTRY(TOAST_NODES_OFF_RADIO,     "%u nodes now off radio; forget them in Settings")

/* ---- self-update -------------------------------------------------------------------------------- */

/* What the updater is doing, shown on the About screen when it has nothing more specific. */
MESH_STR_ENTRY(UPDATE_STATE_IDLE,         "idle")
MESH_STR_ENTRY(UPDATE_STATE_CHECKING,     "checking")
MESH_STR_ENTRY(UPDATE_STATE_UP_TO_DATE,   "up to date")
MESH_STR_ENTRY(UPDATE_STATE_AVAILABLE,    "available")
MESH_STR_ENTRY(UPDATE_STATE_DOWNLOADING,  "downloading")
MESH_STR_ENTRY(UPDATE_STATE_VERIFYING,    "verifying")
MESH_STR_ENTRY(UPDATE_STATE_READY,        "ready")
MESH_STR_ENTRY(UPDATE_STATE_FAILED,       "failed")
/* Which releases this build will offer. The automatic pair follows the running build: a
   prerelease build tracks prereleases, a release build tracks releases. */
MESH_STR_ENTRY(UPDATE_CHANNEL_STABLE,     "Stable")
MESH_STR_ENTRY(UPDATE_CHANNEL_PRERELEASE, "Prerelease")
MESH_STR_ENTRY(UPDATE_CHANNEL_AUTO_PRE,   "Automatic (prerelease)")
MESH_STR_ENTRY(UPDATE_CHANNEL_AUTO_STABLE,"Automatic (stable)")
/* Messages. "GitHub", "TLS", "HTTP" and "pak" are names and stay as they are. */
MESH_STR_ENTRY(UPDATE_NO_TLS,             "This build has no TLS")
MESH_STR_ENTRY(UPDATE_DEV_DISABLED,       "Dev build; updates disabled")
MESH_STR_ENTRY(UPDATE_DEV_ENABLED,        "Dev build; updates enabled")
MESH_STR_ENTRY(UPDATE_CHANNEL_CHANGED,    "Channel changed; check again")
MESH_STR_ENTRY(UPDATE_SETTING_CHANGED,    "Setting changed; check again")
MESH_STR_ENTRY(UPDATE_START_FAILED,       "Could not start the downloader")
MESH_STR_ENTRY(UPDATE_CHECKING,           "Checking for updates")
MESH_STR_ENTRY(UPDATE_EMPTY_REPLY,        "Empty reply from GitHub")
MESH_STR_ENTRY(UPDATE_NO_ASSET,           "No usable release asset")
MESH_STR_ENTRY(UPDATE_LATEST_DEV,         "Latest is %s; dev build, not installing")
MESH_STR_ENTRY(UPDATE_LATEST_RUNNING,     "Running the latest release")
MESH_STR_ENTRY(UPDATE_NO_CHECKSUM,        "Release has no checksum; not installing")
MESH_STR_ENTRY(UPDATE_BAD_SIZE,           "Release asset size looks wrong")
/* The newer version, and the one this build is. */
MESH_STR_ENTRY(UPDATE_AVAILABLE,          "%s available (running %s)")
MESH_STR_ENTRY(UPDATE_DOWNLOAD_START_FAIL,"Could not start the download")
MESH_STR_ENTRY(UPDATE_DOWNLOADING,        "Downloading %s")
MESH_STR_ENTRY(UPDATE_RESPONSE_TOO_LARGE, "Response too large")
MESH_STR_ENTRY(UPDATE_UNREACHABLE,        "Could not reach GitHub")
MESH_STR_ENTRY(UPDATE_BAD_REPLY,          "Unexpected reply from GitHub")
MESH_STR_ENTRY(UPDATE_WRITE_FAILED,       "Could not save the download")
MESH_STR_ENTRY(UPDATE_VERIFYING,          "Verifying download")
MESH_STR_ENTRY(UPDATE_FILE_MISSING,       "Downloaded file is missing")
MESH_STR_ENTRY(UPDATE_FILE_WRONG_SIZE,    "Downloaded file is the wrong size")
MESH_STR_ENTRY(UPDATE_HASH_FAILED,        "Could not hash the download")
MESH_STR_ENTRY(UPDATE_CHECKSUM_MISMATCH,  "Checksum mismatch; discarded")
MESH_STR_ENTRY(UPDATE_CHMOD_FAILED,       "Could not make the update executable")
/* The %s is the C library's own description of an errno and arrives untranslated. */
MESH_STR_ENTRY(UPDATE_INSTALL_FAILED,     "Install failed: %s")
MESH_STR_ENTRY(UPDATE_INSTALLED,          "%s installed - relaunch to run it")
MESH_STR_ENTRY(UPDATE_TIMED_OUT,          "Timed out talking to GitHub")
MESH_STR_ENTRY(UPDATE_TLS_UNVERIFIED,     "Could not verify GitHub's certificate")
/* The HTTP status GitHub answered with - 404, 503. */
MESH_STR_ENTRY(UPDATE_CHECK_HTTP,         "Check failed (HTTP %d)")
MESH_STR_ENTRY(UPDATE_DOWNLOAD_HTTP,      "Download failed (HTTP %d)")

/* ---- the radio's firmware ------------------------------------------------------------------ */

/*
 * The other binary in the room: the Meshtastic firmware on the node, not this client. Today the
 * client only reports.
 *
 * **Everything from here to the labels is a value-column value, so every one of them is short.**
 * That is a hard constraint rather than a preference: a settings row has no supporting line to
 * wrap a sentence onto, and the column is about two dozen cells at the device scale - so a
 * reason spelled as prose comes out as "connect it by USB to updat", which reads as a bug. The
 * long form of any of these belongs in a toast or the log, where a sentence has room.
 *
 * "Meshtastic" is a name and stays as it is. So do version strings, build targets and "HTTP",
 * which are identifiers rather than words.
 */
MESH_STR_ENTRY(FW_STATE_IDLE,             "not checked")
MESH_STR_ENTRY(FW_STATE_IDENTIFYING,      "identifying")
MESH_STR_ENTRY(FW_STATE_CHECKING,         "checking")
MESH_STR_ENTRY(FW_STATE_UP_TO_DATE,       "up to date")
MESH_STR_ENTRY(FW_STATE_AVAILABLE,        "update available")
MESH_STR_ENTRY(FW_STATE_FAILED,           "failed")
/* Why a check did not produce an answer. The two lists are worth telling apart: a hardware
   list that would not read leaves the version question answerable, and a firmware list that
   would not read leaves the board question answered. */
MESH_STR_ENTRY(FW_NO_RADIO,               "no radio")
MESH_STR_ENTRY(FW_HARDWARE_UNREADABLE,    "hardware list failed")
MESH_STR_ENTRY(FW_INDEX_UNREADABLE,       "firmware list failed")
MESH_STR_ENTRY(FW_TIMED_OUT,              "timed out")
/* The HTTP status the server answered with. "HTTP" is an identifier. */
MESH_STR_ENTRY(FW_CHECK_HTTP,             "HTTP %d")
MESH_STR_ENTRY(FW_TLS_UNVERIFIED,         "server not verified")
MESH_STR_ENTRY(FW_UNREACHABLE,            "unreachable")
/*
 * Why the client cannot install what it just found. Each is a row rather than a silence: a
 * radio behaving oddly is often a radio on old firmware, and the answer to "why can I not fix
 * that from here" is worth a line even when it is disappointing.
 */
MESH_STR_ENTRY(FW_BLOCK_UNKNOWN_BOARD,    "board not listed")
MESH_STR_ENTRY(FW_BLOCK_AMBIGUOUS,        "several boards match")
MESH_STR_ENTRY(FW_BLOCK_UNSUPPORTED,      "no longer built")
MESH_STR_ENTRY(FW_BLOCK_NO_PATH,          "not from this client")
/* The two halves of the same refusal: the board can be updated, over the other bus. */
MESH_STR_ENTRY(FW_BLOCK_CONNECT_USB,      "connect it by USB")
MESH_STR_ENTRY(FW_BLOCK_CONNECT_BLE,      "connect by Bluetooth")
/* The one refusal that is about the release rather than the board: an index entry can exist
   before its assets do, which is ordinary on the alpha channel for the first minutes of a
   publish. Nothing is wrong and there is still nothing to fetch. */
MESH_STR_ENTRY(FW_BLOCK_NO_ASSETS,        "no download yet")
/*
 * The labels, under Settings > About radio. Two of them name the same row: the question is
 * "what firmware is out there", and once the answer is a version worth having, the row is named
 * after the answer instead - which is what lets the value column carry the version rather than
 * a sentence about it. The same trick About plays with "Install %s".
 */
/* Which of upstream's two release lists the rows read. The channel's own name - "stable" or
   "alpha" - is upstream's word for its own list and arrives untranslated, like a region code. */
MESH_STR_ENTRY(FW_CHANNEL,                "Firmware channel")
MESH_STR_ENTRY(FW_LATEST,                 "Radio firmware")
MESH_STR_ENTRY(FW_NEWER,                  "Newer firmware")
MESH_STR_ENTRY(FW_CHECK,                  "Check for firmware")
MESH_STR_ENTRY(FW_INSTALLING,             "Installing")
/* The toast the check press raises, where a sentence has room. */
MESH_STR_ENTRY(TOAST_CHECKING_FIRMWARE,   "Checking for radio firmware...")
/* The %s is upstream's own name for the list and is not translated. */
MESH_STR_ENTRY(TOAST_FIRMWARE_CHANNEL,    "Firmware channel: %s")

/*
 * Installing it: where the job has got to, as the Installing row's value.
 *
 * **Bus-neutral on purpose.** There is one ladder for both buses (see
 * mesh/core/firmware_update.h): "arming" is an enter_dfu_mode_request over a cable and an
 * ota_request over the air, "waiting" is a bootloader enumerating and a loader advertising,
 * "writing" is blocks to a drive and chunks to a characteristic. A row is answering "where has
 * this got to", and to that question those really are one word each - naming the bus in them
 * would be the value column carrying a fact the screen above it already states.
 *
 * Short, because the value column is about two dozen cells and has no line to wrap onto.
 */
MESH_STR_ENTRY(FW_UPDATE_IDLE,            "not started")
MESH_STR_ENTRY(FW_UPDATE_RESOLVING,       "resolving")
MESH_STR_ENTRY(FW_UPDATE_DOWNLOADING,     "downloading")
/* The image is staged and the radio is being waited for. Only ever seen on the Bluetooth path,
   where the download had the antenna and the link went down for the length of it. */
MESH_STR_ENTRY(FW_UPDATE_READY,           "waiting for radio")
MESH_STR_ENTRY(FW_UPDATE_ARMING,          "arming")
MESH_STR_ENTRY(FW_UPDATE_WAITING,         "waiting")
MESH_STR_ENTRY(FW_UPDATE_WRITING,         "writing")
MESH_STR_ENTRY(FW_UPDATE_RESTARTING,      "restarting")
MESH_STR_ENTRY(FW_UPDATE_DONE,            "installed")
MESH_STR_ENTRY(FW_UPDATE_FAILED,          "failed")
/*
 * Why it stopped. Four of these mean the radio was never touched and is still running, which is
 * the distinction a reader acts on; the fifth deliberately does not promise that, because a
 * handover that broke may have left a board in a bootloader or a radio in a loader.
 */
MESH_STR_ENTRY(FW_UPDATE_ERR_UNAVAILABLE, "cannot install this")
MESH_STR_ENTRY(FW_UPDATE_ERR_DOWNLOAD,    "download failed")
MESH_STR_ENTRY(FW_UPDATE_ERR_WRONG_IMAGE, "wrong image")
MESH_STR_ENTRY(FW_UPDATE_ERR_NO_RADIO,    "no radio answered")
MESH_STR_ENTRY(FW_UPDATE_ERR_REFUSED,     "the radio refused")
MESH_STR_ENTRY(FW_UPDATE_ERR_HANDOVER,    "install failed")
/* Three details rather than states: they fill the line under the row, where the sub-module
   would otherwise have had nothing of its own to say. */
MESH_STR_ENTRY(FW_UPDATE_ERR_NO_ADAPTER,  "no Bluetooth adapter")
MESH_STR_ENTRY(FW_UPDATE_ERR_NO_IMAGE,    "image not staged")
MESH_STR_ENTRY(FW_UPDATE_ERR_CANCELLED,   "cancelled")
/* The row that offers the press, and the two toasts around it. The version is a version and
   arrives untranslated. */
MESH_STR_ENTRY(FW_INSTALL,                "Install firmware")
MESH_STR_ENTRY(TOAST_INSTALLING_FIRMWARE, "Installing %s on the radio...")
MESH_STR_ENTRY(TOAST_FIRMWARE_INSTALLED,  "The radio is running %s")
/*
 * The update worked and the radio has to be paired with again, which is a sentence about
 * the update rather than about Bluetooth: an ESP32 rotates its BLE keys when its firmware
 * changes, so the bond on this side is a key the radio no longer has. What to press is
 * left to LINK_NEEDS_PAIRING, which the next connect raises and which already says it.
 */
MESH_STR_ENTRY(TOAST_FIRMWARE_REPAIR,     "%s installed; the radio needs pairing again")
MESH_STR_ENTRY(TOAST_FIRMWARE_FAILED,     "Firmware install failed: %s")
/*
 * The banner, which exists for one state and one bus: the radio is in its ESP32 update loader,
 * off the mesh, and the only way out is an image finishing. A banner has to be resolvable and
 * this one is - by pressing Install again, which finds the loader and finishes the job.
 *
 * There is deliberately no USB equivalent. A board left in its UF2 bootloader is talking to any
 * computer in the world, so there is nothing the client has to promise to come back for.
 */
MESH_STR_ENTRY(BANNER_RADIO_IN_LOADER,    "The radio is in update mode")
MESH_STR_ENTRY(BANNER_RADIO_IN_LOADER_HINT, "It stays off the mesh until an update finishes. Settings > About radio > Install firmware")

/* ---- language ------------------------------------------------------------------------------------ */

/*
 * The Settings > About row naming the language in force.
 *
 * Only the label is here. The *name* of a language comes from `name` on struct
 * inkcell_i18n_locale, which every locale must fill in with its own name for itself - "Deutsch",
 * not "German". It is deliberately not a catalog entry: a catalog entry may be left
 * untranslated, and a locale whose name fell back to English would have About reporting the
 * wrong language.
 */
MESH_STR_ENTRY(ABOUT_LANGUAGE,            "Language")

