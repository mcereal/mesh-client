   blank row reads as "no time source" and the firmware does have one. */
MESH_STR_ENTRY(NETWORK_NTP_DEFAULT,       "firmware default")

/* The radio's own network interfaces, on About radio. */
MESH_STR_ENTRY(CONN_CONNECTED,            "Connected")
MESH_STR_ENTRY(CONN_NETWORK,              "Network")
MESH_STR_ENTRY(CONN_IP,                   "IP address")
MESH_STR_ENTRY(CONN_SIGNAL,               "Signal")
