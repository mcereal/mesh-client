            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "docker: shell",
            "type": "shell",
            "command": "make",
            "args": [
                "docker-shell"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "device: brick (build + deploy)",
            "type": "shell",
            "command": "make",
            "args": [
                "brick"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "device: deploy",
            "type": "shell",
            "command": "make",
            "args": [
                "deploy"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
